    // The modal exists to ask one question: 1x or 2x. Plenty of presets have
    // no second answer to offer — a platform preset that opts out of 2x, or an
    // on-model preset with no platform size to scale — and a modal asking
    // which of one option to take is a click in the way of the download. Those
    // save the file directly.
    //
    // When it does open, the sub-labels name the real output size for the
    // current preset rather than reading "1x / 2x": it describes one file the
    // user is about to save, and the exact size is the useful fact about it.
    // On-model measures its own, being a crop of a photo held to the preset's
    // platform size rather than a letterboxed artboard.
    downloadBtn.addEventListener('click', () => {
      const onModelEntry = mockupStyle === 'onmodel' ? onModelCache.get(activeOnModelId) : null;
      // Whether 2x is on offer at all. Where it is not, both export paths
      // already ignore the quality argument, so 'high' IS the single size —
      // this cannot silently downgrade a preset to a smaller file.
      const singleSize = onModelEntry
        ? !onModelHasQualityChoice()
        : !!CANVAS_ASPECTS[canvasAspect].oneX;
      if (singleSize) {
        runDownload('high');
        return;
      }
      if (downloadModal) {
        const dimsFor = q => {
          if (onModelEntry) {
            const d = onModelExportDims(onModelEntry, q === 2);
            return { frameW: d.w, frameH: d.h };
          }
          return getFrameDims(getExportScaleFactor(q));
        };
        const highDims = dimsFor(1);
        const extraDims = dimsFor(2);
        const highSub = optionHighCard.querySelector('.option-sub');
        const extraSub = optionExtraHighCard.querySelector('.option-sub');
        if (highSub) highSub.textContent = `lower file size - ${Math.round(highDims.frameW)}x${Math.round(highDims.frameH)}px`;
        if (extraSub) extraSub.textContent = `higher file size - ${Math.round(extraDims.frameW)}x${Math.round(extraDims.frameH)}px`;
        // No card to hide any more: the one-option case never reaches here, so
        // both are always real choices by the time the modal is on screen.
        downloadModal.style.display = 'flex';
      }
    });

