    // Helper function for bidirectional binding between sliders and manual inputs
    // minVal/maxVal are the initial bounds; the live ones are read off the
    // element each time, so a mode that widens or narrows a slider's range takes
    // effect without rebinding. Every slider here is authored with min/max
    // attributes equal to the arguments passed, so this changes nothing for the
    // four that never move.
    function setupSliderBinding(slider, manualInput, minVal, maxVal, divisor, onUpdate) {
      const lo = () => (slider.min === '' ? minVal : +slider.min);
      const hi = () => (slider.max === '' ? maxVal : +slider.max);
      slider.addEventListener('input', (e) => {
        const val = parseInt(e.target.value);
        manualInput.value = val;
        onUpdate(val / divisor);
      });

      manualInput.addEventListener('input', (e) => {
        let val = parseInt(e.target.value);
        if (isNaN(val)) return;
        if (val >= lo() && val <= hi()) {
          slider.value = val;
        }
        onUpdate(val / divisor);
      });

      manualInput.addEventListener('blur', () => {
        let val = parseInt(manualInput.value);
        if (isNaN(val)) val = lo();
        if (val < lo()) val = lo();
        if (val > hi()) val = hi();
        manualInput.value = val;
        slider.value = val;
        onUpdate(val / divisor);
      });
    }

