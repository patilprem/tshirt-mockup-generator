    // Removes black background from logo using a BFS flood-fill boundary detector
    function preProcessDesign() {
      if (!designImage) return;

      const w = designImage.width;
      const h = designImage.height;

      processedDesignBuffer = document.createElement('canvas');
      processedDesignBuffer.width = w;
      processedDesignBuffer.height = h;
      const dCtx = processedDesignBuffer.getContext('2d');
      dCtx.drawImage(designImage, 0, 0);

      // Check if image already has transparent pixels.
      // If it does, we skip keying to avoid corrupting professional transparent PNGs.
      const dData = dCtx.getImageData(0, 0, w, h);
      const pixels = dData.data;
      
      let hasTransparency = false;
      for (let i = 3; i < pixels.length; i += 4) {
        if (pixels[i] < 240) {
          hasTransparency = true;
          break;
        }
      }

      if (hasTransparency) {
        // Just keep the original design as is
        isDesignTransparent = true;
        return;
      }

      isDesignTransparent = false;

      // Run Flood-Fill keyer starting from borders to extract outer black background
      const visited = new Uint8Array(w * h);
      const queue = [];

      function enqueue(x, y) {
        if (x >= 0 && x < w && y >= 0 && y < h) {
          const idx = y * w + x;
          if (!visited[idx]) {
            visited[idx] = 1;
            queue.push(idx);
          }
        }
      }

      // Enqueue all boundary pixels
      for (let x = 0; x < w; x++) {
        enqueue(x, 0);
        enqueue(x, h - 1);
      }
      for (let y = 0; y < h; y++) {
        enqueue(0, y);
        enqueue(w - 1, y);
      }

      while (queue.length > 0) {
        const idx = queue.shift();
        const px = idx % w;
        const py = Math.floor(idx / w);
        const rIdx = idx * 4;
        
        const r = pixels[rIdx];
        const g = pixels[rIdx + 1];
        const b = pixels[rIdx + 2];

        // Key threshold: pixel is dark (r,g,b < 35)
        if (r < 35 && g < 35 && b < 35) {
          pixels[rIdx + 3] = 0; // Make transparent

          // Add 4-connected neighbors
          enqueue(px + 1, py);
          enqueue(px - 1, py);
          enqueue(px, py + 1);
          enqueue(px, py - 1);
        }
      }

      // Smooth transition edges of keyed image
      for (let idx = 0; idx < w * h; idx++) {
        if (visited[idx]) continue;
        
        const rIdx = idx * 4;
        const px = idx % w;
        const py = Math.floor(idx / w);
        
        // If not background, check if adjacent to transparent background
        const r = pixels[rIdx];
        const g = pixels[rIdx + 1];
        const b = pixels[rIdx + 2];
        const isDark = (r < 60 && g < 60 && b < 60);

        if (isDark) {
          let hasBgNeighbor = false;
          // check 4 directions
          const neighbors = [
            (py > 0) ? (py - 1) * w + px : -1,
            (py < h - 1) ? (py + 1) * w + px : -1,
            (px > 0) ? py * w + (px - 1) : -1,
            (px < w - 1) ? py * w + (px + 1) : -1
          ];
          
          for (let n of neighbors) {
            if (n !== -1 && visited[n]) {
              hasBgNeighbor = true;
              break;
            }
          }

          if (hasBgNeighbor) {
            // Anti-alias edge
            const brightness = 0.299 * r + 0.587 * g + 0.114 * b;
            pixels[rIdx + 3] = Math.round(255 * (brightness / 60));
          }
        }
      }

      dCtx.putImageData(dData, 0, 0);
    }

    // ----------------------------------------------------
    // 4. Custom Background Rendering Helpers
    // ----------------------------------------------------
    function drawBackground(ctxTarget, w, h, isExport = false) {
      switch (activeBgType) {
        case 'transparent':
          ctxTarget.clearRect(0, 0, w, h);
          break;
          
        case 'solid-picker':
          ctxTarget.fillStyle = customBgColor;
          ctxTarget.fillRect(0, 0, w, h);
          break;

        case 'wood-white':
          if (woodWhiteImg) {
            ctxTarget.drawImage(woodWhiteImg, 0, 0, w, h);
          } else {
            ctxTarget.fillStyle = '#e8e8e6';
            ctxTarget.fillRect(0, 0, w, h);
          }
          break;

        case 'wood-brown':
          if (woodBrownImg) {
            ctxTarget.drawImage(woodBrownImg, 0, 0, w, h);
          } else {
            ctxTarget.fillStyle = '#563e2a';
            ctxTarget.fillRect(0, 0, w, h);
          }
          break;

        default:
          ctxTarget.fillStyle = customBgColor;
          ctxTarget.fillRect(0, 0, w, h);
          break;
      }
    }

    function drawProps(ctxTarget, scale = 1) {
      Object.keys(activeProps).forEach(type => {
        if (activeProps[type]) {
          const config = propConfigs[type];
          if (config.loaded && config.img) {
            ctxTarget.save();
            
            // Translate to center of prop in scaled space
            const cx = (config.x + config.w / 2) * scale;
            const cy = (config.y + config.h / 2) * scale;
            ctxTarget.translate(cx, cy);
            
            // Rotate
            const rot = config.rotation || 0;
            ctxTarget.rotate(rot);
            
            // Fixed screen shadow offset (down & right)
            const cos = Math.cos(rot);
            const sin = Math.sin(rot);
            const shadowX = 8 * cos + 12 * sin;
            const shadowY = 12 * cos - 8 * sin;

            ctxTarget.shadowColor = 'rgba(0, 0, 0, 0.45)';
            ctxTarget.shadowBlur = 18 * scale;
            ctxTarget.shadowOffsetX = shadowX * scale;
            ctxTarget.shadowOffsetY = shadowY * scale;
            
            // Draw image centered at origin
            ctxTarget.drawImage(
              config.img, 
              -config.w / 2 * scale, 
              -config.h / 2 * scale, 
              config.w * scale, 
              config.h * scale
            );
            ctxTarget.restore();
          }
        }
      });
    }

    // ----------------------------------------------------
    // 5. Canvas Compositing & Drawing Loop
    // ----------------------------------------------------
    function drawScene(targetCtx, w, h, scale = 1, isExport = false) {
      // 1. Draw Backdrop
      drawBackground(targetCtx, w, h, isExport);

      // 2. Render T-Shirt + Design offscreen to handle masking correctly
      const tshirtOffscreen = document.createElement('canvas');
      tshirtOffscreen.width = w;
      tshirtOffscreen.height = h;
      const offCtx = tshirtOffscreen.getContext('2d');

      // A. Draw the transparent silhouette mask
      offCtx.drawImage(processedShirtMask, 0, 0, w, h);

      // B. Mask with T-shirt base color
      offCtx.globalCompositeOperation = 'source-in';
      offCtx.fillStyle = shirtColor;
      offCtx.fillRect(0, 0, w, h);

      // C. Draw graphic design layer on top
      if (designImage) {
        offCtx.globalCompositeOperation = 'source-atop';
        offCtx.save();
        offCtx.translate(designPos.x * scale, designPos.y * scale);
        offCtx.rotate(designRotation);
        
        // Calculate graphic size
        const baseSize = 500 * scale; // base bounding size
        const dAspect = designImage.width / designImage.height;
        let dW = baseSize * designScale;
        let dH = baseSize * designScale;
        if (dAspect > 1) {
          dH = dW / dAspect;
        } else {
          dW = dH * dAspect;
        }

        offCtx.globalAlpha = designOpacity;
        
        const sourceGraphic = isDesignTransparent ? designImage : processedDesignBuffer;
        offCtx.drawImage(sourceGraphic, -dW / 2, -dH / 2, dW, dH);
        offCtx.restore();
      }

      // D. Apply fabric shadow and highlight overlays
      if (useRealisticBlending) {
        // Multiply creases on top of colored shirt + logo
        offCtx.globalCompositeOperation = 'source-atop';
        offCtx.save();
        offCtx.globalAlpha = shadowDepth;
        offCtx.globalCompositeOperation = 'multiply';
        offCtx.drawImage(processedShirtShadows, 0, 0, w, h);
        offCtx.restore();

        // Screen/Overlay highlights on top
        offCtx.globalCompositeOperation = 'source-atop';
        offCtx.save();
        offCtx.globalAlpha = highlightShine;
        offCtx.globalCompositeOperation = 'screen';
        offCtx.drawImage(processedShirtHighlights, 0, 0, w, h);
        offCtx.restore();
      }

      // E. Draw finished offscreen mockup onto main viewport canvas
      targetCtx.save();
      if (activeBgType !== 'transparent') {
        targetCtx.shadowColor = 'rgba(0, 0, 0, 0.20)';
        targetCtx.shadowBlur = 32 * scale;
        targetCtx.shadowOffsetY = 16 * scale;
      }
      targetCtx.drawImage(tshirtOffscreen, 0, 0);
      targetCtx.restore();

      // F. Draw active aesthetic props with realistic drop shadows
      drawProps(targetCtx, scale);
    }

    function render(showHandles = true) {
      if (!isShirtLoaded) return;

      const w = canvas.width;
      const h = canvas.height;

      // Draw scene at 1x scale
      drawScene(ctx, w, h, 1, false);

      // 3. Draw Editor Interactive Handles (if requested)
      if (showHandles) {
        if (designImage && selectedElement === 'design') {
          drawEditorHandles();
        }
        drawPropHandles();
      }
    }

    // Draws bounding box outline, scale corners, and rotation handle
    function drawEditorHandles() {
      const baseSize = 500;
      const dAspect = designImage.width / designImage.height;
      let dW = baseSize * designScale;
      let dH = baseSize * designScale;
      if (dAspect > 1) {
        dH = dW / dAspect;
      } else {
        dW = dH * dAspect;
      }

      ctx.save();
      ctx.translate(designPos.x, designPos.y);
      ctx.rotate(designRotation);

      // Draw Dashed Bounding Box Outline
      ctx.strokeStyle = '#00b4e6';
      ctx.lineWidth = 2;
      ctx.setLineDash([6, 4]);
      ctx.strokeRect(-dW / 2, -dH / 2, dW, dH);

      // Draw Center Position dot
      ctx.fillStyle = '#00b4e6';
      ctx.beginPath();
      ctx.arc(0, 0, 4, 0, Math.PI*2);
      ctx.fill();

      // Draw Corner Handles (Scale)
      ctx.setLineDash([]); // solid lines
      ctx.fillStyle = '#ffffff';
      ctx.strokeStyle = '#00b4e6';
      const hSize = 12; // handle size

      const corners = [
        { x: -dW / 2, y: -dH / 2 }, // Top Left
        { x: dW / 2, y: -dH / 2 },  // Top Right
        { x: dW / 2, y: dH / 2 },   // Bottom Right
        { x: -dW / 2, y: dH / 2 }   // Bottom Left
      ];

      corners.forEach(c => {
        ctx.fillRect(c.x - hSize/2, c.y - hSize/2, hSize, hSize);
        ctx.strokeRect(c.x - hSize/2, c.y - hSize/2, hSize, hSize);
      });

      // Draw Rotation Handle (Line upwards + Circle handle)
      const rotY = -dH / 2 - 35;
      ctx.beginPath();
      ctx.moveTo(0, -dH / 2);
      ctx.lineTo(0, rotY);
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(0, rotY, hSize/1.5, 0, Math.PI*2);
      ctx.fill();
      ctx.stroke();

      ctx.restore();
    }

    function getPropTransformMetrics(type) {
      const config = propConfigs[type];
      if (!config) return null;

      const w = config.w;
      const h = config.h;
      const rotation = config.rotation || 0;
      const centerX = config.x + w / 2;
      const centerY = config.y + h / 2;

      const cos = Math.cos(rotation);
      const sin = Math.sin(rotation);

      function localToGlobal(lx, ly) {
        return {
          x: lx * cos - ly * sin + centerX,
          y: lx * sin + ly * cos + centerY
        };
      }

      return {
        width: w,
        height: h,
        center: { x: centerX, y: centerY },
        corners: {
          tl: localToGlobal(-w / 2, -h / 2),
          tr: localToGlobal(w / 2, -h / 2),
          br: localToGlobal(w / 2, h / 2),
          bl: localToGlobal(-w / 2, h / 2)
        },
        rot: localToGlobal(0, -h / 2 - 35)
      };
    }

    function isPointInsidePropBox(type, cx, cy) {
      const config = propConfigs[type];
      if (!config) return false;
      const metrics = getPropTransformMetrics(type);
      if (!metrics) return false;

      const centerX = config.x + config.w / 2;
      const centerY = config.y + config.h / 2;
      const rotation = config.rotation || 0;

      const tx = cx - centerX;
      const ty = cy - centerY;

      const ux = tx * Math.cos(-rotation) - ty * Math.sin(-rotation);
      const uy = tx * Math.sin(-rotation) + ty * Math.cos(-rotation);

      return (
        ux >= -metrics.width / 2 &&
        ux <= metrics.width / 2 &&
        uy >= -metrics.height / 2 &&
        uy <= metrics.height / 2
      );
    }

    function checkHitProps(cx, cy) {
      const propTypes = Object.keys(activeProps);
      for (let i = propTypes.length - 1; i >= 0; i--) {
        const type = propTypes[i];
        if (activeProps[type]) {
          const config = propConfigs[type];
          if (config.loaded && config.img) {
            if (isPointInsidePropBox(type, cx, cy)) {
              return type;
            }
          }
        }
      }
      return null;
    }

    function checkHitPropHandles(type, cx, cy) {
      const metrics = getPropTransformMetrics(type);
      if (!metrics) return null;
      
      const clickRadius = 25; // hit area in canvas pixels
      
      // Check rotation handle
      if (Math.hypot(metrics.rot.x - cx, metrics.rot.y - cy) < clickRadius) {
        return { type: 'rotate' };
      }
      
      // Check scale corner handles
      for (const [corner, pt] of Object.entries(metrics.corners)) {
        if (Math.hypot(pt.x - cx, pt.y - cy) < clickRadius) {
          return { type: 'scale', corner: corner };
        }
      }
      return null;
    }

    function drawPropHandles() {
      // 1. Draw selection box & handles for selected prop
      if (selectedElement && selectedElement !== 'design' && activeProps[selectedElement]) {
        const config = propConfigs[selectedElement];
        if (config.loaded && config.img) {
          const metrics = getPropTransformMetrics(selectedElement);
          if (metrics) {
            ctx.save();
            ctx.translate(metrics.center.x, metrics.center.y);
            ctx.rotate(config.rotation || 0);

            // Dashed Bounding Box Outline
            ctx.strokeStyle = '#00b4e6';
            ctx.lineWidth = 2;
            ctx.setLineDash([6, 4]);
            ctx.strokeRect(-metrics.width / 2, -metrics.height / 2, metrics.width, metrics.height);

            // Draw Center Position dot
            ctx.fillStyle = '#00b4e6';
            ctx.beginPath();
            ctx.arc(0, 0, 4, 0, Math.PI*2);
            ctx.fill();

            // Draw Corner Handles (Scale)
            ctx.setLineDash([]); // solid lines
            ctx.fillStyle = '#ffffff';
            ctx.strokeStyle = '#00b4e6';
            const hSize = 12; // handle size

            const corners = [
              { x: -metrics.width / 2, y: -metrics.height / 2 },
              { x: metrics.width / 2, y: -metrics.height / 2 },
              { x: metrics.width / 2, y: metrics.height / 2 },
              { x: -metrics.width / 2, y: metrics.height / 2 }
            ];

            corners.forEach(c => {
              ctx.fillRect(c.x - hSize/2, c.y - hSize/2, hSize, hSize);
              ctx.strokeRect(c.x - hSize/2, c.y - hSize/2, hSize, hSize);
            });

            // Draw Rotation Handle (Line upwards + Circle handle)
            const rotY = -metrics.height / 2 - 35;
            ctx.beginPath();
            ctx.moveTo(0, -metrics.height / 2);
            ctx.lineTo(0, rotY);
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(0, rotY, hSize/1.5, 0, Math.PI*2);
            ctx.fill();
            ctx.stroke();

            ctx.restore();
          }
        }
      }

      // 2. Draw hover outline for hovered prop (only if it's not the selected one)
      if (hoveredPropType && hoveredPropType !== selectedElement && activeProps[hoveredPropType]) {
        const config = propConfigs[hoveredPropType];
        if (config.loaded && config.img) {
          const metrics = getPropTransformMetrics(hoveredPropType);
          if (metrics) {
            ctx.save();
            ctx.translate(metrics.center.x, metrics.center.y);
            ctx.rotate(config.rotation || 0);
            ctx.strokeStyle = 'rgba(0, 180, 230, 0.5)';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([4, 3]);
            ctx.strokeRect(-metrics.width / 2, -metrics.height / 2, metrics.width, metrics.height);
            ctx.restore();
          }
        }
      }

      // 3. Draw dragged prop indicator
      if (draggedPropType) {
        const config = propConfigs[draggedPropType];
        const metrics = getPropTransformMetrics(draggedPropType);
        if (metrics) {
          ctx.save();
          ctx.translate(metrics.center.x, metrics.center.y);
          ctx.rotate(config.rotation || 0);
          ctx.strokeStyle = '#008ab3';
          ctx.lineWidth = 2;
          ctx.setLineDash([6, 4]);
          ctx.strokeRect(-metrics.width / 2, -metrics.height / 2, metrics.width, metrics.height);
          ctx.restore();
        }
      }
    }

    // ----------------------------------------------------
    // 6. Interactive Click/Drag Bounding Box Math
    // ----------------------------------------------------
    
    // Calculates coordinates of handles in global canvas space
    function getTransformMetrics() {
      const baseSize = 500;
      const dAspect = designImage.width / designImage.height;
      let dW = baseSize * designScale;
      let dH = baseSize * designScale;
      if (dAspect > 1) {
        dH = dW / dAspect;
      } else {
        dW = dH * dAspect;
      }

      const cos = Math.cos(designRotation);
      const sin = Math.sin(designRotation);

      function localToGlobal(lx, ly) {
        return {
          x: lx * cos - ly * sin + designPos.x,
          y: lx * sin + ly * cos + designPos.y
        };
      }

      return {
        width: dW,
        height: dH,
        center: designPos,
        corners: {
          tl: localToGlobal(-dW / 2, -dH / 2),
          tr: localToGlobal(dW / 2, -dH / 2),
          br: localToGlobal(dW / 2, dH / 2),
          bl: localToGlobal(-dW / 2, dH / 2)
        },
        rot: localToGlobal(0, -dH / 2 - 35)
      };
    }

    // Checks if canvas click falls inside rotated bounding box
    function isPointInsideBox(cx, cy) {
      if (!designImage) return false;
      const metrics = getTransformMetrics();
      
      // Translate to origin
      const tx = cx - designPos.x;
      const ty = cy - designPos.y;

      // Rotate point inversely to match bounding box alignment
      const ux = tx * Math.cos(-designRotation) - ty * Math.sin(-designRotation);
      const uy = tx * Math.sin(-designRotation) + ty * Math.cos(-designRotation);

      return (
        ux >= -metrics.width / 2 && 
        ux <= metrics.width / 2 && 
        uy >= -metrics.height / 2 && 
        uy <= metrics.height / 2
      );
    }

    // Checks distance to interactive handles
    function checkHitHandles(cx, cy) {
      if (!designImage) return null;
      const metrics = getTransformMetrics();
      const clickRadius = 25; // hit area in canvas pixels

      function getDist(p1, p2) {
        return Math.sqrt(Math.pow(p1.x - p2, 2) + Math.pow(p1.y - cy, 2));
      }

      // Check rotation handle
      if (Math.hypot(metrics.rot.x - cx, metrics.rot.y - cy) < clickRadius) {
        return { type: 'rotate' };
      }

      // Check scale corner handles
      for (const [corner, pt] of Object.entries(metrics.corners)) {
        if (Math.hypot(pt.x - cx, pt.y - cy) < clickRadius) {
          return { type: 'scale', corner: corner };
        }
      }

      // Check center body drag
      if (isPointInsideBox(cx, cy)) {
        return { type: 'drag' };
      }

      return null;
    }

    // ----------------------------------------------------
    // 7. Mouse/Touch Event Handlers
    // ----------------------------------------------------
    
    // Convert screen coordinates to canvas pixels
    function getCanvasCoords(e) {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;
      
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;

      return {
        x: (clientX - rect.left) * scaleX,
        y: (clientY - rect.top) * scaleY
      };
    }

    function handleStart(coords) {
      // 1. Check if they clicked on the active selected prop's corner handles or rotation handle
      if (selectedElement && selectedElement !== 'design') {
        const hitPropHandle = checkHitPropHandles(selectedElement, coords.x, coords.y);
        if (hitPropHandle) {
          if (hitPropHandle.type === 'scale') {
            isScalingProp = true;
            activeScaleCorner = hitPropHandle.corner;
            const config = propConfigs[selectedElement];
            startPropWidth = config.w;
            startPropHeight = config.h;
            startPropX = config.x;
            startPropY = config.y;
            startPropAspect = config.w / config.h;
            
            const centerX = config.x + config.w / 2;
            const centerY = config.y + config.h / 2;
            startDistFromCenter = Math.hypot(coords.x - centerX, coords.y - centerY);
            canvas.style.cursor = 'nwse-resize';
          } else if (hitPropHandle.type === 'rotate') {
            isRotatingProp = true;
            const config = propConfigs[selectedElement];
            startRotation = config.rotation || 0;
            const centerX = config.x + config.w / 2;
            const centerY = config.y + config.h / 2;
            startAngleOffset = Math.atan2(coords.y - centerY, coords.x - centerX);
            canvas.style.cursor = 'grabbing';
          }
          return;
        }
      }

      // 2. Check if they clicked on any active prop to select & drag it
      const hitProp = checkHitProps(coords.x, coords.y);
      if (hitProp) {
        selectedElement = hitProp;
        draggedPropType = hitProp;
        const config = propConfigs[hitProp];
        dragStartOffset.x = coords.x - config.x;
        dragStartOffset.y = coords.y - config.y;
        canvas.style.cursor = 'grabbing';
        render();
        return;
      }

      // 3. Otherwise, check if they clicked on the design handles (or the design itself)
      const hit = checkHitHandles(coords.x, coords.y);
      if (hit) {
        selectedElement = 'design';
        if (hit.type === 'drag') {
          isDragging = true;
          dragStartOffset.x = coords.x - designPos.x;
          dragStartOffset.y = coords.y - designPos.y;
          canvas.style.cursor = 'grabbing';
        } else if (hit.type === 'scale') {
          isScaling = true;
          activeScaleCorner = hit.corner;
          startScale = designScale;
          startDistFromCenter = Math.hypot(coords.x - designPos.x, coords.y - designPos.y);
          canvas.style.cursor = 'nwse-resize';
        } else if (hit.type === 'rotate') {
          isRotating = true;
          startRotation = designRotation;
          startAngleOffset = Math.atan2(coords.y - designPos.y, coords.x - designPos.x);
          canvas.style.cursor = 'grabbing';
        }
        render();
        return;
      }

      // 4. Clicked on empty canvas space -> deselect all!
      selectedElement = null;
      isDragging = false;
      isScaling = false;
      isRotating = false;
      isScalingProp = false;
      isRotatingProp = false;
      draggedPropType = null;
      render();
      canvas.style.cursor = 'default';
    }

    function handleMove(coords) {
      // 1. If scaling a selected prop
      if (isScalingProp && selectedElement) {
        const config = propConfigs[selectedElement];
        const centerX = config.x + config.w / 2;
        const centerY = config.y + config.h / 2;
        const currentDist = Math.hypot(coords.x - centerX, coords.y - centerY);
        const ratio = currentDist / startDistFromCenter;

        // Maintain aspect ratio, enforce limits (50px to 600px width)
        let newW = Math.max(50, Math.min(600, startPropWidth * ratio));
        let newH = newW / startPropAspect;

        config.x = centerX - newW / 2;
        config.y = centerY - newH / 2;
        config.w = newW;
        config.h = newH;
        render();
        return;
      }

      // 1b. If rotating a selected prop
      if (isRotatingProp && selectedElement) {
        const config = propConfigs[selectedElement];
        const centerX = config.x + config.w / 2;
        const centerY = config.y + config.h / 2;
        const currentAngle = Math.atan2(coords.y - centerY, coords.x - centerX);
        let angleDelta = currentAngle - startAngleOffset;
        let newRotation = startRotation + angleDelta;
        let deg = Math.round(newRotation * (180 / Math.PI));
        if (deg > 180) deg -= 360;
        if (deg < -180) deg += 360;
        config.rotation = deg * (Math.PI / 180);
        render();
        return;
      }

      // 2. If dragging a prop
      if (draggedPropType) {
        const config = propConfigs[draggedPropType];
        config.x = Math.max(-config.w / 2, Math.min(1000 - config.w / 2, coords.x - dragStartOffset.x));
        config.y = Math.max(-config.h / 2, Math.min(1000 - config.h / 2, coords.y - dragStartOffset.y));
        render();
        return;
      }

      // 3. Update cursor style & handle hover states if no drag/scale is active
      if (!isDragging && !isScaling && !isRotating && !draggedPropType && !isScalingProp && !isRotatingProp) {
        // First check if hovering over selected prop's corner handles or rotation handle
        if (selectedElement && selectedElement !== 'design') {
          const hitPropHandle = checkHitPropHandles(selectedElement, coords.x, coords.y);
          if (hitPropHandle) {
            if (hitPropHandle.type === 'scale') {
              canvas.style.cursor = 'nwse-resize';
            } else if (hitPropHandle.type === 'rotate') {
              canvas.style.cursor = 'alias';
            }
            return;
          }
        }

        // Then check if hovering over any prop body
        const hitProp = checkHitProps(coords.x, coords.y);
        if (hitProp) {
          hoveredPropType = hitProp;
          canvas.style.cursor = 'grab';
          render();
          return;
        } else if (hoveredPropType) {
          hoveredPropType = null;
          canvas.style.cursor = 'default';
          render();
        }

        // Then check if hovering over design handles
        const hit = checkHitHandles(coords.x, coords.y);
        if (hit) {
          if (hit.type === 'drag') canvas.style.cursor = 'grab';
          else if (hit.type === 'scale') canvas.style.cursor = 'nwse-resize';
          else if (hit.type === 'rotate') canvas.style.cursor = 'alias';
        } else {
          canvas.style.cursor = 'default';
        }
        return;
      }

      if (!designImage) return;

      // 4. Drag logo
      if (isDragging) {
        designPos.x = Math.max(100, Math.min(900, coords.x - dragStartOffset.x));
        designPos.y = Math.max(100, Math.min(900, coords.y - dragStartOffset.y));
      }

      // 5. Scale logo
      if (isScaling) {
        const currentDist = Math.hypot(coords.x - designPos.x, coords.y - designPos.y);
        let ratio = currentDist / startDistFromCenter;
        let newScale = Math.max(0.1, Math.min(0.9, startScale * ratio));
        designScale = newScale;
        scaleSlider.value = Math.round(newScale * 100);
        scaleVal.innerText = Math.round(newScale * 100) + '%';
        userHasManuallyScaled = true;
      }

      // 6. Rotate logo
      if (isRotating) {
        const currentAngle = Math.atan2(coords.y - designPos.y, coords.x - designPos.x);
        let angleDelta = currentAngle - startAngleOffset;
        let newRotation = startRotation + angleDelta;
        let deg = Math.round(newRotation * (180 / Math.PI));
        if (deg > 180) deg -= 360;
        if (deg < -180) deg += 360;
        designRotation = deg * (Math.PI / 180);
        rotateSlider.value = deg;
        rotateVal.innerText = deg + '°';
      }

      render();
    }

    function handleEnd() {
      isDragging = false;
      isScaling = false;
      isRotating = false;
      isScalingProp = false;
      draggedPropType = null;
      canvas.style.cursor = 'default';
      render();
    }

    // Attach Mouse Events
    canvas.addEventListener('mousedown', (e) => {
      e.preventDefault();
      handleStart(getCanvasCoords(e));
    });
    window.addEventListener('mousemove', (e) => {
      handleMove(getCanvasCoords(e));
    });
    window.addEventListener('mouseup', () => {
      handleEnd();
    });

    // Attach Touch Mobile Events
    canvas.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        e.preventDefault();
        handleStart(getCanvasCoords(e));
      }
    });
    window.addEventListener('touchmove', (e) => {
      if (isDragging || isScaling || isRotating || draggedPropType || isScalingProp || isRotatingProp) {
        handleMove(getCanvasCoords(e));
      }
    }, { passive: false });
    window.addEventListener('touchend', () => {
      handleEnd();
    });

    // Global click/touch listener to clear selection when clicking outside
    const handleOutsideClick = (e) => {
      if (canvas && !canvas.contains(e.target) &&
          !e.target.closest('.sidebar') &&
          !e.target.closest('.viewport-export-panel') &&
          !e.target.closest('.swatch-panel')) {
        selectedElement = null;
        render();
      }
    };
    window.addEventListener('mousedown', handleOutsideClick);
    window.addEventListener('touchstart', handleOutsideClick);

    // ----------------------------------------------------
    // 8. Sidebar Controls Event Bindings
    // ----------------------------------------------------

    // T-shirt Presets Colors
    presetColors.addEventListener('click', (e) => {
      const btn = e.target.closest('.color-btn');
      if (!btn) return;

      // Toggle active states
      presetColors.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      shirtColor = btn.dataset.color;
      customColorPreview.style.backgroundColor = shirtColor;
      colorHexLabel.innerText = shirtColor;
      
      fabricColorPicker.setColor(shirtColor, false);

      buildSwatchGrid(swatchGrid, (color, hex) => {
        shirtColor = color;
        colorHexLabel.innerText = hex;
        customColorPreview.style.backgroundColor = hex;
        presetColors.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
        fabricColorPicker.setColor(hex, false);
        render();
      }, shirtColor);
      render();
    });

    // Custom Color Swatch dropdown toggle
    customColorToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const show = swatchGridPanel.style.display === 'none';
      swatchGridPanel.style.display = show ? 'block' : 'none';
      bgSwatchGridPanel.style.display = 'none';
    });

    // Background selection
    bgSelector.addEventListener('click', (e) => {
      const btn = e.target.closest('.texture-btn');
      if (!btn) return;

      bgSelector.querySelectorAll('.texture-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      activeBgType = btn.dataset.bg;
      if (activeBgType === 'solid-picker') {
        bgColorPickerContainer.style.display = 'flex';
      } else {
        bgColorPickerContainer.style.display = 'none';
      }

      if (activeBgType === 'transparent') {
        container.classList.add('transparent-active');
      } else {
        container.classList.remove('transparent-active');
      }
      render();
    });

    // Custom BG Color Swatch dropdown toggle
    bgCustomColorToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const show = bgSwatchGridPanel.style.display === 'none';
      bgSwatchGridPanel.style.display = show ? 'block' : 'none';
      swatchGridPanel.style.display = 'none';
    });

    // Click outside swatch grids to close them
    window.addEventListener('click', () => {
      swatchGridPanel.style.display = 'none';
      bgSwatchGridPanel.style.display = 'none';
    });

    swatchGridPanel.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    bgSwatchGridPanel.addEventListener('click', (e) => {
      e.stopPropagation();
    });

    // Preset Sample Designs Select
    sampleDesigns.addEventListener('click', (e) => {
      const thumb = e.target.closest('.design-thumb');
      if (!thumb) return;

      sampleDesigns.querySelectorAll('.design-thumb').forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');

      designSrc = thumb.dataset.src;
      loadActiveDesign();
    });

    // File Upload Zone interaction
    dropZone.addEventListener('click', () => {
      fileInput.click();
    });

    // Drag-over styling
    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.style.borderColor = 'var(--primary)';
      dropZone.style.background = 'var(--primary-glow)';
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.style.borderColor = 'hsla(225, 20%, 25%, 0.4)';
      dropZone.style.background = 'var(--bg-card)';
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.style.borderColor = 'hsla(225, 20%, 25%, 0.4)';
      dropZone.style.background = 'var(--bg-card)';
      
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        handleUploadedFile(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) {
        handleUploadedFile(e.target.files[0]);
      }
    });

    function handleUploadedFile(file) {
      if (!file.type.match('image.*')) {
        alert('Please upload an image file (PNG/JPG/SVG).');
        return;
      }

      const reader = new FileReader();
      reader.onload = (e) => {
        // Remove active state from preset designs
        sampleDesigns.querySelectorAll('.design-thumb').forEach(t => t.classList.remove('active'));
        
        designSrc = e.target.result;
        loadActiveDesign();
      };
      reader.readAsDataURL(file);
    }

    // Props Selector Interaction
    const propsSelector = document.getElementById('props-selector');
    propsSelector.addEventListener('click', async (e) => {
      const card = e.target.closest('.prop-card');
      if (!card) return;

      const propType = card.dataset.prop;
      activeProps[propType] = !activeProps[propType];

      if (activeProps[propType]) {
        card.classList.add('active');
        if (canvasLoading) canvasLoading.style.display = 'flex';
        await loadProp(propType);
        if (canvasLoading) canvasLoading.style.display = 'none';
      } else {
        card.classList.remove('active');
      }

      render();
    });

    // Garment Selector Interaction
    garmentSelector.addEventListener('click', (e) => {
      const card = e.target.closest('.garment-card');
      if (!card) return;

      garmentSelector.querySelectorAll('.garment-card').forEach(c => c.classList.remove('active'));
      card.classList.add('active');

      const garmentType = card.dataset.garment;
      loadGarment(garmentType);
    });

    // Align actions
    alignTop.addEventListener('click', () => {
      designPos.y = garmentConfigs[activeGarmentType].chestY; // Chest area height
      render();
    });

    alignCenter.addEventListener('click', () => {
      designPos.x = 500;
      designPos.y = garmentConfigs[activeGarmentType].centerY; // center shirt layout
      render();
    });

    alignBottom.addEventListener('click', () => {
      designPos.y = garmentConfigs[activeGarmentType].bellyY; // stomach height
      render();
    });

    // Size Slider
    scaleSlider.addEventListener('input', (e) => {
      const val = parseInt(e.target.value);
      designScale = val / 100;
      scaleVal.innerText = val + '%';
      userHasManuallyScaled = true;
      render();
    });

    // Rotation Slider
    rotateSlider.addEventListener('input', (e) => {
      const val = parseInt(e.target.value);
      designRotation = val * (Math.PI / 180);
      rotateVal.innerText = val + '°';
      render();
    });

    // Opacity Slider
    opacitySlider.addEventListener('input', (e) => {
      const val = parseInt(e.target.value);
      designOpacity = val / 100;
      opacityVal.innerText = val + '%';
      render();
    });

    // Shadow Depth Slider
    shadowDepthSlider.addEventListener('input', (e) => {
      const val = parseInt(e.target.value);
      shadowDepth = val / 100;
      shadowDepthVal.innerText = val + '%';
      render();
    });

    // Highlight Shine Slider
    highlightShineSlider.addEventListener('input', (e) => {
      const val = parseInt(e.target.value);
      highlightShine = val / 100;
      highlightShineVal.innerText = val + '%';
      render();
    });

    // Fabric Integration Blend settings
    blendRealistic.addEventListener('click', () => {
      blendRealistic.classList.add('active');
      blendFlat.classList.remove('active');
      useRealisticBlending = true;
      render();
    });

    blendFlat.addEventListener('click', () => {
      blendFlat.classList.add('active');
      blendRealistic.classList.remove('active');
      useRealisticBlending = false;
      render();
    });

    resetBtn.addEventListener('click', () => {
      shirtColor = '#212121';
      designRotation = 0;
      designOpacity = 1.0;
      useRealisticBlending = true;
      shadowDepth = 0.60;
      highlightShine = 0.15;
      activeBgType = 'wood-white';
      customBgColor = '#121318';

      // Reset garment active selection card
      garmentSelector.querySelectorAll('.garment-card').forEach(c => c.classList.remove('active'));
      const defaultCard = garmentSelector.querySelector('[data-garment="crewneck"]');
      if (defaultCard) defaultCard.classList.add('active');
      userHasManuallyScaled = false;
      loadGarment('crewneck');

      selectedElement = 'design';

      const defaultPropConfigs = {
        'plant': { x: 40, y: 40, w: 200, h: 200 },
        'hat': { x: 610, y: 100, w: 330, h: 330 },
        'shoes': { x: 50, y: 600, w: 330, h: 330 },
        'sunglasses': { x: 740, y: 400, w: 180, h: 72 },
        'jeans': { x: 630, y: 520, w: 300, h: 375 }
      };

      Object.keys(activeProps).forEach(type => {
        activeProps[type] = false;
        if (propConfigs[type] && defaultPropConfigs[type]) {
          propConfigs[type].x = defaultPropConfigs[type].x;
          propConfigs[type].y = defaultPropConfigs[type].y;
          propConfigs[type].w = defaultPropConfigs[type].w;
          propConfigs[type].h = defaultPropConfigs[type].h;
          propConfigs[type].rotation = 0;
        }
      });
      propsSelector.querySelectorAll('.prop-card').forEach(c => c.classList.remove('active'));

      // Reset DOM elements
      scaleSlider.value = 35;
      scaleVal.innerText = '35%';
      rotateSlider.value = 0;
      rotateVal.innerText = '0°';
      opacitySlider.value = 100;
      opacityVal.innerText = '100%';
      shadowDepthSlider.value = 60;
      shadowDepthVal.innerText = '60%';
      highlightShineSlider.value = 15;
      highlightShineVal.innerText = '15%';
      
      presetColors.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
      presetColors.querySelector('[data-color="#212121"]').classList.add('active');
      customColorPreview.style.backgroundColor = '#212121';
      colorHexLabel.innerText = '#212121';

      bgSelector.querySelectorAll('.texture-btn').forEach(b => b.classList.remove('active'));
      bgSelector.querySelector('[data-bg="wood-white"]').classList.add('active');
      bgColorPickerContainer.style.display = 'none';
      bgCustomColorPreview.style.backgroundColor = '#121318';
      bgColorHexLabel.innerText = '#121318';

      // Rebuild swatch grids to move checkmarks back to defaults
      buildSwatchGrid(swatchGrid, (color, hex) => {
        shirtColor = color;
        colorHexLabel.innerText = hex;
        customColorPreview.style.backgroundColor = hex;
        presetColors.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
        fabricColorPicker.setColor(hex, false);
        render();
      }, shirtColor);

      buildSwatchGrid(bgSwatchGrid, (color, hex) => {
        customBgColor = color;
        bgColorHexLabel.innerText = hex;
        bgCustomColorPreview.style.backgroundColor = hex;
        bgColorPicker.setColor(hex, false);
        render();
      }, customBgColor);

      fabricColorPicker.setColor('#212121', false);
      bgColorPicker.setColor('#121318', false);

      // Reset tabs back to "Presets"
      document.querySelectorAll('.swatch-tabs').forEach(tabsContainer => {
        const tabs = tabsContainer.querySelectorAll('.swatch-tab');
        tabs.forEach(t => t.classList.remove('active'));
        tabs[0].classList.add('active');
      });
      document.getElementById('fabric-presets-content').style.display = 'block';
      document.getElementById('fabric-custom-content').style.display = 'none';
      document.getElementById('bg-presets-content').style.display = 'block';
      document.getElementById('bg-custom-content').style.display = 'none';
      container.classList.remove('transparent-active');

      sampleDesigns.querySelectorAll('.design-thumb').forEach(t => t.classList.remove('active'));
      sampleDesigns.querySelector('[data-src="/assets/designs/minimal_rose.png"]').classList.add('active');
      
      blendRealistic.classList.add('active');
      blendFlat.classList.remove('active');

      designSrc = '/assets/designs/minimal_rose.png';
      loadActiveDesign();

      // Reset mobile active tab back to "design"
      const appContainer = document.querySelector('.app-container');
      if (appContainer && mobileNavBar) {
        appContainer.setAttribute('data-mobile-tab', 'design');
        const mobileNavButtons = mobileNavBar.querySelectorAll('.mobile-nav-btn');
        mobileNavButtons.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-selected', 'false');
        });
        const defaultTabBtn = mobileNavBar.querySelector('[data-target="design"]');
        if (defaultTabBtn) {
          defaultTabBtn.classList.add('active');
          defaultTabBtn.setAttribute('aria-selected', 'true');
        }
      }
    });

    // ----------------------------------------------------
    // 9. High-Quality Export/Download Handler
    // ----------------------------------------------------
    downloadBtn.addEventListener('click', () => {
      // 1. Create offscreen 2000x2000px canvas for high-quality export
      const exportCanvas = document.createElement('canvas');
      exportCanvas.width = 2000;
      exportCanvas.height = 2000;
      const exportCtx = exportCanvas.getContext('2d');

      // Show loading spinner during high-res rendering
      if (canvasLoading) canvasLoading.style.display = 'flex';

      setTimeout(() => {
        // 2. Render high-res mockup at 2x scale (2000x2000px)
        drawScene(exportCtx, 2000, 2000, 2, true);

        // 3. Extract high-res data URL
        const imageURL = exportCanvas.toDataURL('image/png');

        // 4. Trigger download
        const downloadLink = document.createElement('a');
        downloadLink.href = imageURL;
        const colorClean = shirtColor.replace('#', '');
        downloadLink.download = `tshirt-mockup-${colorClean}-${Date.now()}.png`;
        
        document.body.appendChild(downloadLink);
        downloadLink.click();
        document.body.removeChild(downloadLink);

        // Hide loading spinner
        if (canvasLoading) canvasLoading.style.display = 'none';
      }, 50);
    });

    // ----------------------------------------------------
    // 10. Mobile Tab Switching Handler
    // ----------------------------------------------------
    const mobileNavBar = document.getElementById('mobile-nav-bar');
    if (mobileNavBar) {
      const mobileNavButtons = mobileNavBar.querySelectorAll('.mobile-nav-btn');
      const appContainer = document.querySelector('.app-container');
      
      mobileNavButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = btn.dataset.target;
          appContainer.setAttribute('data-mobile-tab', target);
          
          mobileNavButtons.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
        });
      });
    }

  });
</script>
