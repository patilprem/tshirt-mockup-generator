---
// src/components/Editor.astro
---

<div class="app-container" data-mobile-tab="design">
  <!-- Mobile Tab Navigation (Only visible on mobile) -->
  <div class="mobile-nav-bar" id="mobile-nav-bar" role="tablist" aria-label="Mobile Navigation">
    <button class="mobile-nav-btn active" data-target="design" role="tab" aria-selected="true" aria-controls="design-graphic-section design-adjustment-panel">
      <span class="nav-icon" aria-hidden="true">✨</span>
      <span class="nav-text">Design</span>
    </button>
    <button class="mobile-nav-btn" data-target="garment" role="tab" aria-selected="false" aria-controls="garment-type-section shirt-color-section">
      <span class="nav-icon" aria-hidden="true">👕</span>
      <span class="nav-text">Garment</span>
    </button>
    <button class="mobile-nav-btn" data-target="background" role="tab" aria-selected="false" aria-controls="mockup-background-section canvas-size-section">
      <span class="nav-icon" aria-hidden="true">🖼️</span>
      <span class="nav-text">Background</span>
    </button>
    <button class="mobile-nav-btn" data-target="props" role="tab" aria-selected="false" aria-controls="aesthetic-props-section">
      <span class="nav-icon" aria-hidden="true">🌿</span>
      <span class="nav-text">Props</span>
    </button>
  </div>

  <!-- Left Sidebar Controls -->
  <aside class="sidebar sidebar-left">
    <!-- Section 0: Garment Type -->
    <div class="panel-section" id="garment-type-section">
      <h3 class="panel-title">Garment Type</h3>
      <div class="control-group">
        <div class="garment-grid" id="garment-selector">
          <button class="garment-card active" data-garment="crewneck" title="Classic Crewneck">
            <span class="garment-icon" aria-hidden="true">👕</span>
            <span class="garment-name">Crewneck</span>
          </button>
          <button class="garment-card" data-garment="ladies" title="Ladies Fitted Tee">
            <span class="garment-icon" aria-hidden="true">👚</span>
            <span class="nav-name" style="font-size: 0.75rem; white-space: nowrap;">Ladies Tee</span>
          </button>
          <button class="garment-card" data-garment="polo" title="Polo Collar Tee">
            <span class="garment-icon" aria-hidden="true">👔</span>
            <span class="garment-name">Polo Collar</span>
          </button>
          <button class="garment-card" data-garment="longsleeve" title="Long Sleeve Tee">
            <span class="garment-icon" aria-hidden="true">🧥</span>
            <span class="garment-name">Long Sleeve</span>
          </button>
          <button class="garment-card" data-garment="hoodie" title="Sport Hoodie">
            <span class="garment-icon" aria-hidden="true">🧥</span>
            <span class="garment-name">Hoodie</span>
          </button>
          <button class="garment-card" data-garment="sweatshirt" title="Sweatshirt">
            <span class="garment-icon" aria-hidden="true">👕</span>
            <span class="garment-name">Sweatshirt</span>
          </button>
          <button class="garment-card" data-garment="vneck" title="V-Neck Tee">
            <span class="garment-icon" aria-hidden="true">👕</span>
            <span class="garment-name">V-Neck</span>
          </button>
          <button class="garment-card" data-garment="tanktop" title="Tank Top">
            <span class="garment-icon" aria-hidden="true">🎽</span>
            <span class="garment-name">Tank Top</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Section 1: T-Shirt Color -->
    <div class="panel-section" id="shirt-color-section">
      <h3 class="panel-title">T-Shirt Color</h3>
      <div class="control-group">
        <div class="color-grid" id="preset-colors">
          <button class="color-btn" style="background-color: #ffffff;" data-color="#ffffff" title="Classic White" aria-label="Classic White"></button>
          <button class="color-btn active" style="background-color: #212121;" data-color="#212121" title="Vintage Black" aria-label="Vintage Black"></button>
          <button class="color-btn" style="background-color: #afb0b1;" data-color="#afb0b1" title="Athletic Heather Grey" aria-label="Athletic Heather Grey"></button>
          <button class="color-btn" style="background-color: #373a3c;" data-color="#373a3c" title="Charcoal Grey" aria-label="Charcoal Grey"></button>
          <button class="color-btn" style="background-color: #1b2230;" data-color="#1b2230" title="Classic Navy Blue" aria-label="Classic Navy Blue"></button>
          <button class="color-btn" style="background-color: #1e3b8a;" data-color="#1e3b8a" title="Royal Blue" aria-label="Royal Blue"></button>
          <button class="color-btn" style="background-color: #4b533f;" data-color="#4b533f" title="Olive Green" aria-label="Olive Green"></button>
          <button class="color-btn" style="background-color: #1e3328;" data-color="#1e3328" title="Forest Green" aria-label="Forest Green"></button>
          <button class="color-btn" style="background-color: #521c22;" data-color="#521c22" title="Maroon Burgundy" aria-label="Maroon Burgundy"></button>
          <button class="color-btn" style="background-color: #d2c6af;" data-color="#d2c6af" title="Sand Beige" aria-label="Sand Beige"></button>
          <button class="color-btn" style="background-color: #f5d5db;" data-color="#f5d5db" title="Baby Pink" aria-label="Baby Pink"></button>
          <button class="color-btn" style="background-color: #6b7c85;" data-color="#6b7c85" title="Dusty Blue" aria-label="Dusty Blue"></button>
        </div>
      </div>
      <div class="control-group">
        <label class="control-label" for="fabric-hex-input">Custom Fabric Color</label>
        <div class="custom-color-wrapper" id="custom-color-toggle" style="cursor: pointer; user-select: none;">
          <div class="color-btn" id="custom-color-preview" style="background-color: #ffffff; width: 22px; height: 22px; border: 2px solid var(--border-glass); margin: 0; box-shadow: none;" aria-hidden="true"></div>
          <span id="color-hex-label" class="color-picker-value">#ffffff</span>
          <span style="margin-left: auto; font-size: 0.75rem; color: var(--text-muted);" aria-hidden="true">▼</span>
        </div>
        
        <div id="swatch-grid-panel" class="swatch-panel" style="display: none;">
          <div class="swatch-tabs" id="fabric-swatch-tabs">
            <button type="button" class="swatch-tab active" data-tab="presets">Presets</button>
            <button type="button" class="swatch-tab" data-tab="custom">Custom</button>
          </div>
          
          <div class="tab-content" id="fabric-presets-content">
            <div class="swatch-grid" id="swatch-grid"></div>
          </div>
          
          <div class="tab-content" id="fabric-custom-content" style="display: none;">
            <div class="picker-container">
              <div class="picker-row">
                <div class="sl-container" id="fabric-sl-container">
                  <canvas class="sl-canvas" width="200" height="200"></canvas>
                  <div class="sl-marker" id="fabric-sl-marker"></div>
                </div>
                <div class="hue-container" id="fabric-hue-container">
                  <canvas class="hue-canvas" width="20" height="200"></canvas>
                  <div class="hue-marker" id="fabric-hue-marker"></div>
                </div>
              </div>
              <div class="picker-input-row">
                <div class="hex-input-wrapper">
                  <input type="text" class="hex-text-input" id="fabric-hex-input" name="fabric-hex" autocomplete="off" placeholder="#ffffff (e.g. #ff0000)…" maxlength="7" value="#ffffff" />
                  <div class="hex-preview-box" id="fabric-hex-preview" style="background-color: #ffffff;" aria-hidden="true"></div>
                </div>
                <button type="button" class="eye-dropper-btn" id="fabric-eyedropper-btn" title="Pick color from screen" aria-label="Pick color from screen">
                  <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 22l6-6M8.5 12.5l5 5M12.5 8.5l5 5M16 4l4 4-2.5 2.5-4-4L16 4z"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 2: Mockup Background -->
    <div class="panel-section" id="mockup-background-section">
      <h3 class="panel-title">Mockup Background</h3>
      <div class="control-group">
        <div class="texture-grid" id="bg-selector" style="grid-template-columns: repeat(2, 1fr);">
          <button class="texture-btn" data-bg="solid-picker">Solid Color</button>
          <button class="texture-btn" data-bg="transparent">Transparent</button>
          <button class="texture-btn active" data-bg="wood-white">Wood Panel White</button>
          <button class="texture-btn" data-bg="wood-brown">Wood Panel Brown</button>
        </div>
      </div>
      <div class="control-group" id="bg-color-picker-container" style="display: none;">
        <label class="control-label" for="bg-hex-input">Background Color</label>
        <div class="custom-color-wrapper" id="bg-custom-color-toggle" style="cursor: pointer; user-select: none;">
          <div class="color-btn" id="bg-custom-color-preview" style="background-color: #121318; width: 22px; height: 22px; border: 2px solid var(--border-glass); margin: 0; box-shadow: none;" aria-hidden="true"></div>
          <span id="bg-color-hex-label" class="color-picker-value">#121318</span>
          <span style="margin-left: auto; font-size: 0.75rem; color: var(--text-muted);" aria-hidden="true">▼</span>
        </div>

        <div id="bg-swatch-grid-panel" class="swatch-panel" style="display: none; width: 100%;">
          <div class="swatch-tabs" id="bg-swatch-tabs">
            <button type="button" class="swatch-tab active" data-tab="presets">Presets</button>
            <button type="button" class="swatch-tab" data-tab="custom">Custom</button>
          </div>
          
          <div class="tab-content" id="bg-presets-content">
            <div class="swatch-grid" id="bg-swatch-grid"></div>
          </div>
          
          <div class="tab-content" id="bg-custom-content" style="display: none;">
            <div class="picker-container">
              <div class="picker-row">
                <div class="sl-container" id="bg-sl-container">
                  <canvas class="sl-canvas" width="200" height="200"></canvas>
                  <div class="sl-marker" id="bg-sl-marker"></div>
                </div>
                <div class="hue-container" id="bg-hue-container">
                  <canvas class="hue-canvas" width="20" height="200"></canvas>
                  <div class="hue-marker" id="bg-hue-marker"></div>
                </div>
              </div>
              <div class="picker-input-row">
                <div class="hex-input-wrapper">
                  <input type="text" class="hex-text-input" id="bg-hex-input" name="bg-hex" autocomplete="off" placeholder="#121318 (e.g. #000000)…" maxlength="7" value="#121318" />
                  <div class="hex-preview-box" id="bg-hex-preview" style="background-color: #121318;" aria-hidden="true"></div>
                </div>
                <button type="button" class="eye-dropper-btn" id="bg-eyedropper-btn" title="Pick color from screen" aria-label="Pick color from screen">
                  <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 22l6-6M8.5 12.5l5 5M12.5 8.5l5 5M16 4l4 4-2.5 2.5-4-4L16 4z"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 2b: Canvas Size -->
    <div class="panel-section" id="canvas-size-section">
      <h3 class="panel-title">Canvas Size</h3>
      <div class="control-group">
        <div class="texture-grid" id="canvas-size-selector" style="grid-template-columns: repeat(4, 1fr);">
          <button class="texture-btn active" data-aspect="1:1" title="Also Instagram Post (1080×1080)">
            <span class="aspect-label">1:1</span>
            <span class="aspect-sub">Instagram Post</span>
          </button>
          <button class="texture-btn" data-aspect="4:3" title="Also Etsy Listing (2700×2025)">
            <span class="aspect-label">4:3</span>
            <span class="aspect-sub">Etsy Listing</span>
          </button>
          <button class="texture-btn" data-aspect="4:5">
            <span class="aspect-label">4:5</span>
          </button>
          <button class="texture-btn" data-aspect="9:16" title="Also Instagram Story (1080×1920)">
            <span class="aspect-label">9:16</span>
            <span class="aspect-sub">Instagram Story</span>
          </button>
        </div>
      </div>
    </div>
  </aside>

  <!-- Viewport Workspace (Center) -->
  <main class="viewport" style="flex-direction: column; gap: 12px;">
    <div class="canvas-container" id="canvas-container">
      <canvas id="editor-canvas" width="1000" height="1000"></canvas>
      <!-- Loading Overlay -->
      <div class="canvas-loading-overlay" id="canvas-loading" style="display: none;" aria-live="polite">
        <div class="spinner" aria-hidden="true"></div>
        <div class="loading-text">Processing Garment Folds…</div>
      </div>
    </div>
    <div class="canvas-hint" id="canvas-hint">Drag logo to place | Corner handles to scale | Top handle to rotate</div>
    
    <!-- Central Export Actions Panel -->
    <div class="viewport-export-panel" style="width: 100%; max-width: 600px; margin-top: 8px;">
      <div class="btn-row" style="width: 100%;">
        <button class="btn btn-primary" id="download-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download Mockup
        </button>
        <button class="btn btn-secondary" id="batch-export-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
          Batch Export
        </button>
        <button class="btn btn-secondary" id="reset-btn">Reset</button>
      </div>
    </div>
  </main>

  <!-- Right Sidebar: Adjustments & Export Actions -->
  <aside class="sidebar sidebar-right">
    <!-- Section 3: Design Graphic -->
    <div class="panel-section" id="design-graphic-section">
      <h3 class="panel-title">Design Graphic</h3>
      
      <!-- Upload Dropzone -->
      <div class="control-group">
        <div class="upload-zone" id="drop-zone" role="button" aria-label="Upload custom design" tabindex="0">
          <span class="upload-icon" aria-hidden="true">✦</span>
          <span class="upload-text">Upload Custom Design</span>
          <span class="upload-hint">Drag & drop PNG/JPG or click to browse</span>
          <input type="file" id="file-input" accept="image/*" style="display: none;" aria-label="Upload custom design file" />
        </div>
      </div>

      <!-- Sample Graphics Grid -->
      <div class="control-group">
        <label class="control-label">Or Choose a Sample Graphic</label>
        <div class="designs-grid" id="sample-designs">
          <button class="design-thumb active" data-src="/assets/designs/minimal_rose.png" aria-label="Select Minimal Rose preset">
            <img src="/assets/designs/minimal_rose.png" alt="Minimal Rose" />
          </button>
          <button class="design-thumb" data-src="/assets/designs/minimal_mountain.png" aria-label="Select Minimal Mountain preset">
            <img src="/assets/designs/minimal_mountain.png" alt="Minimal Mountain" />
          </button>
          <button class="design-thumb" data-src="/assets/designs/cat.png" aria-label="Select Retro Cat preset">
            <img src="/assets/designs/cat.png" alt="Retro Cat" />
          </button>
        </div>
      </div>
    </div>

    <!-- Section 4: Adjust Design -->
    <div class="panel-section" id="design-adjustment-panel" style="padding-bottom: 24px;">
      <h3 class="panel-title">Adjust Design</h3>

      <div class="control-group">
        <div class="control-label-row">
          <label class="control-label-text" for="scale-slider">Size</label>
          <div class="manual-input-container">
            <input type="number" id="scale-manual" class="control-manual-input" min="10" max="90" value="35" />
            <span class="manual-unit">%</span>
          </div>
        </div>
        <input type="range" id="scale-slider" min="10" max="90" value="35" />
      </div>

      <div class="control-group">
        <div class="control-label-row">
          <label class="control-label-text" for="rotate-slider">Rotation</label>
          <div class="manual-input-container">
            <input type="number" id="rotate-manual" class="control-manual-input" min="-180" max="180" value="0" />
            <span class="manual-unit">°</span>
          </div>
        </div>
        <input type="range" id="rotate-slider" min="-180" max="180" value="0" />
      </div>

      <div class="control-group">
        <div class="control-label-row">
          <label class="control-label-text" for="opacity-slider">Opacity</label>
          <div class="manual-input-container">
            <input type="number" id="opacity-manual" class="control-manual-input" min="10" max="100" value="100" />
            <span class="manual-unit">%</span>
          </div>
        </div>
        <input type="range" id="opacity-slider" min="10" max="100" value="100" />
      </div>

      <div class="control-group">
        <div class="control-label-row">
          <label class="control-label-text" for="shadow-depth-slider">Fold Shadows</label>
          <div class="manual-input-container">
            <input type="number" id="shadow-depth-manual" class="control-manual-input" min="10" max="100" value="60" />
            <span class="manual-unit">%</span>
          </div>
        </div>
        <input type="range" id="shadow-depth-slider" min="10" max="100" value="60" />
      </div>

      <div class="control-group">
        <div class="control-label-row">
          <label class="control-label-text" for="highlight-shine-slider">Fabric Shine</label>
          <div class="manual-input-container">
            <input type="number" id="highlight-shine-manual" class="control-manual-input" min="0" max="60" value="15" />
            <span class="manual-unit">%</span>
          </div>
        </div>
        <input type="range" id="highlight-shine-slider" min="0" max="60" value="15" />
      </div>
    </div>

    <!-- Section 5: Aesthetic Props -->
    <div class="panel-section" id="aesthetic-props-section">
      <h3 class="panel-title">Aesthetic Props</h3>
      <div class="control-group">
        <div class="props-grid" id="props-selector">
          <button class="prop-card" data-prop="plant" title="Dense Table Plant" aria-label="Toggle Dense Table Plant prop">
            <span class="prop-icon" aria-hidden="true">🌿</span>
            <span class="prop-name">Plant</span>
          </button>
          <button class="prop-card" data-prop="hat" title="Straw Hat" aria-label="Toggle Straw Hat prop">
            <span class="prop-icon" aria-hidden="true">👒</span>
            <span class="prop-name">Straw Hat</span>
          </button>
          <button class="prop-card" data-prop="shoes" title="Canvas Shoes" aria-label="Toggle Canvas Shoes prop">
            <span class="prop-icon" aria-hidden="true">👟</span>
            <span class="prop-name">Shoes</span>
          </button>
          <button class="prop-card" data-prop="sunglasses" title="Aviator Sunglasses" aria-label="Toggle Aviator Sunglasses prop">
            <span class="prop-icon" aria-hidden="true">🕶️</span>
            <span class="prop-name">Sunglasses</span>
          </button>
          <button class="prop-card" data-prop="jeans" title="Folded Jeans" aria-label="Toggle Folded Jeans prop">
            <span class="prop-icon" aria-hidden="true">👖</span>
            <span class="prop-name">Jeans</span>
          </button>
          <button class="prop-card" data-prop="bag" title="Woven Straw Bag" aria-label="Toggle Woven Straw Bag prop">
            <span class="prop-icon" aria-hidden="true">👜</span>
            <span class="prop-name">Straw Bag</span>
          </button>
          <button class="prop-card" data-prop="distressedshorts" title="Distressed Denim Shorts" aria-label="Toggle Distressed Denim Shorts prop">
            <span class="prop-icon" aria-hidden="true">🩳</span>
            <span class="prop-name">Denim Shorts</span>
          </button>
          <button class="prop-card" data-prop="leaf" title="Tropical Palm Leaf" aria-label="Toggle Tropical Palm Leaf prop">
            <span class="prop-icon" aria-hidden="true">🌴</span>
            <span class="prop-name">Palm Leaf</span>
          </button>
        </div>
      </div>
    </div>
  </aside>

  <!-- Download Quality Options Modal -->
  <div class="download-modal-overlay" id="download-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="download-modal-title">
    <div class="download-modal-card">
      <h3 id="download-modal-title" class="modal-title">Select Download Quality</h3>
      
      <div class="modal-options">
        <label class="modal-option-card active" id="option-high-card">
          <input type="radio" name="download-quality" value="high" checked style="display: none;" />
          <div class="option-details">
            <span class="option-label">High Quality</span>
            <span class="option-sub">lower file size - 1000x1000px</span>
          </div>
          <span class="radio-indicator"></span>
        </label>
        
        <label class="modal-option-card" id="option-extra-high-card">
          <input type="radio" name="download-quality" value="extra-high" style="display: none;" />
          <div class="option-details">
            <span class="option-label">Extra High Quality</span>
            <span class="option-sub">higher file size - 2000x2000px</span>
          </div>
          <span class="radio-indicator"></span>
        </label>
      </div>
      
      <div class="modal-actions">
        <button class="btn btn-secondary" id="modal-cancel-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          Cancel
        </button>
        <button class="btn btn-primary" id="modal-download-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download
        </button>
      </div>
    </div>
  </div>

  <!-- Batch Export Modal -->
  <div class="download-modal-overlay" id="batch-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="batch-modal-title">
    <div class="download-modal-card batch-modal-card">
      <h3 id="batch-modal-title" class="modal-title">Batch Export</h3>

      <div class="batch-tabs" role="tablist">
        <button type="button" class="batch-tab active" id="batch-tab-variants" role="tab" aria-selected="true">One design &rarr; variants</button>
        <button type="button" class="batch-tab" id="batch-tab-designs" role="tab" aria-selected="false">Many designs &rarr; this template</button>
      </div>

      <!-- Tab 1: one design, selected garments × colors -->
      <div class="batch-tab-panel" id="batch-panel-variants">
        <div class="batch-section">
          <span class="batch-section-label">Garments</span>
          <div class="batch-garment-grid" id="batch-garments"></div>
        </div>
        <div class="batch-section">
          <span class="batch-section-label">Fabric colors <span class="batch-hint">(from the preset palette; current custom color is always included if active)</span></span>
          <div class="batch-color-grid" id="batch-colors"></div>
        </div>
        <div class="batch-section">
          <span class="batch-section-label">Placement</span>
          <label class="batch-radio"><input type="radio" name="batch-placement" value="keep" checked /> Keep my placement <span class="batch-hint">(mapped onto each garment&rsquo;s print area)</span></label>
          <label class="batch-radio"><input type="radio" name="batch-placement" value="center-chest" /> Snap to Center Chest <span class="batch-hint">(11&Prime; standard, sized per garment)</span></label>
        </div>
      </div>

      <!-- Tab 2: many designs, current garment + color -->
      <div class="batch-tab-panel" id="batch-panel-designs" style="display: none;">
        <p class="batch-template-summary" id="batch-template-summary"></p>
        <div class="upload-zone batch-upload-zone" id="batch-drop-zone" role="button" tabindex="0" aria-label="Upload designs for batch export">
          <span class="upload-icon" aria-hidden="true">&#10022;</span>
