      <div class="batch-section batch-quality-row">
        <span class="batch-section-label">Quality</span>
        <label class="batch-radio"><input type="radio" name="batch-quality" value="1000" checked /> <span id="batch-quality-label-1000">1000&times;1000</span></label>
        <label class="batch-radio"><input type="radio" name="batch-quality" value="2000" /> <span id="batch-quality-label-2000">2000&times;2000</span></label>
      </div>

      <p class="batch-estimate" id="batch-estimate" aria-live="polite"></p>

      <div class="batch-progress" id="batch-progress" style="display: none;">
        <div class="batch-progress-track"><div class="batch-progress-fill" id="batch-progress-fill"></div></div>
        <span class="batch-progress-label" id="batch-progress-label"></span>
      </div>

      <div class="modal-actions">
        <button class="btn btn-secondary" id="batch-cancel-btn">Cancel</button>
        <button class="btn btn-primary" id="batch-start-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Export ZIP
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Client-side script handling all interactivity and Canvas operations -->
<script>
  // Full-spectrum HSV Custom Color Picker helper class
  class CustomColorPicker {
    constructor({
      slContainer,
      slCanvas,
      slMarker,
      hueContainer,
      hueCanvas,
      hueMarker,
      hexInput,
      hexPreview,
      eyedropperBtn,
      initialColor,
      onChange
    }) {
      this.slContainer = slContainer;
      this.slCanvas = slCanvas;
      this.slMarker = slMarker;
      this.hueContainer = hueContainer;
      this.hueCanvas = hueCanvas;
      this.hueMarker = hueMarker;
      this.hexInput = hexInput;
      this.hexPreview = hexPreview;
      this.eyedropperBtn = eyedropperBtn;
      this.onChange = onChange;

      this.h = 0; // 0-360
      this.s = 0; // 0-100
      this.v = 100; // 0-100

      this.isDraggingSl = false;
      this.isDraggingHue = false;

      this.init();
      this.setColor(initialColor, false);
    }

    init() {
      // 1. Draw static Hue gradient on the hue canvas
      this.drawHueGradient();

      // 2. Attach event listeners for SL canvas
      const handleSlStart = (e) => {
        this.isDraggingSl = true;
        this.handleSlMove(e);
      };
      this.slCanvas.addEventListener('mousedown', handleSlStart);
      this.slCanvas.addEventListener('touchstart', handleSlStart, { passive: false });

      // 3. Attach event listeners for Hue canvas
      const handleHueStart = (e) => {
        this.isDraggingHue = true;
        this.handleHueMove(e);
      };
      this.hueCanvas.addEventListener('mousedown', handleHueStart);
      this.hueCanvas.addEventListener('touchstart', handleHueStart, { passive: false });

      // Global move and up handlers
      window.addEventListener('mousemove', (e) => {
        if (this.isDraggingSl) this.handleSlMove(e);
        if (this.isDraggingHue) this.handleHueMove(e);
      });
      window.addEventListener('touchmove', (e) => {
        if (this.isDraggingSl) this.handleSlMove(e);
        if (this.isDraggingHue) this.handleHueMove(e);
      }, { passive: false });

      window.addEventListener('mouseup', () => {
        this.isDraggingSl = false;
        this.isDraggingHue = false;
      });
      window.addEventListener('touchend', () => {
        this.isDraggingSl = false;
        this.isDraggingHue = false;
      });

      // 4. Hex input typing handler
      this.hexInput.addEventListener('input', (e) => {
        let value = e.target.value;
        if (value && !value.startsWith('#')) {
          value = '#' + value;
        }
        value = value.replace(/[^#0-9A-Fa-f]/g, '');
        e.target.value = value.toUpperCase();

        if (value.length === 7 || value.length === 4) {
          this.setColor(value, true);
        }
      });

      this.hexInput.addEventListener('blur', () => {
        this.hexInput.value = this.getHex().toUpperCase();
      });

      // 5. Eyedropper integration
      if (window.EyeDropper) {
        this.eyedropperBtn.addEventListener('click', async (e) => {
          e.stopPropagation();
          try {
            const eyeDropper = new window.EyeDropper();
            const result = await eyeDropper.open();
            this.setColor(result.sRGBHex, true);
          } catch (err) {
            console.warn('Eyedropper canceled or failed:', err);
          }
        });
      } else {
        this.eyedropperBtn.style.display = 'none';
      }
    }

    drawHueGradient() {
      const ctx = this.hueCanvas.getContext('2d');
      const w = this.hueCanvas.width;
      const h = this.hueCanvas.height;
      ctx.clearRect(0, 0, w, h);

      const grad = ctx.createLinearGradient(0, 0, 0, h);
      grad.addColorStop(0, '#ff0000');
      grad.addColorStop(0.17, '#ffff00');
      grad.addColorStop(0.33, '#00ff00');
      grad.addColorStop(0.5, '#00ffff');
      grad.addColorStop(0.67, '#0000ff');
      grad.addColorStop(0.83, '#ff00ff');
      grad.addColorStop(1, '#ff0000');

      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, w, h);
    }

    drawSlGradient() {
      const ctx = this.slCanvas.getContext('2d');
      const w = this.slCanvas.width;
      const h = this.slCanvas.height;
      ctx.clearRect(0, 0, w, h);

      ctx.fillStyle = `hsl(${this.h}, 100%, 50%)`;
      ctx.fillRect(0, 0, w, h);

      const whiteGrad = ctx.createLinearGradient(0, 0, w, 0);
      whiteGrad.addColorStop(0, 'rgba(255, 255, 255, 1)');
      whiteGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
      ctx.fillStyle = whiteGrad;
      ctx.fillRect(0, 0, w, h);

      const blackGrad = ctx.createLinearGradient(0, h, 0, 0);
      blackGrad.addColorStop(0, 'rgba(0, 0, 0, 1)');
      blackGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
      ctx.fillStyle = blackGrad;
      ctx.fillRect(0, 0, w, h);
    }

    handleSlMove(e) {
      if (e.cancelable) e.preventDefault();
      const rect = this.slCanvas.getBoundingClientRect();
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;

      let x = clientX - rect.left;
      let y = clientY - rect.top;

      x = Math.max(0, Math.min(rect.width, x));
      y = Math.max(0, Math.min(rect.height, y));

      this.s = Math.round((x / rect.width) * 100);
      this.v = Math.round((1 - y / rect.height) * 100);

      this.updateMarkerPositions();
      this.updateInputs(true);
    }

    handleHueMove(e) {
      if (e.cancelable) e.preventDefault();
      const rect = this.hueCanvas.getBoundingClientRect();
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;

      let y = clientY - rect.top;
      y = Math.max(0, Math.min(rect.height, y));

      this.h = Math.round((y / rect.height) * 360);
      if (this.h >= 360) this.h = 359;

      this.drawSlGradient();
      this.updateMarkerPositions();
      this.updateInputs(true);
    }

    setColor(colorHex, triggerCallback = true) {
      const hsv = this.hexToHsv(colorHex);
      this.h = hsv.h;
      this.s = hsv.s;
      this.v = hsv.v;

      this.drawSlGradient();
      this.updateMarkerPositions();
      this.updateInputs(triggerCallback, colorHex);
    }

    updateMarkerPositions() {
      const slRect = this.slCanvas.getBoundingClientRect();
      const x = (this.s / 100) * (slRect.width || 200);
      const y = (1 - this.v / 100) * (slRect.height || 200);
      this.slMarker.style.left = `${x}px`;
      this.slMarker.style.top = `${y}px`;

      const hueRect = this.hueCanvas.getBoundingClientRect();
      const hy = (this.h / 360) * (hueRect.height || 200);
      this.hueMarker.style.top = `${hy}px`;
    }

    updateInputs(triggerCallback = true, hexVal = null) {
      const hex = hexVal || this.getHex();
      if (document.activeElement !== this.hexInput) {
        this.hexInput.value = hex.toUpperCase();
      }
      this.hexPreview.style.backgroundColor = hex;

      if (triggerCallback && this.onChange) {
        this.onChange(hex);
      }
    }

    getHex() {
      return this.hsvToHex(this.h, this.s, this.v);
    }

    hexToHsv(hex) {
      hex = hex.replace(/^#/, '');
      if (hex.length === 3) {
        hex = hex[0]+hex[0] + hex[1]+hex[1] + hex[2]+hex[2];
      }
      if (!/^[0-9A-Fa-f]{6}$/.test(hex)) {
        return { h: 0, s: 0, v: 100 };
      }

      let r = parseInt(hex.substring(0, 2), 16) / 255;
      let g = parseInt(hex.substring(2, 4), 16) / 255;
      let b = parseInt(hex.substring(4, 6), 16) / 255;

      let max = Math.max(r, g, b), min = Math.min(r, g, b);
      let h, s, v = max;

      let d = max - min;
      s = max === 0 ? 0 : d / max;

      if (max === min) {
        h = 0;
      } else {
        switch (max) {
          case r: h = (g - b) / d + (g < b ? 6 : 0); break;
          case g: h = (b - r) / d + 2; break;
          case b: h = (r - g) / d + 4; break;
        }
        h /= 6;
      }
      return { h: Math.round(h * 360), s: Math.round(s * 100), v: Math.round(v * 100) };
    }

    hsvToHex(h, s, v) {
      s /= 100;
      v /= 100;
      let c = v * s;
      let x = c * (1 - Math.abs((h / 60) % 2 - 1));
      let m = v - c;
      let r = 0, g = 0, b = 0;

      if (h >= 0 && h < 60) {
        r = c; g = x; b = 0;
      } else if (h >= 60 && h < 120) {
        r = x; g = c; b = 0;
      } else if (h >= 120 && h < 180) {
        r = 0; g = c; b = x;
      } else if (h >= 180 && h < 240) {
        r = 0; g = x; b = c;
      } else if (h >= 240 && h < 300) {
        r = x; g = 0; b = c;
      } else if (h >= 300 && h < 360) {
        r = c; g = 0; b = x;
      }

      let rHex = Math.round((r + m) * 255).toString(16).padStart(2, '0');
      let gHex = Math.round((g + m) * 255).toString(16).padStart(2, '0');
      let bHex = Math.round((b + m) * 255).toString(16).padStart(2, '0');

      return `#${rHex}${gHex}${bHex}`;
    }
  }

  // Wait until DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    // ----------------------------------------------------
    // 1. Elements Cache
    // ----------------------------------------------------
    const canvas = document.getElementById('editor-canvas');
    const ctx = canvas.getContext('2d');
    const container = document.getElementById('canvas-container');
    const dropZone = document.getElementById('drop-zone');
    const fileInput = document.getElementById('file-input');
    const presetColors = document.getElementById('preset-colors');
    const customColorToggle = document.getElementById('custom-color-toggle');
    const customColorPreview = document.getElementById('custom-color-preview');
    const colorHexLabel = document.getElementById('color-hex-label');
    const swatchGridPanel = document.getElementById('swatch-grid-panel');
    const swatchGrid = document.getElementById('swatch-grid');
    const bgSelector = document.getElementById('bg-selector');
    const canvasSizeSelector = document.getElementById('canvas-size-selector');
    const bgColorPickerContainer = document.getElementById('bg-color-picker-container');
    const bgCustomColorToggle = document.getElementById('bg-custom-color-toggle');
    const bgCustomColorPreview = document.getElementById('bg-custom-color-preview');
    const bgColorHexLabel = document.getElementById('bg-color-hex-label');
    const bgSwatchGridPanel = document.getElementById('bg-swatch-grid-panel');
    const bgSwatchGrid = document.getElementById('bg-swatch-grid');
    const sampleDesigns = document.getElementById('sample-designs');
    const scaleSlider = document.getElementById('scale-slider');
    const scaleManual = document.getElementById('scale-manual');
    const rotateSlider = document.getElementById('rotate-slider');
    const rotateManual = document.getElementById('rotate-manual');
    const opacitySlider = document.getElementById('opacity-slider');
    const opacityManual = document.getElementById('opacity-manual');
    const shadowDepthSlider = document.getElementById('shadow-depth-slider');
    const shadowDepthManual = document.getElementById('shadow-depth-manual');
    const highlightShineSlider = document.getElementById('highlight-shine-slider');
    const highlightShineManual = document.getElementById('highlight-shine-manual');
    const downloadBtn = document.getElementById('download-btn');
    const resetBtn = document.getElementById('reset-btn');
    const canvasHint = document.getElementById('canvas-hint');
    const garmentSelector = document.getElementById('garment-selector');
    const canvasLoading = document.getElementById('canvas-loading');

    // Owner self-exclusion: visiting /editor?notrack=1 flags this browser so
    // its exports never count in GA4 or the first-party stats (?notrack=0
    // clears the flag). Persisted in localStorage per browser profile.
    const NOTRACK_KEY = 'teemockup_notrack';
    let statsOptedOut = false;
    try {
      const notrackParam = new URLSearchParams(window.location.search).get('notrack');
      if (notrackParam === '1') localStorage.setItem(NOTRACK_KEY, '1');
      if (notrackParam === '0') localStorage.removeItem(NOTRACK_KEY);
      statsOptedOut = localStorage.getItem(NOTRACK_KEY) === '1';
      if (notrackParam !== null || statsOptedOut) {
        console.info('[TeeMockup] export tracking is ' + (statsOptedOut ? 'OFF' : 'ON') + ' for this browser');
      }
    } catch (e) { /* private mode without storage: default to tracking on */ }

    // Export tracking — GA4 plus a first-party beacon to /api/track (counted
    // even when ad-blockers stop GA). Only ever sends metadata (garment type,
    // counts, quality), never design content. Must never break the editor.
    function trackEvent(name, params) {
      if (statsOptedOut) return;
      params = params || {};
      try {
        if (typeof window.gtag === 'function') {
          window.gtag('event', name, params);
        }
      } catch (e) { /* no-op */ }
      try {
        const beacon = JSON.stringify({
          event: name,
          garment: params.garment || '',
          mode: params.mode || '',
          quality: params.quality || '',
          images: params.images || 0,
        });
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/track', beacon);
        } else {
          fetch('/api/track', { method: 'POST', body: beacon, keepalive: true }).catch(() => {});
        }
      } catch (e) { /* no-op */ }
    }

    // ----------------------------------------------------
    // 2. Editor State & Presets Configuration
    // ----------------------------------------------------
    // printArea: printable rect in the 1000×1000 asset frame, calibrated with
    // scratch/calibrate_print_areas.cjs (clears collars, the polo placket, the
    // hoodie hood, and the hoodie/sweatshirt kangaroo pockets).
    // pxPerIn: pixels per real-world inch, from torso width ÷ chest width of a
    // standard size M — lets placements be expressed in inches per garment.
    const garmentConfigs = {
      'crewneck': { chestY: 420, centerY: 480, bellyY: 570, defaultScale: 0.35, path: '/assets/processed/tshirt_flatlay.png', yFlat: 230, label: 'Crewneck Tee', printArea: { x: 310, y: 265, w: 384, h: 365 }, pxPerIn: 25.5 },
      'ladies': { chestY: 380, centerY: 460, bellyY: 540, defaultScale: 0.33, path: '/assets/processed/tshirt_ladies.png', yFlat: 225, label: 'Ladies Tee', printArea: { x: 302, y: 225, w: 396, h: 375 }, pxPerIn: 30.8 },
      'polo': { chestY: 430, centerY: 500, bellyY: 580, defaultScale: 0.32, path: '/assets/processed/tshirt_polo.png', yFlat: 225, label: 'Polo Shirt', printArea: { x: 306, y: 400, w: 402, h: 245 }, pxPerIn: 25.3 },
      'longsleeve': { chestY: 420, centerY: 490, bellyY: 580, defaultScale: 0.33, path: '/assets/processed/tshirt_longsleeve.png', yFlat: 230, label: 'Long Sleeve', printArea: { x: 327, y: 265, w: 353, h: 375 }, pxPerIn: 23.3 },
      'hoodie': { chestY: 440, centerY: 510, bellyY: 600, defaultScale: 0.30, path: '/assets/processed/tshirt_hoodie.png', yFlat: 230, label: 'Hoodie', printArea: { x: 346, y: 340, w: 312, h: 310 }, pxPerIn: 18.7 },
      'sweatshirt': { chestY: 410, centerY: 480, bellyY: 570, defaultScale: 0.33, path: '/assets/processed/tshirt_sweatshirt.png', yFlat: 235, label: 'Sweatshirt', printArea: { x: 333, y: 265, w: 334, h: 305 }, pxPerIn: 20.0 },
      'vneck': { chestY: 430, centerY: 500, bellyY: 580, defaultScale: 0.35, path: '/assets/processed/tshirt_vneck.png', yFlat: 225, label: 'V-Neck Tee', printArea: { x: 296, y: 270, w: 409, h: 370 }, pxPerIn: 26.9 },
      'tanktop': { chestY: 380, centerY: 460, bellyY: 550, defaultScale: 0.35, path: '/assets/processed/tshirt_tanktop.png', yFlat: 235, label: 'Tank Top', printArea: { x: 310, y: 330, w: 380, h: 310 }, pxPerIn: 33.5 }
    };

    const propConfigs = {
      'plant': { path: '/assets/props/prop_plant.png', x: 40, y: 40, w: 200, h: 200, rotation: 0, loaded: false, img: null },
      'hat': { path: '/assets/props/prop_hat.png', x: 610, y: 100, w: 330, h: 330, rotation: 0, loaded: false, img: null },
      'shoes': { path: '/assets/props/prop_shoes.png', x: 50, y: 600, w: 330, h: 330, rotation: 0, loaded: false, img: null },
      'sunglasses': { path: '/assets/props/prop_sunglasses.png', x: 740, y: 400, w: 180, h: 72, rotation: 0, loaded: false, img: null },
      'jeans': { path: '/assets/props/prop_jeans.png', x: 630, y: 520, w: 300, h: 375, rotation: 0, loaded: false, img: null },
      'bag': { path: '/assets/props/prop_bag.png', x: 255, y: 6, w: 500, h: 256, rotation: 0, loaded: false, img: null },
      'distressedshorts': { path: '/assets/props/prop_shorts_distressed.png', x: 250, y: 247, w: 520, h: 412, rotation: 0, loaded: false, img: null },
      'leaf': { path: '/assets/props/prop_leaf.png', x: 610, y: 0, w: 380, h: 380, rotation: 0, loaded: false, img: null }
    };

    let activeProps = {
      'plant': false,
      'hat': false,
      'shoes': false,
      'sunglasses': false,
      'jeans': false,
      'bag': false,
      'distressedshorts': false,
      'leaf': false
    };

    let draggedPropType = null;
    let hoveredPropType = null;

    // Selection & Resize State for Design and Props
    let selectedElement = 'design'; // 'design', 'plant', 'hat', etc., or null
    let isScalingProp = false;
    let isRotatingProp = false;
    let startPropWidth = 0;
    let startPropHeight = 0;
    let startPropAspect = 1.0;

    let activeGarmentType = 'crewneck';
    let shirtColor = '#212121';
    let designImage = null;
    let designSrc = '/assets/designs/minimal_rose.png';
    let isDesignTransparent = false; // flag to skip keying if upload is pre-transparent
    
    // Design Transformation State
    let designPos = { x: 500, y: 420 }; // default positioned over chest area of crewneck
    let designScale = 0.35; // size multiplier relative to canvas
    let designRotation = 0; // in radians
    let designOpacity = 1.0;
    let useRealisticBlending = true;
    let shadowDepth = 0.60;
    let highlightShine = 0.15;
    let activeBgType = 'wood-white'; // solid-picker, transparent, wood-white, wood-brown
    let customBgColor = '#121318';
    let userHasManuallyScaled = false; // tracks if user manually adjusted design scale

    // Canvas aspect ratio — the garment/design/prop composition always lives in a
    // fixed 1000x1000 "artboard"; changing aspect only changes how much extra
    // background canvas surrounds that centered square (letterbox-style), so none
    // of the existing 0-1000 interaction/positioning math needs to change.
    // Plain ratios use whatever export scale the download/batch quality picker
    // specifies. Named platform presets carry an exact target resolution
    // (exportShort = pixels on the shorter frame side) — that resolution is
    // fixed by the platform, so it overrides the quality picker at export time.
    const CANVAS_ASPECTS = {
      '1:1': { w: 1, h: 1, exportShort: 1080 }, // also Instagram Post
      '4:3': { w: 4, h: 3, exportShort: 2025, shirtZoom: 1.12 }, // also Etsy Listing (2700x2025)
      '4:5': { w: 4, h: 5 },
      '9:16': { w: 9, h: 16, exportShort: 1080, shirtZoom: 1.12 } // also Instagram Story (1080x1920)
    };
    let canvasAspect = '1:1';

    // Slight zoom some presets (Etsy, Instagram Story) apply so the garment
    // doesn't look small against the extra letterboxed space — shared by
    // rendering (drawScene) and interaction (render/getCanvasCoords) so
    // on-screen handles always line up with what's actually drawn.
    function getShirtZoom() {
      return CANVAS_ASPECTS[canvasAspect].shirtZoom || 1;
    }

    // Resolves the actual export scale for the current canvasAspect: platform
    // presets always export at their exact fixed resolution; plain ratios use
    // whatever scale the quality picker (1x / 2x) chose.
    function getExportScaleFactor(qualityScaleFactor) {
      const preset = CANVAS_ASPECTS[canvasAspect];
      return preset.exportShort ? preset.exportShort / 1000 : qualityScaleFactor;
    }

    // Returns the full render frame size for a given export scale (1 = on-screen
    // 1000px artboard, 2 = 2x export, etc.), plus the offset to center the square
    // artboard within it.
    function getFrameDims(scale) {
      const artboardSize = 1000 * scale;
      const ratio = CANVAS_ASPECTS[canvasAspect];
      let frameW = artboardSize;
      let frameH = artboardSize;
      if (ratio.w > ratio.h) {
        frameW = Math.round(artboardSize * (ratio.w / ratio.h));
      } else if (ratio.h > ratio.w) {
        frameH = Math.round(artboardSize * (ratio.h / ratio.w));
      }
      return {
        frameW,
        frameH,
        artboardSize,
        offsetX: (frameW - artboardSize) / 2,
        offsetY: (frameH - artboardSize) / 2
      };
    }

    // Resizes the live canvas element + its CSS box to match the selected aspect.
    function applyCanvasAspect() {
      const { frameW, frameH } = getFrameDims(1);
      canvas.width = frameW;
      canvas.height = frameH;

      // .canvas-container has explicit width/height (100% on desktop, or
      // width:100%/max-width:420px/height:auto on mobile), which makes the CSS
      // `aspect-ratio` property a no-op — it only applies when a dimension is
      // auto. So size it explicitly here instead. Clear any prior override
      // first and measure the CSS-driven natural box (this already reflects
      // the current responsive breakpoint — desktop's 600px cap or mobile's
      // 420px cap) rather than hardcoding a bound that could overflow a
      // narrower viewport.
      container.style.width = '';
      container.style.height = '';
      const naturalRect = container.getBoundingClientRect();
      const boundW = naturalRect.width;
      const boundH = naturalRect.height;

      const ratio = frameW / frameH;
      let boxW, boxH;
      if (ratio >= boundW / boundH) {
        boxW = boundW;
        boxH = boundW / ratio;
      } else {
        boxH = boundH;
        boxW = boundH * ratio;
      }
      container.style.width = `${boxW}px`;
      container.style.height = `${boxH}px`;
    }

    // Interaction Modes
    let isDragging = false;
    let isScaling = false;
    let isRotating = false;
    let dragStartOffset = { x: 0, y: 0 };
    let startScale = 0.35;
    let startRotation = 0;
    let startAngleOffset = 0;
    let activeScaleCorner = ''; // 'tl', 'tr', 'br', 'bl'

    // Anchored-resize state: the opposite corner from the one being dragged stays
    // pinned in place (Canva-style resize) instead of scaling around the center.
    let anchorWorld = { x: 0, y: 0 };
    let startDistFromAnchor = 0;

    // Snap-to-center guides shown while dragging, and rotation-snap increment
    let activeSnapGuide = { x: false, y: false };
    const ROTATION_SNAP_STEP = 15; // degrees
    const ROTATION_SNAP_THRESHOLD = 4; // degrees
    const CENTER_SNAP_THRESHOLD = 10; // canvas units (canvas is 1000x1000)

    // Offscreen Canvas buffers for image processing
    let processedShirtMask = null;
    let processedShirtShadows = null;
    let processedShirtHighlights = null;
    let processedDesignBuffer = null;

    // Loading State
    let isShirtLoaded = false;
    let rawShirtImage = new Image();

    // ----------------------------------------------------
    // 3. Image Pre-processing Logic
    // ----------------------------------------------------
    
    // Hot-swapping Garment Templates Helper
    function loadGarment(type) {
      const config = garmentConfigs[type];
      if (!config) return;

      activeGarmentType = type;
      isShirtLoaded = false;
      
      // Show loading spinner
      if (canvasLoading) canvasLoading.style.display = 'flex';

      rawShirtImage = new Image();
      rawShirtImage.crossOrigin = 'anonymous';
      rawShirtImage.src = config.path;
      rawShirtImage.onload = () => {
        preProcessShirt();
        isShirtLoaded = true;
        
        // Hide loading spinner
        if (canvasLoading) canvasLoading.style.display = 'none';

        // Set layout variables based on garment config (if scale was not manually adjusted)
        if (!userHasManuallyScaled) {
          designScale = config.defaultScale;
          scaleSlider.value = Math.round(designScale * 100);
          scaleManual.value = Math.round(designScale * 100);
        }

        designPos.x = 500;
        designPos.y = config.chestY; // default to chest placement

        // If design is already loaded, re-render, otherwise load it
        if (designImage) {
          render();
        } else {
          loadActiveDesign();
        }
      };
    }

    function loadProp(type) {
      const config = propConfigs[type];
      if (!config || config.loaded) return Promise.resolve();

      return new Promise((resolve) => {
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.src = config.path + '?v=' + Date.now();
        img.onload = () => {
          config.img = img;
          config.loaded = true;
          resolve();
        };
      });
    }

    // Initial load — honor ?garment= deep links from the landing pages
    const validGarments = ['crewneck', 'ladies', 'polo', 'longsleeve', 'hoodie', 'sweatshirt', 'vneck', 'tanktop'];
    let initialGarment = 'crewneck';
    try {
      const requested = new URLSearchParams(window.location.search).get('garment');
      if (requested && validGarments.includes(requested)) {
        initialGarment = requested;
      }
    } catch (e) { /* no-op: fall back to crewneck */ }

    if (initialGarment !== 'crewneck') {
      garmentSelector.querySelectorAll('.garment-card').forEach(c => c.classList.remove('active'));
      const requestedCard = garmentSelector.querySelector('[data-garment="' + initialGarment + '"]');
      if (requestedCard) requestedCard.classList.add('active');
    }
    applyCanvasAspect();
    loadGarment(initialGarment);

    // Re-fit the canvas box on viewport changes (orientation flip, browser
    // resize crossing the mobile/desktop breakpoint, etc.) since its size is
    // computed in JS rather than pure responsive CSS.
    let resizeRaf = null;
    window.addEventListener('resize', () => {
      if (resizeRaf) return;
      resizeRaf = requestAnimationFrame(() => {
        resizeRaf = null;
        applyCanvasAspect();
        render();
      });
    });

    let woodWhiteImg = null;
    let woodBrownImg = null;

    const woodWhiteRaw = new Image();
    woodWhiteRaw.crossOrigin = 'anonymous';
    woodWhiteRaw.src = '/assets/wood_white.png';
    woodWhiteRaw.onload = () => {
      woodWhiteImg = woodWhiteRaw;
      if (isShirtLoaded) render();
    };

    const woodBrownRaw = new Image();
    woodBrownRaw.crossOrigin = 'anonymous';
    woodBrownRaw.src = '/assets/wood_brown.png';
    woodBrownRaw.onload = () => {
      woodBrownImg = woodBrownRaw;
      if (isShirtLoaded) render();
    };

    // ----------------------------------------------------
    // Swatch Color Grid Data Generation (120 colors)
    // ----------------------------------------------------
    const swatchColors = [];

    // Row 1: Grayscale (12 shades)
    const graysList = [
      '#000000', '#151515', '#2a2a2a', '#404040', '#565656', '#707070', 
      '#8c8c8c', '#a6a6a6', '#c0c0c0', '#dcdcdc', '#eeeeee', '#ffffff'
    ];
    swatchColors.push(...graysList);

    // Rows 2 to 10: Spectrum
    const hueSpectrum = [0, 20, 35, 55, 95, 130, 170, 200, 225, 265, 295, 330];
    const lightLevels = [92, 83, 72, 60, 50, 40, 30, 20, 10];
    const satLevels = [85, 90, 95, 100, 100, 95, 90, 85, 80];

    for (let r = 0; r < 9; r++) {
      const l = lightLevels[r];
      const s = satLevels[r];
      for (let c = 0; c < 12; c++) {
        const h = hueSpectrum[c];
        swatchColors.push(`hsl(${h}, ${s}%, ${l}%)`);
      }
    }

    // Helper to check if color is "light" (for checkmark contrast)
    function isColorLight(hslString, idx) {
      if (idx < 12) return idx >= 8; // light gray / white in first row
      const matches = hslString.match(/,\s*(\d+)%\)$/);
      if (matches) {
        return parseInt(matches[1]) >= 70;
      }
      return false;
    }

    // Normalized Canvas Color to Hex Helper
    function getNormalizedHex(colorVal) {
      const tempCtx = document.createElement('canvas').getContext('2d');
      tempCtx.fillStyle = colorVal;
      return tempCtx.fillStyle;
    }

    // Build grid cells programmatically
    function buildSwatchGrid(gridContainer, onSelect, activeColor) {
      gridContainer.innerHTML = '';
      swatchColors.forEach((color, idx) => {
        const cell = document.createElement('div');
        cell.className = 'swatch-cell';
        cell.style.backgroundColor = color;
        
        const isLight = isColorLight(color, idx);
        if (isLight) cell.classList.add('light-cell');

        const cellHex = getNormalizedHex(color);
        const activeHex = getNormalizedHex(activeColor);
        if (cellHex === activeHex) {
          cell.classList.add('active');
        }

        cell.addEventListener('click', (e) => {
          e.stopPropagation(); // prevent closing grid instantly
          gridContainer.querySelectorAll('.swatch-cell').forEach(c => c.classList.remove('active'));
          cell.classList.add('active');
          onSelect(color, cellHex);
        });

        gridContainer.appendChild(cell);
      });
    }

    // ----------------------------------------------------
    // Initialize Custom Color Pickers
    // ----------------------------------------------------
    const fabricColorPicker = new CustomColorPicker({
      slContainer: document.getElementById('fabric-sl-container'),
      slCanvas: document.querySelector('#fabric-sl-container .sl-canvas'),
      slMarker: document.getElementById('fabric-sl-marker'),
      hueContainer: document.getElementById('fabric-hue-container'),
      hueCanvas: document.querySelector('#fabric-hue-container .hue-canvas'),
      hueMarker: document.getElementById('fabric-hue-marker'),
      hexInput: document.getElementById('fabric-hex-input'),
      hexPreview: document.getElementById('fabric-hex-preview'),
      eyedropperBtn: document.getElementById('fabric-eyedropper-btn'),
      initialColor: shirtColor,
      onChange: (hex) => {
        shirtColor = hex;
        colorHexLabel.innerText = hex.toUpperCase();
        customColorPreview.style.backgroundColor = hex;
        presetColors.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
        
        // update preset cell highlights if matching
        swatchGrid.querySelectorAll('.swatch-cell').forEach(cell => {
          if (getNormalizedHex(cell.style.backgroundColor) === getNormalizedHex(hex)) {
            cell.classList.add('active');
          } else {
            cell.classList.remove('active');
          }
        });
        render();
      }
    });

    const bgColorPicker = new CustomColorPicker({
      slContainer: document.getElementById('bg-sl-container'),
      slCanvas: document.querySelector('#bg-sl-container .sl-canvas'),
      slMarker: document.getElementById('bg-sl-marker'),
      hueContainer: document.getElementById('bg-hue-container'),
      hueCanvas: document.querySelector('#bg-hue-container .hue-canvas'),
      hueMarker: document.getElementById('bg-hue-marker'),
      hexInput: document.getElementById('bg-hex-input'),
      hexPreview: document.getElementById('bg-hex-preview'),
      eyedropperBtn: document.getElementById('bg-eyedropper-btn'),
      initialColor: customBgColor,
      onChange: (hex) => {
        customBgColor = hex;
        bgColorHexLabel.innerText = hex.toUpperCase();
        bgCustomColorPreview.style.backgroundColor = hex;
        
        // update bg preset cell highlights if matching
        bgSwatchGrid.querySelectorAll('.swatch-cell').forEach(cell => {
          if (getNormalizedHex(cell.style.backgroundColor) === getNormalizedHex(hex)) {
            cell.classList.add('active');
          } else {
            cell.classList.remove('active');
          }
        });
        render();
      }
    });

    // Tab Switching setup helper
    function setupTabSwitching(tabContainerId, presetsContentId, customContentId, onTabShow) {
      const tabContainer = document.getElementById(tabContainerId);
      const tabs = tabContainer.querySelectorAll('.swatch-tab');
      const presetsContent = document.getElementById(presetsContentId);
      const customContent = document.getElementById(customContentId);

      tabs.forEach(tab => {
        tab.addEventListener('click', (e) => {
          e.stopPropagation();
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');

          const mode = tab.dataset.tab;
          if (mode === 'presets') {
            presetsContent.style.display = 'block';
            customContent.style.display = 'none';
          } else {
            presetsContent.style.display = 'none';
            customContent.style.display = 'block';
            if (onTabShow) onTabShow();
          }
        });
      });
    }

    setupTabSwitching('fabric-swatch-tabs', 'fabric-presets-content', 'fabric-custom-content', () => {
      fabricColorPicker.drawSlGradient();
      fabricColorPicker.updateMarkerPositions();
    });

    setupTabSwitching('bg-swatch-tabs', 'bg-presets-content', 'bg-custom-content', () => {
      bgColorPicker.drawSlGradient();
      bgColorPicker.updateMarkerPositions();
    });

    // Initialize grids
    buildSwatchGrid(swatchGrid, (color, hex) => {
      shirtColor = color;
      colorHexLabel.innerText = hex;
      customColorPreview.style.backgroundColor = hex;
      presetColors.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
      fabricColorPicker.setColor(hex, false);
      render();
    }, shirtColor);

    buildSwatchGrid(bgSwatchGrid, (color, hex) => {
      customBgColor = color;
      bgColorHexLabel.innerText = hex;
      bgCustomColorPreview.style.backgroundColor = hex;
      bgColorPicker.setColor(hex, false);
      render();
    }, customBgColor);

    // key out background and extract shadow/highlight maps using BFS border flood fill
    // Build the mask/shadow/highlight layer canvases for a garment image.
    // Pure with respect to editor state so batch export can process garments
    // other than the active one (results cached per garment type).
    function buildShirtLayers(shirtImage, yFlatBaseline) {
      const w = shirtImage.width;
      const h = shirtImage.height;

      // 1. Create canvases
      const mask = document.createElement('canvas');
      mask.width = w;
      mask.height = h;
      const maskCtx = mask.getContext('2d');
      maskCtx.drawImage(shirtImage, 0, 0);

      const shadows = document.createElement('canvas');
      shadows.width = w;
      shadows.height = h;
      const shadowCtx = shadows.getContext('2d');

      const highlights = document.createElement('canvas');
      highlights.width = w;
      highlights.height = h;
      const highlightCtx = highlights.getContext('2d');

      // 2. Read pixels
      const maskData = maskCtx.getImageData(0, 0, w, h);
      const mPixels = maskData.data;

      const shadowData = shadowCtx.createImageData(w, h);
      const sPixels = shadowData.data;

      const highlightData = highlightCtx.createImageData(w, h);
      const hPixels = highlightData.data;

      // No BFS background removal needed on the client side since the garment image is already pre-cropped and transparent!

      const Y_FLAT = yFlatBaseline || 215; // flat fabric baseline for white shirt

      // 3. Process remaining non-background pixels to build full intensity wrinkle & shine maps
      for (let idx = 0; idx < w * h; idx++) {
        const rIdx = idx * 4;
        const alpha = mPixels[rIdx + 3];

        if (alpha === 0) {
          // background
          sPixels[rIdx] = 255;
          sPixels[rIdx + 1] = 255;
          sPixels[rIdx + 2] = 255;
          sPixels[rIdx + 3] = 0;

          hPixels[rIdx] = 0;
          hPixels[rIdx + 1] = 0;
          hPixels[rIdx + 2] = 0;
          hPixels[rIdx + 3] = 0;
          continue;
        }

        const r = mPixels[rIdx];
        const g = mPixels[rIdx + 1];
        const b = mPixels[rIdx + 2];

        const Y = 0.299 * r + 0.587 * g + 0.114 * b;

        // A. Shadow (creases): values below Y_FLAT represent folds with contrast-enhancing gamma curve
        let sVal = 255;
        if (Y < Y_FLAT) {
          sVal = Math.max(0, Math.min(255, Math.round(255 * Math.pow(Y / Y_FLAT, 1.8))));
        }

        // FADE OUT SHADOWS ON SEMI-TRANSPARENT EDGES TO PREVENT JAGGED DARK OUTLINES
        if (alpha < 255) {
          const factor = alpha / 255;
          sVal = Math.round(sVal * factor + 255 * (1 - factor));
        }

        sPixels[rIdx] = sVal;
        sPixels[rIdx + 1] = sVal;
        sPixels[rIdx + 2] = sVal;
        sPixels[rIdx + 3] = alpha;

        // B. Highlights (sheen): values above Y_FLAT represent shines
        let hVal = 0;
        if (Y > Y_FLAT) {
          hVal = Math.max(0, Math.min(255, Math.round(255 * ((Y - Y_FLAT) / (255 - Y_FLAT)))));
        }
        hPixels[rIdx] = 255;
        hPixels[rIdx + 1] = 255;
        hPixels[rIdx + 2] = 255;
        hPixels[rIdx + 3] = Math.round(hVal * (alpha / 255));
      }

      // Write processed canvases
      maskCtx.putImageData(maskData, 0, 0);
      shadowCtx.putImageData(shadowData, 0, 0);
      highlightCtx.putImageData(highlightData, 0, 0);

      return { mask, shadows, highlights };
    }

    function preProcessShirt() {
      const config = garmentConfigs[activeGarmentType];
      const layers = buildShirtLayers(rawShirtImage, config ? (config.yFlat || 215) : 215);
      processedShirtMask = layers.mask;
      processedShirtShadows = layers.shadows;
      processedShirtHighlights = layers.highlights;
    }

    // Load active design graphic and apply background removal if needed
    function loadActiveDesign() {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.src = designSrc;
      img.onload = () => {
        designImage = img;
        preProcessDesign();
        render();
      };
    }

    // Removes black background from a logo using a BFS flood-fill boundary
    // detector. Pure: returns { buffer, isTransparent } without touching
    // editor state, so batch export can process any number of designs.
    function buildDesignBuffer(img) {
      const w = img.width;
      const h = img.height;

      const buffer = document.createElement('canvas');
      buffer.width = w;
      buffer.height = h;
      const dCtx = buffer.getContext('2d');
      dCtx.drawImage(img, 0, 0);

      // Check if image already has transparent pixels.
      // If it does, we skip keying to avoid corrupting professional transparent PNGs.
      const dData = dCtx.getImageData(0, 0, w, h);
      const pixels = dData.data;

      let hasTransparency = false;
      for (let i = 3; i < pixels.length; i += 4) {
        if (pixels[i] < 240) {
          hasTransparency = true;
          break;
        }
      }

      if (hasTransparency) {
        // Just keep the original design as is
        return { buffer, isTransparent: true };
      }

      // Run Flood-Fill keyer starting from borders to extract outer black background
      const visited = new Uint8Array(w * h);
      const queue = [];

      function enqueue(x, y) {
        if (x >= 0 && x < w && y >= 0 && y < h) {
          const idx = y * w + x;
          if (!visited[idx]) {
            visited[idx] = 1;
            queue.push(idx);
          }
        }
      }

      // Enqueue all boundary pixels
      for (let x = 0; x < w; x++) {
        enqueue(x, 0);
        enqueue(x, h - 1);
      }
      for (let y = 0; y < h; y++) {
        enqueue(0, y);
        enqueue(w - 1, y);
      }

      while (queue.length > 0) {
        const idx = queue.shift();
        const px = idx % w;
        const py = Math.floor(idx / w);
        const rIdx = idx * 4;
        
        const r = pixels[rIdx];
        const g = pixels[rIdx + 1];
        const b = pixels[rIdx + 2];

        // Key threshold: pixel is dark (r,g,b < 35)
        if (r < 35 && g < 35 && b < 35) {
          pixels[rIdx + 3] = 0; // Make transparent

          // Add 4-connected neighbors
          enqueue(px + 1, py);
          enqueue(px - 1, py);
          enqueue(px, py + 1);
          enqueue(px, py - 1);
        }
      }

      // Smooth transition edges of keyed image
      for (let idx = 0; idx < w * h; idx++) {
        if (visited[idx]) continue;
        
        const rIdx = idx * 4;
        const px = idx % w;
        const py = Math.floor(idx / w);
        
        // If not background, check if adjacent to transparent background
        const r = pixels[rIdx];
        const g = pixels[rIdx + 1];
        const b = pixels[rIdx + 2];
        const isDark = (r < 60 && g < 60 && b < 60);

        if (isDark) {
          let hasBgNeighbor = false;
          // check 4 directions
          const neighbors = [
            (py > 0) ? (py - 1) * w + px : -1,
            (py < h - 1) ? (py + 1) * w + px : -1,
            (px > 0) ? py * w + (px - 1) : -1,
            (px < w - 1) ? py * w + (px + 1) : -1
          ];
          
          for (let n of neighbors) {
            if (n !== -1 && visited[n]) {
              hasBgNeighbor = true;
              break;
            }
          }

          if (hasBgNeighbor) {
            // Anti-alias edge
            const brightness = 0.299 * r + 0.587 * g + 0.114 * b;
            pixels[rIdx + 3] = Math.round(255 * (brightness / 60));
          }
        }
      }

      dCtx.putImageData(dData, 0, 0);
      return { buffer, isTransparent: false };
    }

    function preProcessDesign() {
      if (!designImage) return;
      const result = buildDesignBuffer(designImage);
      processedDesignBuffer = result.buffer;
      isDesignTransparent = result.isTransparent;
    }

    // ----------------------------------------------------
    // 4. Custom Background Rendering Helpers
    // ----------------------------------------------------
    function drawBackground(ctxTarget, w, h, isExport = false) {
      switch (activeBgType) {
        case 'transparent':
          ctxTarget.clearRect(0, 0, w, h);
          break;
          
        case 'solid-picker':
          ctxTarget.fillStyle = customBgColor;
          ctxTarget.fillRect(0, 0, w, h);
          break;

        case 'wood-white':
          if (woodWhiteImg) {
            ctxTarget.drawImage(woodWhiteImg, 0, 0, w, h);
          } else {
            ctxTarget.fillStyle = '#e8e8e6';
            ctxTarget.fillRect(0, 0, w, h);
          }
          break;

        case 'wood-brown':
          if (woodBrownImg) {
            ctxTarget.drawImage(woodBrownImg, 0, 0, w, h);
          } else {
            ctxTarget.fillStyle = '#563e2a';
            ctxTarget.fillRect(0, 0, w, h);
          }
          break;

        default:
          ctxTarget.fillStyle = customBgColor;
          ctxTarget.fillRect(0, 0, w, h);
          break;
      }
    }

    function drawProps(ctxTarget, scale = 1) {
      Object.keys(activeProps).forEach(type => {
        if (activeProps[type]) {
          const config = propConfigs[type];
          if (config.loaded && config.img) {
            ctxTarget.save();
            
            // Translate to center of prop in scaled space
            const cx = (config.x + config.w / 2) * scale;
            const cy = (config.y + config.h / 2) * scale;
            ctxTarget.translate(cx, cy);
            
            // Rotate
            const rot = config.rotation || 0;
            ctxTarget.rotate(rot);
            
            // Fixed screen shadow offset (down & right) — soft contact shadow, not a hard drop shadow
            const cos = Math.cos(rot);
            const sin = Math.sin(rot);
            const shadowX = 3 * cos + 5 * sin;
            const shadowY = 5 * cos - 3 * sin;

            ctxTarget.shadowColor = 'rgba(0, 0, 0, 0.25)';
            ctxTarget.shadowBlur = 26 * scale;
            ctxTarget.shadowOffsetX = shadowX * scale;
            ctxTarget.shadowOffsetY = shadowY * scale;
            
            // Draw image centered at origin
            ctxTarget.drawImage(
              config.img, 
              -config.w / 2 * scale, 
              -config.h / 2 * scale, 
              config.w * scale, 
              config.h * scale
            );
            ctxTarget.restore();
          }
        }
      });
    }

    // ----------------------------------------------------
    // 5. Canvas Compositing & Drawing Loop
    // ----------------------------------------------------
    // Snapshot of everything drawScene needs, taken from live editor state.
    // Batch export builds its own scene objects to render garment/color/design
    // combinations without disturbing what's on screen.
    function currentScene() {
      return {
        shirtMask: processedShirtMask,
        shirtShadows: processedShirtShadows,
        shirtHighlights: processedShirtHighlights,
        shirtColor,
        designImage,
        designBuffer: processedDesignBuffer,
        isDesignTransparent,
        designPos,
        designScale,
        designRotation,
        designOpacity,
        useRealisticBlending,
        shadowDepth,
        highlightShine,
      };
    }

    function drawScene(targetCtx, w, h, scale = 1, isExport = false, scene = null) {
      const s = scene || currentScene();

      // The garment/design composition always renders into a fixed square
      // "artboard" (1000 units * scale); for non-1:1 canvas aspects the frame
      // (w,h) is larger in one dimension, so the artboard is centered within it
      // (letterboxed) rather than stretching the garment to fill the frame.
      // Some presets (Etsy/Instagram Story) also apply a slight zoom so the
      // garment doesn't look small against all the extra letterboxed space.
      const shirtZoom = getShirtZoom();
      const artboardSize = 1000 * scale;
      const zoomedArtboardSize = artboardSize * shirtZoom;
      const offsetX = (w - zoomedArtboardSize) / 2;
      const offsetY = (h - zoomedArtboardSize) / 2;

      // 1. Draw Backdrop (fills the full frame, including any letterbox margin)
      drawBackground(targetCtx, w, h, isExport);

      // 2. Render T-Shirt + Design offscreen to handle masking correctly
      const tshirtOffscreen = document.createElement('canvas');
      tshirtOffscreen.width = artboardSize;
      tshirtOffscreen.height = artboardSize;
      const offCtx = tshirtOffscreen.getContext('2d');

      // A. Draw the transparent silhouette mask
      offCtx.drawImage(s.shirtMask, 0, 0, artboardSize, artboardSize);

      // B. Mask with T-shirt base color
      offCtx.globalCompositeOperation = 'source-in';
      offCtx.fillStyle = s.shirtColor;
      offCtx.fillRect(0, 0, artboardSize, artboardSize);

      // C. Draw graphic design layer on top
      if (s.designImage) {
        offCtx.globalCompositeOperation = 'source-atop';
        offCtx.save();
        offCtx.translate(s.designPos.x * scale, s.designPos.y * scale);
        offCtx.rotate(s.designRotation);

        // Calculate graphic size
        const baseSize = 500 * scale; // base bounding size
        const dAspect = s.designImage.width / s.designImage.height;
        let dW = baseSize * s.designScale;
        let dH = baseSize * s.designScale;
        if (dAspect > 1) {
          dH = dW / dAspect;
        } else {
          dW = dH * dAspect;
        }

        offCtx.globalAlpha = s.designOpacity;

        const sourceGraphic = s.isDesignTransparent ? s.designImage : s.designBuffer;
        offCtx.drawImage(sourceGraphic, -dW / 2, -dH / 2, dW, dH);
        offCtx.restore();
      }

      // D. Apply fabric shadow and highlight overlays
      if (s.useRealisticBlending) {
        // Multiply creases on top of colored shirt + logo
        offCtx.globalCompositeOperation = 'source-atop';
        offCtx.save();
        offCtx.globalAlpha = s.shadowDepth;
        offCtx.globalCompositeOperation = 'multiply';
        offCtx.drawImage(s.shirtShadows, 0, 0, artboardSize, artboardSize);
        offCtx.restore();

        // Screen/Overlay highlights on top
        offCtx.globalCompositeOperation = 'source-atop';
        offCtx.save();
        offCtx.globalAlpha = s.highlightShine;
        offCtx.globalCompositeOperation = 'screen';
        offCtx.drawImage(s.shirtHighlights, 0, 0, artboardSize, artboardSize);
        offCtx.restore();
      }

      // E. Draw finished offscreen mockup onto main viewport canvas, centered
      targetCtx.save();
      if (activeBgType !== 'transparent') {
        targetCtx.shadowColor = 'rgba(0, 0, 0, 0.20)';
        targetCtx.shadowBlur = 32 * scale;
        targetCtx.shadowOffsetY = 16 * scale;
      }
      targetCtx.drawImage(tshirtOffscreen, offsetX, offsetY, zoomedArtboardSize, zoomedArtboardSize);
      targetCtx.restore();

      // F. Draw active aesthetic props with realistic drop shadows — same
      // offset + zoom as the shirt above, so props stay aligned to it.
      targetCtx.save();
      targetCtx.translate(offsetX, offsetY);
      targetCtx.scale(shirtZoom, shirtZoom);
      drawProps(targetCtx, scale);
      targetCtx.restore();
    }

    function render(showHandles = true) {
      if (!isShirtLoaded) return;

      const w = canvas.width;
      const h = canvas.height;

      // Draw scene at 1x scale
      drawScene(ctx, w, h, 1, false);

      // 3. Draw Editor Interactive Handles (if requested) — same offset + zoom
      // the scene above was drawn into, so handles land exactly on the artwork.
      if (showHandles) {
        const shirtZoom = getShirtZoom();
        const offsetX = (w - 1000 * shirtZoom) / 2;
        const offsetY = (h - 1000 * shirtZoom) / 2;
        ctx.save();
        ctx.translate(offsetX, offsetY);
        ctx.scale(shirtZoom, shirtZoom);
        if (designImage && selectedElement === 'design') {
          drawEditorHandles();
        }
        drawPropHandles();
        drawSnapGuides();
        ctx.restore();
      }
    }

    // Canva-style center alignment guides, shown while dragging near canvas center
    function drawSnapGuides() {
      if (!activeSnapGuide.x && !activeSnapGuide.y) return;
      ctx.save();
      ctx.strokeStyle = '#ff4d94';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([6, 5]);
      if (activeSnapGuide.x) {
        ctx.beginPath();
        ctx.moveTo(500, 0);
        ctx.lineTo(500, 1000);
        ctx.stroke();
      }
      if (activeSnapGuide.y) {
        ctx.beginPath();
        ctx.moveTo(0, 500);
        ctx.lineTo(1000, 500);
        ctx.stroke();
      }
      ctx.restore();
    }

    // Draws bounding box outline, scale corners, and rotation handle
    function drawEditorHandles() {
      const { w: dW, h: dH } = getDesignBoxSize(designScale);

      ctx.save();
      ctx.translate(designPos.x, designPos.y);
      ctx.rotate(designRotation);

      // Draw Dashed Bounding Box Outline
      ctx.strokeStyle = '#00b4e6';
      ctx.lineWidth = 2;
      ctx.setLineDash([6, 4]);
      ctx.strokeRect(-dW / 2, -dH / 2, dW, dH);

      // Draw Center Position dot
      ctx.fillStyle = '#00b4e6';
      ctx.beginPath();
      ctx.arc(0, 0, 4, 0, Math.PI*2);
      ctx.fill();

      // Draw Corner Handles (Scale)
      ctx.setLineDash([]); // solid lines
      ctx.fillStyle = '#ffffff';
      ctx.strokeStyle = '#00b4e6';
      ctx.lineWidth = 2;
      const hSize = 14; // handle size

      const corners = [
        { x: -dW / 2, y: -dH / 2 }, // Top Left
        { x: dW / 2, y: -dH / 2 },  // Top Right
        { x: dW / 2, y: dH / 2 },   // Bottom Right
        { x: -dW / 2, y: dH / 2 }   // Bottom Left
      ];

      corners.forEach(c => {
        ctx.beginPath();
        ctx.arc(c.x, c.y, hSize / 2, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();
      });

      // Draw Rotation Handle (Line upwards + Circle handle)
      const rotY = -dH / 2 - 35;
      ctx.beginPath();
      ctx.moveTo(0, -dH / 2);
      ctx.lineTo(0, rotY);
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(0, rotY, hSize/1.5, 0, Math.PI*2);
      ctx.fill();
      ctx.stroke();

      ctx.restore();
    }

    // ----------------------------------------------------
    // Shared geometry helpers for Canva-style anchored resize & angle snapping
    // ----------------------------------------------------
    const OPPOSITE_CORNER = { tl: 'br', tr: 'bl', br: 'tl', bl: 'tr' };

    function cornerLocalPoint(w, h, corner) {
      switch (corner) {
        case 'tl': return { x: -w / 2, y: -h / 2 };
        case 'tr': return { x: w / 2, y: -h / 2 };
        case 'br': return { x: w / 2, y: h / 2 };
        case 'bl': return { x: -w / 2, y: h / 2 };
      }
    }

    function rotateVec(x, y, rotation) {
      const cos = Math.cos(rotation);
      const sin = Math.sin(rotation);
      return { x: x * cos - y * sin, y: x * sin + y * cos };
    }

    // Snaps to the nearest 15° increment when close, so rotating settles
    // cleanly at 0/15/30/45/... like Canva/PowerPoint, instead of any angle.
    function snapAngleDeg(deg) {
      const nearest = Math.round(deg / ROTATION_SNAP_STEP) * ROTATION_SNAP_STEP;
      return Math.abs(deg - nearest) <= ROTATION_SNAP_THRESHOLD ? nearest : deg;
    }

    function getDesignBoxSize(scale) {
      const baseSize = 500;
      const dAspect = designImage.width / designImage.height;
      let dW = baseSize * scale;
      let dH = baseSize * scale;
      if (dAspect > 1) {
        dH = dW / dAspect;
      } else {
        dW = dH * dAspect;
      }
      return { w: dW, h: dH };
    }

    function getPropTransformMetrics(type) {
      const config = propConfigs[type];
      if (!config) return null;

      const w = config.w;
      const h = config.h;
      const rotation = config.rotation || 0;
      const centerX = config.x + w / 2;
      const centerY = config.y + h / 2;

      const cos = Math.cos(rotation);
      const sin = Math.sin(rotation);

      function localToGlobal(lx, ly) {
        return {
          x: lx * cos - ly * sin + centerX,
          y: lx * sin + ly * cos + centerY
        };
      }

      return {
        width: w,
        height: h,
        center: { x: centerX, y: centerY },
        corners: {
          tl: localToGlobal(-w / 2, -h / 2),
          tr: localToGlobal(w / 2, -h / 2),
          br: localToGlobal(w / 2, h / 2),
          bl: localToGlobal(-w / 2, h / 2)
        },
        rot: localToGlobal(0, -h / 2 - 35)
      };
    }

    function isPointInsidePropBox(type, cx, cy) {
      const config = propConfigs[type];
      if (!config) return false;
      const metrics = getPropTransformMetrics(type);
      if (!metrics) return false;

      const centerX = config.x + config.w / 2;
      const centerY = config.y + config.h / 2;
      const rotation = config.rotation || 0;

      const tx = cx - centerX;
      const ty = cy - centerY;

      const ux = tx * Math.cos(-rotation) - ty * Math.sin(-rotation);
      const uy = tx * Math.sin(-rotation) + ty * Math.cos(-rotation);

      return (
        ux >= -metrics.width / 2 &&
        ux <= metrics.width / 2 &&
        uy >= -metrics.height / 2 &&
        uy <= metrics.height / 2
      );
    }

    function checkHitProps(cx, cy) {
      const propTypes = Object.keys(activeProps);
      for (let i = propTypes.length - 1; i >= 0; i--) {
        const type = propTypes[i];
        if (activeProps[type]) {
          const config = propConfigs[type];
          if (config.loaded && config.img) {
            if (isPointInsidePropBox(type, cx, cy)) {
              return type;
            }
          }
        }
      }
      return null;
    }

    function checkHitPropHandles(type, cx, cy) {
      const metrics = getPropTransformMetrics(type);
      if (!metrics) return null;
      
      const clickRadius = 30; // hit area in canvas pixels (generous, Canva-style)
      
      // Check rotation handle
      if (Math.hypot(metrics.rot.x - cx, metrics.rot.y - cy) < clickRadius) {
        return { type: 'rotate' };
      }
      
      // Check scale corner handles
      for (const [corner, pt] of Object.entries(metrics.corners)) {
        if (Math.hypot(pt.x - cx, pt.y - cy) < clickRadius) {
          return { type: 'scale', corner: corner };
        }
      }
      return null;
    }

    function drawPropHandles() {
      // 1. Draw selection box & handles for selected prop
      if (selectedElement && selectedElement !== 'design' && activeProps[selectedElement]) {
        const config = propConfigs[selectedElement];
        if (config.loaded && config.img) {
          const metrics = getPropTransformMetrics(selectedElement);
          if (metrics) {
            ctx.save();
            ctx.translate(metrics.center.x, metrics.center.y);
            ctx.rotate(config.rotation || 0);

            // Dashed Bounding Box Outline
            ctx.strokeStyle = '#00b4e6';
            ctx.lineWidth = 2;
            ctx.setLineDash([6, 4]);
            ctx.strokeRect(-metrics.width / 2, -metrics.height / 2, metrics.width, metrics.height);

            // Draw Center Position dot
            ctx.fillStyle = '#00b4e6';
            ctx.beginPath();
            ctx.arc(0, 0, 4, 0, Math.PI*2);
            ctx.fill();

            // Draw Corner Handles (Scale)
            ctx.setLineDash([]); // solid lines
            ctx.fillStyle = '#ffffff';
            ctx.strokeStyle = '#00b4e6';
            const hSize = 12; // handle size

            const corners = [
              { x: -metrics.width / 2, y: -metrics.height / 2 },
              { x: metrics.width / 2, y: -metrics.height / 2 },
              { x: metrics.width / 2, y: metrics.height / 2 },
              { x: -metrics.width / 2, y: metrics.height / 2 }
            ];

            corners.forEach(c => {
              ctx.fillRect(c.x - hSize/2, c.y - hSize/2, hSize, hSize);
              ctx.strokeRect(c.x - hSize/2, c.y - hSize/2, hSize, hSize);
            });

            // Draw Rotation Handle (Line upwards + Circle handle)
            const rotY = -metrics.height / 2 - 35;
            ctx.beginPath();
            ctx.moveTo(0, -metrics.height / 2);
            ctx.lineTo(0, rotY);
            ctx.stroke();

            ctx.beginPath();
            ctx.arc(0, rotY, hSize/1.5, 0, Math.PI*2);
            ctx.fill();
            ctx.stroke();

            ctx.restore();
          }
        }
      }

      // 2. Draw hover outline for hovered prop (only if it's not the selected one)
      if (hoveredPropType && hoveredPropType !== selectedElement && activeProps[hoveredPropType]) {
        const config = propConfigs[hoveredPropType];
        if (config.loaded && config.img) {
          const metrics = getPropTransformMetrics(hoveredPropType);
          if (metrics) {
            ctx.save();
            ctx.translate(metrics.center.x, metrics.center.y);
            ctx.rotate(config.rotation || 0);
            ctx.strokeStyle = 'rgba(0, 180, 230, 0.5)';
            ctx.lineWidth = 1.5;
            ctx.setLineDash([4, 3]);
            ctx.strokeRect(-metrics.width / 2, -metrics.height / 2, metrics.width, metrics.height);
            ctx.restore();
          }
        }
      }

      // 3. Draw dragged prop indicator
      if (draggedPropType) {
        const config = propConfigs[draggedPropType];
        const metrics = getPropTransformMetrics(draggedPropType);
        if (metrics) {
          ctx.save();
          ctx.translate(metrics.center.x, metrics.center.y);
          ctx.rotate(config.rotation || 0);
          ctx.strokeStyle = '#008ab3';
          ctx.lineWidth = 2;
          ctx.setLineDash([6, 4]);
          ctx.strokeRect(-metrics.width / 2, -metrics.height / 2, metrics.width, metrics.height);
          ctx.restore();
        }
      }
    }

    // ----------------------------------------------------
    // 6. Interactive Click/Drag Bounding Box Math
    // ----------------------------------------------------
    
    // Calculates coordinates of handles in global canvas space
    function getTransformMetrics() {
      const { w: dW, h: dH } = getDesignBoxSize(designScale);

      const cos = Math.cos(designRotation);
      const sin = Math.sin(designRotation);

      function localToGlobal(lx, ly) {
        return {
          x: lx * cos - ly * sin + designPos.x,
          y: lx * sin + ly * cos + designPos.y
        };
      }

      return {
        width: dW,
        height: dH,
        center: designPos,
        corners: {
          tl: localToGlobal(-dW / 2, -dH / 2),
          tr: localToGlobal(dW / 2, -dH / 2),
          br: localToGlobal(dW / 2, dH / 2),
          bl: localToGlobal(-dW / 2, dH / 2)
        },
        rot: localToGlobal(0, -dH / 2 - 35)
      };
    }

    // Checks if canvas click falls inside rotated bounding box
    function isPointInsideBox(cx, cy) {
      if (!designImage) return false;
      const metrics = getTransformMetrics();
      
      // Translate to origin
      const tx = cx - designPos.x;
      const ty = cy - designPos.y;

      // Rotate point inversely to match bounding box alignment
      const ux = tx * Math.cos(-designRotation) - ty * Math.sin(-designRotation);
      const uy = tx * Math.sin(-designRotation) + ty * Math.cos(-designRotation);

      return (
        ux >= -metrics.width / 2 && 
        ux <= metrics.width / 2 && 
        uy >= -metrics.height / 2 && 
        uy <= metrics.height / 2
      );
    }

    // Checks distance to interactive handles
    function checkHitHandles(cx, cy) {
      if (!designImage) return null;
      const metrics = getTransformMetrics();
      const clickRadius = 30; // hit area in canvas pixels (generous, Canva-style)

      function getDist(p1, p2) {
        return Math.sqrt(Math.pow(p1.x - p2, 2) + Math.pow(p1.y - cy, 2));
      }

      // Check rotation handle
      if (Math.hypot(metrics.rot.x - cx, metrics.rot.y - cy) < clickRadius) {
        return { type: 'rotate' };
      }

      // Check scale corner handles
      for (const [corner, pt] of Object.entries(metrics.corners)) {
        if (Math.hypot(pt.x - cx, pt.y - cy) < clickRadius) {
          return { type: 'scale', corner: corner };
        }
      }

      // Check center body drag
      if (isPointInsideBox(cx, cy)) {
        return { type: 'drag' };
      }

      return null;
    }

    // ----------------------------------------------------
    // 7. Mouse/Touch Event Handlers
    // ----------------------------------------------------
    
    // Convert screen coordinates to canvas pixels
    function getCanvasCoords(e) {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;

      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;

      // Convert screen -> full canvas frame -> centered 0-1000 artboard space,
      // so all drag/resize/rotate math (written for a plain 1000x1000 square)
      // keeps working unchanged regardless of the selected canvas aspect ratio
      // or its shirt zoom.
      const shirtZoom = getShirtZoom();
      const offsetX = (canvas.width - 1000 * shirtZoom) / 2;
      const offsetY = (canvas.height - 1000 * shirtZoom) / 2;

      return {
        x: ((clientX - rect.left) * scaleX - offsetX) / shirtZoom,
        y: ((clientY - rect.top) * scaleY - offsetY) / shirtZoom
      };
    }

    function handleStart(coords) {
      // 1. Check if they clicked on the active selected prop's corner handles or rotation handle
      if (selectedElement && selectedElement !== 'design') {
        const hitPropHandle = checkHitPropHandles(selectedElement, coords.x, coords.y);
        if (hitPropHandle) {
          if (hitPropHandle.type === 'scale') {
            isScalingProp = true;
            activeScaleCorner = hitPropHandle.corner;
            const config = propConfigs[selectedElement];
            startPropWidth = config.w;
            startPropHeight = config.h;
            startPropAspect = config.w / config.h;

            // Pin the opposite corner in world space so resizing anchors there
            // instead of scaling around the center (matches Canva/Figma).
            const centerX = config.x + config.w / 2;
            const centerY = config.y + config.h / 2;
            const rotation = config.rotation || 0;
            const oppCorner = OPPOSITE_CORNER[activeScaleCorner];
            const anchorLocal = cornerLocalPoint(config.w, config.h, oppCorner);
            const anchorRot = rotateVec(anchorLocal.x, anchorLocal.y, rotation);
            anchorWorld = { x: centerX + anchorRot.x, y: centerY + anchorRot.y };
            startDistFromAnchor = Math.hypot(config.w, config.h);
            canvas.style.cursor = 'nwse-resize';
          } else if (hitPropHandle.type === 'rotate') {
            isRotatingProp = true;
            const config = propConfigs[selectedElement];
            startRotation = config.rotation || 0;
            const centerX = config.x + config.w / 2;
            const centerY = config.y + config.h / 2;
            startAngleOffset = Math.atan2(coords.y - centerY, coords.x - centerX);
            canvas.style.cursor = 'grabbing';
          }
          return;
        }
      }

      // 2. Check if they clicked on any active prop to select & drag it
      const hitProp = checkHitProps(coords.x, coords.y);
      if (hitProp) {
        selectedElement = hitProp;
        draggedPropType = hitProp;
        const config = propConfigs[hitProp];
        dragStartOffset.x = coords.x - config.x;
        dragStartOffset.y = coords.y - config.y;
        canvas.style.cursor = 'grabbing';
        render();
        return;
      }

      // 3. Otherwise, check if they clicked on the design handles (or the design itself)
      const hit = checkHitHandles(coords.x, coords.y);
      if (hit) {
        selectedElement = 'design';
        if (hit.type === 'drag') {
          isDragging = true;
          dragStartOffset.x = coords.x - designPos.x;
          dragStartOffset.y = coords.y - designPos.y;
          canvas.style.cursor = 'grabbing';
        } else if (hit.type === 'scale') {
          isScaling = true;
          activeScaleCorner = hit.corner;
          startScale = designScale;

          // Pin the opposite corner in world space (Canva-style anchored resize)
          const { w: dW, h: dH } = getDesignBoxSize(designScale);
          const oppCorner = OPPOSITE_CORNER[activeScaleCorner];
          const anchorLocal = cornerLocalPoint(dW, dH, oppCorner);
          const anchorRot = rotateVec(anchorLocal.x, anchorLocal.y, designRotation);
          anchorWorld = { x: designPos.x + anchorRot.x, y: designPos.y + anchorRot.y };
          startDistFromAnchor = Math.hypot(dW, dH);
          canvas.style.cursor = 'nwse-resize';
        } else if (hit.type === 'rotate') {
          isRotating = true;
          startRotation = designRotation;
          startAngleOffset = Math.atan2(coords.y - designPos.y, coords.x - designPos.x);
          canvas.style.cursor = 'grabbing';
        }
        render();
        return;
      }

      // 4. Clicked on empty canvas space -> deselect all!
      selectedElement = null;
      isDragging = false;
      isScaling = false;
      isRotating = false;
      isScalingProp = false;
      isRotatingProp = false;
      draggedPropType = null;
      render();
      canvas.style.cursor = 'default';
    }

    function handleMove(coords) {
      // 1. If scaling a selected prop — resize anchored on the opposite corner
      if (isScalingProp && selectedElement) {
        const config = propConfigs[selectedElement];
        const currentDist = Math.hypot(coords.x - anchorWorld.x, coords.y - anchorWorld.y);
        const ratio = currentDist / startDistFromAnchor;

        // Maintain aspect ratio, enforce limits (50px to 600px width)
        let newW = Math.max(50, Math.min(600, startPropWidth * ratio));
        let newH = newW / startPropAspect;

        const rotation = config.rotation || 0;
        const oppCorner = OPPOSITE_CORNER[activeScaleCorner];
        const newAnchorLocal = cornerLocalPoint(newW, newH, oppCorner);
        const newAnchorRot = rotateVec(newAnchorLocal.x, newAnchorLocal.y, rotation);
        const newCenterX = anchorWorld.x - newAnchorRot.x;
        const newCenterY = anchorWorld.y - newAnchorRot.y;

        config.x = newCenterX - newW / 2;
        config.y = newCenterY - newH / 2;
        config.w = newW;
        config.h = newH;
        render();
        return;
      }

      // 1b. If rotating a selected prop — snaps to 15° increments like Canva
      if (isRotatingProp && selectedElement) {
        const config = propConfigs[selectedElement];
        const centerX = config.x + config.w / 2;
        const centerY = config.y + config.h / 2;
        const currentAngle = Math.atan2(coords.y - centerY, coords.x - centerX);
        let angleDelta = currentAngle - startAngleOffset;
        let newRotation = startRotation + angleDelta;
        let deg = Math.round(newRotation * (180 / Math.PI));
        if (deg > 180) deg -= 360;
        if (deg < -180) deg += 360;
        config.rotation = snapAngleDeg(deg) * (Math.PI / 180);
        render();
        return;
      }

      // 2. If dragging a prop — snaps to the canvas center like Canva's alignment guides
      if (draggedPropType) {
        const config = propConfigs[draggedPropType];
        let newX = Math.max(-config.w / 2, Math.min(1000 - config.w / 2, coords.x - dragStartOffset.x));
        let newY = Math.max(-config.h / 2, Math.min(1000 - config.h / 2, coords.y - dragStartOffset.y));

        activeSnapGuide.x = Math.abs(newX + config.w / 2 - 500) < CENTER_SNAP_THRESHOLD;
        if (activeSnapGuide.x) newX = 500 - config.w / 2;
        activeSnapGuide.y = Math.abs(newY + config.h / 2 - 500) < CENTER_SNAP_THRESHOLD;
        if (activeSnapGuide.y) newY = 500 - config.h / 2;

        config.x = newX;
        config.y = newY;
        render();
        return;
      }

      // 3. Update cursor style & handle hover states if no drag/scale is active
      if (!isDragging && !isScaling && !isRotating && !draggedPropType && !isScalingProp && !isRotatingProp) {
        // First check if hovering over selected prop's corner handles or rotation handle
        if (selectedElement && selectedElement !== 'design') {
          const hitPropHandle = checkHitPropHandles(selectedElement, coords.x, coords.y);
          if (hitPropHandle) {
            if (hitPropHandle.type === 'scale') {
              canvas.style.cursor = 'nwse-resize';
            } else if (hitPropHandle.type === 'rotate') {
              canvas.style.cursor = 'alias';
            }
            return;
          }
        }

        // Then check if hovering over any prop body
        const hitProp = checkHitProps(coords.x, coords.y);
        if (hitProp) {
          hoveredPropType = hitProp;
          canvas.style.cursor = 'grab';
          render();
          return;
        } else if (hoveredPropType) {
          hoveredPropType = null;
          canvas.style.cursor = 'default';
          render();
        }

        // Then check if hovering over design handles
        const hit = checkHitHandles(coords.x, coords.y);
        if (hit) {
          if (hit.type === 'drag') canvas.style.cursor = 'grab';
          else if (hit.type === 'scale') canvas.style.cursor = 'nwse-resize';
          else if (hit.type === 'rotate') canvas.style.cursor = 'alias';
        } else {
          canvas.style.cursor = 'default';
        }
        return;
      }

      if (!designImage) return;

      // 4. Drag logo — snaps to the canvas center like Canva's alignment guides
      if (isDragging) {
        let newX = Math.max(100, Math.min(900, coords.x - dragStartOffset.x));
        let newY = Math.max(100, Math.min(900, coords.y - dragStartOffset.y));

        activeSnapGuide.x = Math.abs(newX - 500) < CENTER_SNAP_THRESHOLD;
        if (activeSnapGuide.x) newX = 500;
        activeSnapGuide.y = Math.abs(newY - 500) < CENTER_SNAP_THRESHOLD;
        if (activeSnapGuide.y) newY = 500;

        designPos.x = newX;
        designPos.y = newY;
      }

      // 5. Scale logo — resize anchored on the opposite corner
      if (isScaling) {
        const currentDist = Math.hypot(coords.x - anchorWorld.x, coords.y - anchorWorld.y);
        let ratio = currentDist / startDistFromAnchor;
        let newScale = Math.max(0.1, Math.min(0.9, startScale * ratio));
        designScale = newScale;

        const { w: newDW, h: newDH } = getDesignBoxSize(newScale);
        const oppCorner = OPPOSITE_CORNER[activeScaleCorner];
        const newAnchorLocal = cornerLocalPoint(newDW, newDH, oppCorner);
        const newAnchorRot = rotateVec(newAnchorLocal.x, newAnchorLocal.y, designRotation);
        designPos.x = anchorWorld.x - newAnchorRot.x;
        designPos.y = anchorWorld.y - newAnchorRot.y;

        scaleSlider.value = Math.round(newScale * 100);
        scaleManual.value = Math.round(newScale * 100);
        userHasManuallyScaled = true;
      }

      // 6. Rotate logo — snaps to 15° increments like Canva
      if (isRotating) {
        const currentAngle = Math.atan2(coords.y - designPos.y, coords.x - designPos.x);
        let angleDelta = currentAngle - startAngleOffset;
        let newRotation = startRotation + angleDelta;
        let deg = Math.round(newRotation * (180 / Math.PI));
        if (deg > 180) deg -= 360;
        if (deg < -180) deg += 360;
        deg = snapAngleDeg(deg);
        designRotation = deg * (Math.PI / 180);
        rotateSlider.value = deg;
        rotateManual.value = deg;
      }

      render();
    }

