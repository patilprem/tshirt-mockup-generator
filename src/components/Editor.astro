    // Perform download at a given quality. Split out of the modal button so
    // on-model can skip the modal entirely and download straight away.
    function runDownload(quality) {
      {
        // 1. Determine canvas settings based on selection (platform presets
        // export at their fixed resolution regardless of the quality choice)
        const isExtraHigh = (quality === 'extra-high');
        const scaleFactor = getExportScaleFactor(isExtraHigh ? 2 : 1);
        let { frameW: exportWidth, frameH: exportHeight } = getFrameDims(scaleFactor);

        // On-model exports are framed by the SAME crop rect the screen canvas
        // uses, so the download is the frame the user was looking at. Sizing
        // the export from anything else is exactly the class of bug that put
        // wood panels beside the model in a download that looked fine on
        // screen.
        //
        // Resolution follows the preset, not the source. A platform preset
        // promises an exact size on its button — Etsy Listing 2700x2025 — and
        // that promise has to hold in both modes or the label is a lie in one
        // of them. Reaching it means resampling a crop of a 1600px photo up,
        // which is a real cost in sharpness and is accepted: a listing image
        // below Etsy's zoom threshold is worse than a slightly soft one.
        // Presets without a platform size have nothing to hit, so they stay at
        // native crop pixels rather than invent a resample.
        const onModelEntry = mockupStyle === 'onmodel' ? onModelCache.get(activeOnModelId) : null;
        if (onModelEntry) {
          const dims = onModelExportDims(onModelEntry, isExtraHigh);
          exportWidth = dims.w;
          exportHeight = dims.h;
        }

        // 2. Create offscreen canvas for quality export
        const exportCanvas = document.createElement('canvas');
        exportCanvas.width = exportWidth;
        exportCanvas.height = exportHeight;
        const exportCtx = exportCanvas.getContext('2d');

        // Show loading spinner during rendering
        if (canvasLoading) canvasLoading.style.display = 'flex';

        setTimeout(() => {
          // 3. Render mockup at selected scale/dimension
          if (!(onModelEntry && drawOnModelScene(exportCtx, exportWidth, exportHeight))) {
            drawScene(exportCtx, exportWidth, exportHeight, scaleFactor, true);
          }

          // 4. Extract data URL
          const imageURL = exportCanvas.toDataURL('image/png');

          // 5. Trigger download
          const downloadLink = document.createElement('a');
          downloadLink.href = imageURL;
          const colorClean = shirtColor.replace('#', '');
          downloadLink.download = `tshirt-mockup-${colorClean}-${Date.now()}.png`;
          
          document.body.appendChild(downloadLink);
          downloadLink.click();
          document.body.removeChild(downloadLink);

          // An on-model export has no garment to report: the template fixes
          // it, and activeGarmentType is only whatever flat lay was left on,
          // so sending it would file every model download under a garment
          // nobody chose. The two are reported as what they are — a garment
          // or a model — and never both.
          trackEvent('mockup_download', {
            style: onModelEntry ? 'onmodel' : 'flatlay',
            garment: onModelEntry ? '' : activeGarmentType,
            template: onModelEntry ? activeOnModelId : '',
            quality: `${exportWidth}x${exportHeight}`,
          });

          // Hide loading spinner
          if (canvasLoading) canvasLoading.style.display = 'none';
        }, 50);
      }
    }

    if (modalDownloadBtn) {
      modalDownloadBtn.addEventListener('click', () => {
        closeDownloadModal();
        const selectedRadio = downloadModal ? downloadModal.querySelector('input[name="download-quality"]:checked') : null;
        runDownload(selectedRadio ? selectedRadio.value : 'high');
      });
    }

    // ----------------------------------------------------
    // 9b. Batch Export (garment × color variants, or many designs on one template)
    // ----------------------------------------------------

    // --- Placement projection between garments -------------------------------
    // A placement is portable when expressed relative to a garment's printArea:
    // u/v = design center as a fraction of the area, size = design bounding box
    // width as a fraction of the area width.
    // --- Garment layer cache --------------------------------------------------
    // Mask/shadow/highlight extraction is the expensive per-garment step; cache
    // it so N colors of the same garment cost one preprocessing pass.
    const garmentLayerCache = new Map();

    function loadImageAsync(src) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.crossOrigin = 'anonymous';
        img.onload = () => resolve(img);
        img.onerror = () => reject(new Error('Failed to load ' + src));
        img.src = src;
      });
    }

    // Keyed by garment AND side: the two sides are different photographs with
    // different fold maps, so one cache entry per garment would hand a back
    // export the front's mask.
    async function getGarmentLayers(type, side = 'front') {
      const key = `${type}:${side}`;
      if (garmentLayerCache.has(key)) return garmentLayerCache.get(key);
      const cfg = garmentView(type, side);
      const promise = loadImageAsync(cfg.path).then((img) => buildShirtLayers(img, cfg.yFlat || 215));
      garmentLayerCache.set(key, promise);
      return promise;
    }

    // --- Batch modal elements -------------------------------------------------
    const batchBtn = document.getElementById('batch-export-btn');
    const batchModal = document.getElementById('batch-modal');
    const batchTabVariants = document.getElementById('batch-tab-variants');
    const batchTabDesigns = document.getElementById('batch-tab-designs');
    const batchPanelVariants = document.getElementById('batch-panel-variants');
    const batchPanelDesigns = document.getElementById('batch-panel-designs');
    const batchGarmentsGrid = document.getElementById('batch-garments');
    const batchColorsGrid = document.getElementById('batch-colors');
    const batchDropZone = document.getElementById('batch-drop-zone');
    const batchFileInput = document.getElementById('batch-file-input');
    const batchFileList = document.getElementById('batch-file-list');
    const batchTemplateSummary = document.getElementById('batch-template-summary');
    const batchEstimate = document.getElementById('batch-estimate');
    const batchProgress = document.getElementById('batch-progress');
    const batchProgressFill = document.getElementById('batch-progress-fill');
    const batchProgressLabel = document.getElementById('batch-progress-label');
    const batchCancelBtn = document.getElementById('batch-cancel-btn');
    const batchStartBtn = document.getElementById('batch-start-btn');

    let batchMode = 'variants'; // 'variants' | 'designs'
    let batchFiles = []; // File objects for the designs tab
    let batchRunning = false;
    let batchCancelled = false;

    function slugify(str) {
      return String(str).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'design';
    }

    // Preset palette straight from the sidebar buttons (hex + human name).
    function getPresetColorOptions() {
      const options = [];
      presetColors.querySelectorAll('.color-btn').forEach((btn) => {
        options.push({ hex: btn.dataset.color, name: btn.title || btn.dataset.color });
      });
      return options;
    }

    function buildBatchGarmentGrid() {
      batchGarmentsGrid.innerHTML = '';
      Object.entries(garmentConfigs).forEach(([type, cfg]) => {
        const label = document.createElement('label');
        label.className = 'batch-check';
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.value = type;
        input.checked = type === activeGarmentType;
        input.addEventListener('change', updateBatchEstimate);
        label.appendChild(input);
        label.appendChild(document.createTextNode(' ' + cfg.label));
        batchGarmentsGrid.appendChild(label);
      });
    }

    function buildBatchColorGrid() {
      batchColorsGrid.innerHTML = '';
      const options = getPresetColorOptions();
      const currentHex = getNormalizedHex(shirtColor);
      const inPresets = options.some((o) => getNormalizedHex(o.hex) === currentHex);
      if (!inPresets) {
        options.unshift({ hex: shirtColor, name: 'Current color' });
      }
      options.forEach((opt) => {
        const label = document.createElement('label');
        label.className = 'batch-check batch-color-check';
        label.title = opt.name;
        const input = document.createElement('input');
        input.type = 'checkbox';
        input.value = opt.hex;
        input.dataset.name = opt.name;
        input.checked = getNormalizedHex(opt.hex) === currentHex;
        input.addEventListener('change', updateBatchEstimate);
        const swatch = document.createElement('span');
        swatch.className = 'batch-swatch';
        swatch.style.backgroundColor = opt.hex;
        label.appendChild(input);
        label.appendChild(swatch);
        batchColorsGrid.appendChild(label);
      });
    }

    function getBatchQuality() {
      const checked = batchModal.querySelector('input[name="batch-quality"]:checked');
      return checked && checked.value === '2000' ? 2000 : 1000;
    }

    function countBatchJobs() {
      if (batchMode === 'designs') return batchFiles.length;
      const garments = batchGarmentsGrid.querySelectorAll('input:checked').length;
      const colors = batchColorsGrid.querySelectorAll('input:checked').length;
      return garments * colors;
    }

    function updateBatchEstimate() {
      const n = countBatchJobs();
      const perImageMb = getBatchQuality() === 2000 ? 3.2 : 1.0;
      const est = n === 0 ? '' : `${n} image${n === 1 ? '' : 's'} &middot; ~${Math.max(1, Math.round(n * perImageMb))} MB ZIP`;
      batchEstimate.innerHTML = est;
      batchStartBtn.disabled = n === 0 || (batchMode === 'variants' && !designImage);
    }

    function setBatchMode(mode) {
      batchMode = mode;
      const variants = mode === 'variants';
      batchTabVariants.classList.toggle('active', variants);
      batchTabDesigns.classList.toggle('active', !variants);
      batchTabVariants.setAttribute('aria-selected', String(variants));
      batchTabDesigns.setAttribute('aria-selected', String(!variants));
      batchPanelVariants.style.display = variants ? '' : 'none';
      batchPanelDesigns.style.display = variants ? 'none' : '';
      updateBatchEstimate();
    }

    function renderBatchFileList() {
      batchFileList.innerHTML = '';
      batchFiles.forEach((file, i) => {
        const li = document.createElement('li');
        const name = document.createElement('span');
        name.textContent = file.name;
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'batch-file-remove';
        remove.setAttribute('aria-label', 'Remove ' + file.name);
        remove.textContent = '×';
        remove.addEventListener('click', () => {
          batchFiles.splice(i, 1);
          renderBatchFileList();
          updateBatchEstimate();
        });
        li.appendChild(name);
        li.appendChild(remove);
        batchFileList.appendChild(li);
      });
    }

    function addBatchFiles(fileList) {
      const MAX_FILES = 100;
      for (const file of fileList) {
        if (!file.type.match('image.*')) continue;
        if (batchFiles.length >= MAX_FILES) break;
        batchFiles.push(file);
      }
      renderBatchFileList();
      updateBatchEstimate();
    }

    function openBatchModal() {
      buildBatchGarmentGrid();
      buildBatchColorGrid();
      const cfg = garmentConfigs[activeGarmentType];
      const sideLabel = activeSide === 'back' ? ' (back)' : '';
      batchTemplateSummary.textContent =
        `Each design is placed on your current template: ${cfg.label}${sideLabel}, current fabric color, background and design position.`;
      batchProgress.style.display = 'none';
      batchStartBtn.style.display = '';

      // Quality is a multiplier on whatever the canvas preset already decides,
      // so the labels are the fixed "1x" and "2x" in the markup — no pixel
      // dimensions to keep in sync, and nothing to recompute here. Presets
      // marked oneX drop the second option and the row with it: a lone radio
      // that cannot be unpicked is a worse way of saying "no choice here"
      // than saying nothing.
      const oneX = !!CANVAS_ASPECTS[canvasAspect].oneX;
      const quality2x = batchModal.querySelector('input[name="batch-quality"][value="2000"]');
      const quality1x = batchModal.querySelector('input[name="batch-quality"][value="1000"]');
      const qualityRow = batchModal.querySelector('.batch-quality-row');
      if (oneX && quality1x) quality1x.checked = true;
      if (qualityRow) qualityRow.style.display = oneX ? 'none' : '';
      if (quality2x) quality2x.disabled = oneX;

      updateBatchEstimate();
      batchModal.style.display = 'flex';
    }

    function closeBatchModal() {
      if (batchRunning) return;
      batchModal.style.display = 'none';
    }

    // --- Job building ---------------------------------------------------------
    function buildVariantJobs() {
      const garments = [...batchGarmentsGrid.querySelectorAll('input:checked')].map((i) => i.value);
      const colors = [...batchColorsGrid.querySelectorAll('input:checked')].map((i) => ({ hex: i.value, name: i.dataset.name }));
      const placementMode = batchModal.querySelector('input[name="batch-placement"]:checked').value;
      const rel = placementToRelative(designPos, designScale, activeGarmentType, activeSide);

      const jobs = [];
      for (const garment of garments) {
        // Batch runs the side that is on screen, over whichever of the chosen
        // garments can show it. A garment with no back asset exports its front
        // rather than being dropped from the ZIP — the user picked it, and a
        // silently missing file is worse than a front one.
        const side = activeSide === 'back' && hasBackView(garment) ? 'back' : 'front';
        const placement = placementMode === 'center-chest'
          ? centerChestPlacement(garment, side)
          : placementFromRelative(rel, garment, side);
        for (const color of colors) {
          jobs.push({
            garmentType: garment,
            side,
            color: color.hex,
            placement,
            // The side is only in the name when it is the back, so every
            // existing front filename is byte-for-byte what it was.
            fileName: `${slugify(garmentConfigs[garment].label)}${side === 'back' ? '-back' : ''}-${slugify(color.name)}.png`,
          });
        }
      }
      return jobs;
    }

    function readFileAsDataURL(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => resolve(e.target.result);
        reader.onerror = () => reject(new Error('Failed to read ' + file.name));
        reader.readAsDataURL(file);
      });
    }

    // --- Batch runner ----------------------------------------------------------
    async function runBatchExport() {
      const { default: JSZip } = await import('jszip');
      const zip = new JSZip();
      const size = getBatchQuality();
      const scaleFactor = getExportScaleFactor(size / 1000);
      const { frameW, frameH } = getFrameDims(scaleFactor);

      batchRunning = true;
      batchCancelled = false;
      batchStartBtn.style.display = 'none';
      batchProgress.style.display = '';
      batchCancelBtn.textContent = 'Stop';

      const usedNames = new Set();
      const uniqueName = (name) => {
        let candidate = name;
        let i = 2;
        while (usedNames.has(candidate)) {
          candidate = name.replace(/\.png$/, `-${i}.png`);
          i++;
        }
        usedNames.add(candidate);
        return candidate;
      };

      const renderJobToZip = async (scene, fileName) => {
        const cv = document.createElement('canvas');
        cv.width = frameW;
        cv.height = frameH;
        drawScene(cv.getContext('2d'), frameW, frameH, scaleFactor, true, scene);
        const blob = await new Promise((res) => cv.toBlob(res, 'image/png'));
        if (blob) zip.file(uniqueName(fileName), blob);
      };

      const setProgress = (done, total, label) => {
        batchProgressFill.style.width = `${Math.round((done / total) * 100)}%`;
        batchProgressLabel.textContent = label || `${done} / ${total}`;
      };

      let total = 0;
      let done = 0;
      try {
        if (batchMode === 'variants') {
          const jobs = buildVariantJobs();
          total = jobs.length;
          setProgress(0, total);
          const base = currentScene();
          for (const job of jobs) {
            if (batchCancelled) break;
            const layers = await getGarmentLayers(job.garmentType, job.side);
            await renderJobToZip({
              ...base,
              shirtMask: layers.mask,
              shirtShadows: layers.shadows,
              shirtHighlights: layers.highlights,
              shirtColor: job.color,
              designPos: job.placement.pos,
              designScale: job.placement.scale,
            }, job.fileName);
            done++;
            setProgress(done, total);
            await new Promise((r) => setTimeout(r, 0)); // keep the UI responsive
          }
        } else {
          total = batchFiles.length;
          setProgress(0, total);
          const base = currentScene();
          for (const file of batchFiles) {
            if (batchCancelled) break;
            setProgress(done, total, `${done + 1} / ${total}: ${file.name}`);
            const dataUrl = await readFileAsDataURL(file);
            const img = await loadImageAsync(dataUrl);
            const processed = buildDesignBuffer(img);
            const baseName = file.name.replace(/\.[^.]*$/, '');
            await renderJobToZip({
              ...base,
              designImage: img,
              designBuffer: processed.buffer,
              isDesignTransparent: processed.isTransparent,
            }, `${slugify(baseName)}-${slugify(garmentConfigs[activeGarmentType].label)}${activeSide === 'back' ? '-back' : ''}.png`);
            done++;
            setProgress(done, total);
            await new Promise((r) => setTimeout(r, 0));
          }
        }

        if (done > 0) {
          setProgress(done, Math.max(total, 1), 'Building ZIP…');
          const zipBlob = await zip.generateAsync({ type: 'blob' });
          const url = URL.createObjectURL(zipBlob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `teemockup-batch-${done}-mockups.zip`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(() => URL.revokeObjectURL(url), 10000);

          // Batch export is flat-lay only — its axes are garment and colour,
          // and an on-model template fixes the garment — so the style is not a
          // question here, it is a constant worth recording as one.
          trackEvent('batch_export', {
            style: 'flatlay',
            mode: batchMode,
            images: done,
            planned: total,
            quality: `${Math.round(frameW)}x${Math.round(frameH)}`,
            cancelled: batchCancelled,
          });
        }
      } catch (err) {
        console.error('Batch export failed:', err);
        batchProgressLabel.textContent = 'Export failed — please try again.';
      } finally {
        batchRunning = false;
        batchCancelBtn.textContent = 'Cancel';
        batchStartBtn.style.display = '';
        if (done > 0 && !batchCancelled) {
          batchProgress.style.display = 'none';
          closeBatchModal();
        }
      }
    }

    // --- Wiring ----------------------------------------------------------------
    if (batchBtn && batchModal) {
      batchBtn.addEventListener('click', openBatchModal);
      batchTabVariants.addEventListener('click', () => setBatchMode('variants'));
      batchTabDesigns.addEventListener('click', () => setBatchMode('designs'));

      batchCancelBtn.addEventListener('click', () => {
        if (batchRunning) {
          batchCancelled = true;
          batchProgressLabel.textContent = 'Stopping…';
        } else {
          closeBatchModal();
        }
      });
      batchModal.addEventListener('click', (e) => {
        if (e.target === batchModal) closeBatchModal();
      });

      batchModal.querySelectorAll('input[name="batch-quality"], input[name="batch-placement"]').forEach((input) => {
        input.addEventListener('change', updateBatchEstimate);
      });

      batchStartBtn.addEventListener('click', () => {
        if (!batchRunning && countBatchJobs() > 0) runBatchExport();
      });

      batchDropZone.addEventListener('click', () => batchFileInput.click());
      batchDropZone.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          batchFileInput.click();
        }
      });
      batchFileInput.addEventListener('change', (e) => {
        if (e.target.files) addBatchFiles(e.target.files);
        batchFileInput.value = '';
      });
      batchDropZone.addEventListener('dragover', (e) => {
        e.preventDefault();
        batchDropZone.classList.add('dragover');
      });
      batchDropZone.addEventListener('dragleave', () => batchDropZone.classList.remove('dragover'));
      batchDropZone.addEventListener('drop', (e) => {
        e.preventDefault();
        batchDropZone.classList.remove('dragover');
        if (e.dataTransfer && e.dataTransfer.files) addBatchFiles(e.dataTransfer.files);
      });
    }

    // ----------------------------------------------------
    // 10. Mobile Tab Switching Handler
    // ----------------------------------------------------
    // ----------------------------------------------------
    // 12. Sliders: on touch, require a horizontal drag
    // ----------------------------------------------------
    // A range input spans the full panel width, so on a phone it sits right
    // under the thumb during an ordinary scroll — and a range jumps its value
    // to wherever it was TOUCHED, on touchdown, before any gesture direction
    // is known. So a scroll that happens to start on a slider sets it to
    // whatever was under the finger, and so does a stray tap. touch-action:
    // pan-y (in the stylesheet) gives the scroll back to the page, but cannot
    // help with the value: the jump has already happened by then.
    //
    // So the value is held back until the gesture proves itself horizontal.
    // Every input event from a touch that has not yet moved sideways is
    // reverted in the capture phase and stopped before any app handler sees
    // it — no re-render, no flicker of the mockup. A real drag passes through
    // from the moment it crosses the threshold. Precise values are still
    // reachable: each slider has a paired number field.
    //
    // Touch only. A mouse keeps click-to-set, where it is precise and nobody
    // is scrolling with the pointer.
    {
      const DRAG_PX = 8;
      let gesture = null;
      document.addEventListener('touchstart', e => {
        const el = e.target.closest && e.target.closest('input[type="range"]');
        if (!el) { gesture = null; return; }
        const t = e.touches[0];
        // Read BEFORE the browser's default action moves the thumb — the
        // event is dispatched first, the jump happens after.
        gesture = { el, x: t.clientX, y: t.clientY, value: el.value, horizontal: false };
      }, true);
      document.addEventListener('touchmove', e => {
        if (!gesture || gesture.horizontal) return;
        const t = e.touches[0];
        const dx = Math.abs(t.clientX - gesture.x);
        const dy = Math.abs(t.clientY - gesture.y);
        if (dx > DRAG_PX && dx > dy) gesture.horizontal = true;
      }, true);
      document.addEventListener('input', e => {
        if (!gesture || e.target !== gesture.el || gesture.horizontal) return;
        e.target.value = gesture.value;
        e.stopImmediatePropagation();
      }, true);
      const endGesture = () => { gesture = null; };
      document.addEventListener('touchend', endGesture, true);
      document.addEventListener('touchcancel', endGesture, true);
    }

    const mobileNavBar = document.getElementById('mobile-nav-bar');
    if (mobileNavBar) {
      const mobileNavButtons = mobileNavBar.querySelectorAll('.mobile-nav-btn');
      const appContainer = document.querySelector('.app-container');
      
      mobileNavButtons.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = btn.dataset.target;
          appContainer.setAttribute('data-mobile-tab', target);
          
          mobileNavButtons.forEach(b => {
            b.classList.remove('active');
            b.setAttribute('aria-selected', 'false');
          });
          btn.classList.add('active');
          btn.setAttribute('aria-selected', 'true');
        });
      });
    }

  });
</script>
