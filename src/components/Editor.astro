        render();
      }
    });

    const bgColorPicker = new CustomColorPicker({
      slContainer: document.getElementById('bg-sl-container'),
      slCanvas: document.querySelector('#bg-sl-container .sl-canvas'),
      slMarker: document.getElementById('bg-sl-marker'),
      hueContainer: document.getElementById('bg-hue-container'),
      hueCanvas: document.querySelector('#bg-hue-container .hue-canvas'),
      hueMarker: document.getElementById('bg-hue-marker'),
      hexInput: document.getElementById('bg-hex-input'),
      hexPreview: document.getElementById('bg-hex-preview'),
      eyedropperBtn: document.getElementById('bg-eyedropper-btn'),
      initialColor: customBgColor,
      onChange: (hex) => {
        customBgColor = hex;
        bgColorHexLabel.innerText = hex.toUpperCase();
        bgCustomColorPreview.style.backgroundColor = hex;
        
        // update bg preset cell highlights if matching
        bgSwatchGrid.querySelectorAll('.swatch-cell').forEach(cell => {
          if (getNormalizedHex(cell.style.backgroundColor) === getNormalizedHex(hex)) {
            cell.classList.add('active');
