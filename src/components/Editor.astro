---
// src/components/Editor.astro
import KofiSupport from './KofiSupport.astro';
---

<div class="app-container" data-mobile-tab="design">
  <!-- Mobile Tab Navigation (Only visible on mobile) -->
  <div class="mobile-nav-bar" id="mobile-nav-bar" role="tablist" aria-label="Mobile Navigation">
    <button class="mobile-nav-btn active" data-target="design" role="tab" aria-selected="true" aria-controls="design-graphic-section design-adjustment-panel">
      <span class="nav-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/></svg></span>
      <span class="nav-text">Design</span>
    </button>
    <button class="mobile-nav-btn" data-target="garment" role="tab" aria-selected="false" aria-controls="garment-type-section shirt-color-section">
      <span class="nav-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg></span>
      <span class="nav-text">Garment</span>
    </button>
    <button class="mobile-nav-btn" data-target="background" role="tab" aria-selected="false" aria-controls="mockup-background-section canvas-size-section">
      <span class="nav-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></span>
      <span class="nav-text">Canvas</span>
    </button>
    <button class="mobile-nav-btn" data-target="props" role="tab" aria-selected="false" aria-controls="aesthetic-props-section">
      <span class="nav-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg></span>
      <span class="nav-text">Props</span>
    </button>
  </div>

  <!-- Left Sidebar Controls -->
  <aside class="sidebar sidebar-left">
    <!-- Section 00: Mockup Style — flat lay vs. photographed on a model -->
    <div class="panel-section" id="mockup-style-section">
      <h3 class="panel-title">Mockup Style</h3>
      <div class="control-group">
        <div class="style-toggle" id="mockup-style-toggle">
          <button class="style-btn active" data-style="flatlay" type="button">
            <span class="style-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg></span>
            <span class="style-name">Flat Lay</span>
          </button>
          <button class="style-btn" data-style="onmodel" type="button">
            <span class="style-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="5" r="1"/><path d="m9 20 3-6 3 6"/><path d="m6 8 6 2 6-2"/><path d="M12 10v4"/></svg></span>
            <span class="style-name">On Model</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Section 0b: On-model template picker (only shown in on-model mode) -->
    <div class="panel-section" id="on-model-section" style="display: none;">
      <h3 class="panel-title">Model &amp; Scene</h3>
      <div class="control-group">
        <div class="on-model-gallery" id="on-model-selector"></div>
      </div>
    </div>

    <!-- Section 0: Garment Type -->
    <div class="panel-section" id="garment-type-section">
      <h3 class="panel-title">Garment Type</h3>
      <div class="control-group">
        <div class="garment-grid" id="garment-selector">
          <button class="garment-card active" data-garment="crewneck" title="Classic Crewneck">
            <span class="garment-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg></span>
            <span class="garment-name">Crewneck</span>
          </button>
          <button class="garment-card" data-garment="ladies" title="Ladies Fitted Tee">
            <span class="garment-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.4 4.1C7.1 4.4 5.1 5.5 4 7.3 3.4 8.3 3.7 9.3 4.8 9.8 5.6 10.2 6.4 10 6.9 9.4L6.9 12.5C6.2 14.3 6.2 16.2 6.9 18L6.9 18.6C6.9 19.4 7.5 20.1 8.3 20.1H15.7C16.5 20.1 17.1 19.4 17.1 18.6L17.1 18C17.8 16.2 17.8 14.3 17.1 12.5L17.1 9.4C17.6 10 18.4 10.2 19.2 9.8 20.3 9.3 20.6 8.3 20 7.3 18.9 5.5 16.9 4.4 14.6 4.1Q12 7.8 9.4 4.1Z"/></svg></span>
            <span class="nav-name" style="font-size: 0.75rem; white-space: nowrap;">Ladies Tee</span>
          </button>
          <button class="garment-card" data-garment="polo" title="Polo Collar Tee">
            <span class="garment-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M5.64682 12.2492L2.51794 11.519C2.42922 11.4978 2.34572 11.4589 2.27247 11.4046C2.19923 11.3503 2.13778 11.2816 2.09183 11.2028C2.04587 11.1241 2.01639 11.0368 2.00514 10.9463C1.9939 10.8558 2.00114 10.764 2.02642 10.6763L3.75938 4.83425C3.80108 4.67366 3.90124 4.53444 4.04025 4.44385L8.6128 2.09297C8.72352 2.02871 8.84997 1.99661 8.97793 2.00028L12 4L15.0194 2.00028C15.1491 2.00106 15.2759 2.03909 15.3846 2.10983L19.9599 4.4607C20.0982 4.55207 20.1981 4.69098 20.2408 4.85111L21.9738 10.6932C21.999 10.781 22.0061 10.873 21.9947 10.9637C21.9833 11.0543 21.9536 11.1417 21.9073 11.2205C21.8611 11.2993 21.7993 11.3679 21.7258 11.4221C21.6522 11.4763 21.5684 11.515 21.4794 11.5358L18.3365 12.2661" stroke="currentColor" stroke-width="2" stroke-miterlimit="10"/><path d="M5.64682 10.1454V18.5912C5.64587 19.1654 5.86479 19.7182 6.25862 20.136C6.65246 20.5539 7.19132 20.8051 7.76458 20.8381C9.11663 21.0859 10.4879 21.2137 11.8625 21.2201H12.1181C13.4932 21.2071 14.8645 21.0727 16.2159 20.8185C16.7887 20.7848 17.3269 20.5332 17.7201 20.1155C18.1133 19.6977 18.3319 19.1453 18.3309 18.5715V10.1454" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/><path d="M12 5V10.5" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/></svg></span>
            <span class="garment-name">Polo Collar</span>
          </button>
          <button class="garment-card" data-garment="longsleeve" title="Long Sleeve Tee">
            <span class="garment-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M18.3865 17.5395H20.8106C20.991 17.5393 21.1648 17.4712 21.2972 17.3487C21.4297 17.2262 21.5111 17.0583 21.5254 16.8784L22 10.7306L20.2568 4.85409C20.2134 4.69324 20.113 4.55366 19.9743 4.46138L15.3748 2.09664C15.2606 2.02849 15.129 1.99511 14.9962 2.00058H9.00664C8.87531 2.00145 8.74695 2.03967 8.63653 2.11077L4.03701 4.47551C3.89718 4.56663 3.79642 4.70668 3.75448 4.86821L2 10.7363L2.47182 16.884C2.48666 17.0637 2.5683 17.2312 2.70063 17.3536C2.83296 17.476 3.00636 17.5443 3.18661 17.5451H5.63046" stroke="currentColor" stroke-width="2" stroke-miterlimit="10"/><path d="M14.6346 3C14.6346 3.6991 14.3568 4.36957 13.8625 4.86391C13.3682 5.35825 12.6977 5.63596 11.9986 5.63596C11.2995 5.63596 10.629 5.35825 10.1347 4.86391C9.64034 4.36957 9.36263 3.6991 9.36263 3" stroke="currentColor" stroke-width="2" stroke-miterlimit="10"/><path d="M6 10V18.3888C5.99907 18.9587 6.2058 19.5073 6.57784 19.9223C6.94987 20.3373 7.45902 20.5871 8.00089 20.6206C9.28093 20.8665 10.5791 20.9935 11.8804 21H12.1196C13.4209 20.9935 14.7191 20.8665 15.9991 20.6206C16.541 20.5871 17.0501 20.3373 17.4222 19.9223C17.7942 19.5073 18.0009 18.9587 18 18.3888V10" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/></svg></span>
            <span class="garment-name">Long Sleeve</span>
          </button>
          <button class="garment-card" data-garment="hoodie" title="Sport Hoodie">
            <span class="garment-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M14.8282 5.96234V9.59094" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/><path d="M7 17C7.64487 17 8.26333 16.6839 8.71932 16.1213C9.17531 15.5587 9.43148 14.7956 9.43148 14H14.5685C14.5685 14.7956 14.8247 15.5587 15.2807 16.1213C15.7367 16.6839 16.3551 17 17 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.97546 11.7841V19.8071C5.97452 20.3521 6.18211 20.8768 6.55567 21.2737C6.92923 21.6706 7.44044 21.9095 7.98452 21.9415C9.26981 22.1767 10.5733 22.2982 11.8799 22.3044H12.1201C13.4267 22.2982 14.7302 22.1767 16.0155 21.9415C16.5596 21.9095 17.0708 21.6706 17.4444 21.2737C17.8179 20.8768 18.0255 20.3521 18.0245 19.8071V11.7841" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/><path d="M9.16916 5.96234V9.59094" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/><path d="M5.97546 19.4895H3.17664C2.99837 19.4888 2.82684 19.4213 2.69594 19.3003C2.56504 19.1792 2.48427 19.0135 2.46959 18.8359L2 12.7553L3.72359 6.94419C3.76884 6.7864 3.86919 6.65008 4.00641 6.55999L6.83458 5.10321L12 7.00023L17.1654 5.11389L19.9936 6.57066C20.1315 6.66003 20.232 6.79664 20.2764 6.95486L22 12.766L21.5304 18.8465C21.5157 19.0242 21.435 19.1899 21.3041 19.3109C21.1732 19.432 21.0017 19.4995 20.8234 19.5002H18.0245" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/><path d="M6.992 5.14592C6.992 5.14592 6.41569 1.96822 11.9973 2.00024C17.5816 1.96822 17.0027 5.14592 17.0027 5.14592" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/></svg></span>
            <span class="garment-name">Hoodie</span>
          </button>
          <button class="garment-card" data-garment="sweatshirt" title="Sweatshirt">
            <span class="garment-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg></span>
            <span class="garment-name">Sweatshirt</span>
          </button>
          <button class="garment-card" data-garment="vneck" title="V-Neck Tee">
            <span class="garment-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg></span>
            <span class="garment-name">V-Neck</span>
          </button>
          <button class="garment-card" data-garment="tanktop" title="Tank Top">
            <span class="garment-icon"><svg class="lc" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><g clip-path="url(#clip-tank-editor)"><path d="M6.5 3.00003V9.50003L5.66299 12.5V20.6139C5.662 21.1876 5.88049 21.7399 6.27368 22.1577C6.66686 22.5754 7.20496 22.8269 7.77764 22.8606C9.12952 23.1081 10.5006 23.2359 11.8749 23.2425H12.1221C13.4982 23.227 14.8703 23.0898 16.2222 22.8325C16.7954 22.7995 17.3342 22.5483 17.7279 22.1305C18.1217 21.7127 18.3406 21.16 18.3397 20.5859V12.5L17.7279 10V2.5" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/><path d="M6.5 2.5L8.85858 2.16306C9.46101 2.077 10 2.54446 10 3.15301V8.5C11.2721 9.13607 12.7556 9.19777 14.0761 8.66954L14.5 8.5V3.18046C14.5 2.56252 15.0549 2.09248 15.6644 2.19407L17.5 2.5" stroke="currentColor" stroke-width="2" stroke-miterlimit="10" stroke-linecap="round"/></g><defs><clipPath id="clip-tank-editor"><rect width="24" height="24" fill="white"/></clipPath></defs></svg></span>
            <span class="garment-name">Tank Top</span>
          </button>
        </div>
      </div>
      <!-- Which side of the garment is being printed. Hidden entirely for
           garments that have no back view rather than shown disabled: an
           always-dead control on six of eight garments reads as broken. -->
      <div class="control-group" id="garment-side-group" style="display: none;">
        <label class="control-label">Print Side</label>
        <div class="style-toggle" id="garment-side-toggle">
          <button class="style-btn active" data-side="front" type="button">
            <span class="style-name">Front</span>
          </button>
          <button class="style-btn" data-side="back" type="button">
            <span class="style-name">Back</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Section 1: T-Shirt Color -->
    <div class="panel-section" id="shirt-color-section">
      <h3 class="panel-title">T-Shirt Color</h3>
      <div class="control-group">
        <div class="color-grid" id="preset-colors">
          <button class="color-btn" style="background-color: #ffffff;" data-color="#ffffff" title="Classic White" aria-label="Classic White"></button>
          <button class="color-btn active" style="background-color: #212121;" data-color="#212121" title="Vintage Black" aria-label="Vintage Black"></button>
          <button class="color-btn" style="background-color: #afb0b1;" data-color="#afb0b1" title="Athletic Heather Grey" aria-label="Athletic Heather Grey"></button>
          <button class="color-btn" style="background-color: #373a3c;" data-color="#373a3c" title="Charcoal Grey" aria-label="Charcoal Grey"></button>
          <button class="color-btn" style="background-color: #1b2230;" data-color="#1b2230" title="Classic Navy Blue" aria-label="Classic Navy Blue"></button>
          <button class="color-btn" style="background-color: #1e3b8a;" data-color="#1e3b8a" title="Royal Blue" aria-label="Royal Blue"></button>
          <button class="color-btn" style="background-color: #4b533f;" data-color="#4b533f" title="Olive Green" aria-label="Olive Green"></button>
          <button class="color-btn" style="background-color: #1e3328;" data-color="#1e3328" title="Forest Green" aria-label="Forest Green"></button>
          <button class="color-btn" style="background-color: #521c22;" data-color="#521c22" title="Maroon Burgundy" aria-label="Maroon Burgundy"></button>
          <button class="color-btn" style="background-color: #d2c6af;" data-color="#d2c6af" title="Sand Beige" aria-label="Sand Beige"></button>
          <button class="color-btn" style="background-color: #f5d5db;" data-color="#f5d5db" title="Baby Pink" aria-label="Baby Pink"></button>
          <button class="color-btn" style="background-color: #6b7c85;" data-color="#6b7c85" title="Dusty Blue" aria-label="Dusty Blue"></button>
        </div>
      </div>
      <div class="control-group">
        <label class="control-label" for="fabric-hex-input">Custom Fabric Color</label>
        <div class="custom-color-wrapper" id="custom-color-toggle" style="cursor: pointer; user-select: none;">
          <div class="color-btn" id="custom-color-preview" style="background-color: #ffffff; width: 22px; height: 22px; border: 2px solid var(--border-glass); margin: 0; box-shadow: none;" aria-hidden="true"></div>
          <span id="color-hex-label" class="color-picker-value">#ffffff</span>
          <span style="margin-left: auto; font-size: 0.75rem; color: var(--text-muted);" aria-hidden="true">▼</span>
        </div>
        
        <div id="swatch-grid-panel" class="swatch-panel" style="display: none;">
          <div class="swatch-tabs" id="fabric-swatch-tabs">
            <button type="button" class="swatch-tab active" data-tab="presets">Presets</button>
            <button type="button" class="swatch-tab" data-tab="custom">Custom</button>
          </div>
          
          <div class="tab-content" id="fabric-presets-content">
            <div class="swatch-grid" id="swatch-grid"></div>
          </div>
          
          <div class="tab-content" id="fabric-custom-content" style="display: none;">
            <div class="picker-container">
              <div class="picker-row">
                <div class="sl-container" id="fabric-sl-container">
                  <canvas class="sl-canvas" width="200" height="200"></canvas>
                  <div class="sl-marker" id="fabric-sl-marker"></div>
                </div>
                <div class="hue-container" id="fabric-hue-container">
                  <canvas class="hue-canvas" width="20" height="200"></canvas>
                  <div class="hue-marker" id="fabric-hue-marker"></div>
                </div>
              </div>
              <div class="picker-input-row">
                <div class="hex-input-wrapper">
                  <input type="text" class="hex-text-input" id="fabric-hex-input" name="fabric-hex" autocomplete="off" placeholder="#ffffff (e.g. #ff0000)…" maxlength="7" value="#ffffff" />
                  <div class="hex-preview-box" id="fabric-hex-preview" style="background-color: #ffffff;" aria-hidden="true"></div>
                </div>
                <button type="button" class="eye-dropper-btn" id="fabric-eyedropper-btn" title="Pick color from screen" aria-label="Pick color from screen">
                  <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 22l6-6M8.5 12.5l5 5M12.5 8.5l5 5M16 4l4 4-2.5 2.5-4-4L16 4z"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Section 2: Mockup Background -->
    <div class="panel-section" id="mockup-background-section">
      <h3 class="panel-title">Mockup Background</h3>
      <div class="control-group">
        <div class="texture-grid" id="bg-selector" style="grid-template-columns: repeat(2, 1fr);">
          <button class="texture-btn" data-bg="solid-picker">Solid Color</button>
          <button class="texture-btn" data-bg="transparent">Transparent</button>
          <button class="texture-btn active" data-bg="wood-white">Wood Panel White</button>
          <button class="texture-btn" data-bg="wood-brown">Wood Panel Brown</button>
        </div>
      </div>
      <div class="control-group" id="bg-color-picker-container" style="display: none;">
        <label class="control-label" for="bg-hex-input">Background Color</label>
        <div class="custom-color-wrapper" id="bg-custom-color-toggle" style="cursor: pointer; user-select: none;">
          <div class="color-btn" id="bg-custom-color-preview" style="background-color: #121318; width: 22px; height: 22px; border: 2px solid var(--border-glass); margin: 0; box-shadow: none;" aria-hidden="true"></div>
          <span id="bg-color-hex-label" class="color-picker-value">#121318</span>
          <span style="margin-left: auto; font-size: 0.75rem; color: var(--text-muted);" aria-hidden="true">▼</span>
        </div>

        <div id="bg-swatch-grid-panel" class="swatch-panel" style="display: none; width: 100%;">
          <div class="swatch-tabs" id="bg-swatch-tabs">
            <button type="button" class="swatch-tab active" data-tab="presets">Presets</button>
            <button type="button" class="swatch-tab" data-tab="custom">Custom</button>
          </div>
          
          <div class="tab-content" id="bg-presets-content">
            <div class="swatch-grid" id="bg-swatch-grid"></div>
          </div>
          
          <div class="tab-content" id="bg-custom-content" style="display: none;">
