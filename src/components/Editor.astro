      }
    } catch (e) { /* private mode without storage: default to tracking on */ }

    // Export tracking — GA4 plus a first-party beacon to /api/track (counted
    // even when ad-blockers stop GA). Only ever sends metadata (garment or
    // model template, counts, quality), never design content. Must never break
    // the editor.
    function trackEvent(name, params) {
