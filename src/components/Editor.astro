    // Tab Switching setup helper
    function setupTabSwitching(tabContainerId, presetsContentId, customContentId, onTabShow) {
      const tabContainer = document.getElementById(tabContainerId);
      const tabs = tabContainer.querySelectorAll('.swatch-tab');
      const presetsContent = document.getElementById(presetsContentId);
      const customContent = document.getElementById(customContentId);

      tabs.forEach(tab => {
        tab.addEventListener('click', (e) => {
          e.stopPropagation();
          tabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');

          const mode = tab.dataset.tab;
          if (mode === 'presets') {
            presetsContent.style.display = 'block';
            customContent.style.display = 'none';
          } else {
            presetsContent.style.display = 'none';
            customContent.style.display = 'block';
            if (onTabShow) onTabShow();
          }
        });
      });
    }

    setupTabSwitching('fabric-swatch-tabs', 'fabric-presets-content', 'fabric-custom-content', () => {
      fabricColorPicker.drawSlGradient();
      fabricColorPicker.updateMarkerPositions();
    });

    setupTabSwitching('bg-swatch-tabs', 'bg-presets-content', 'bg-custom-content', () => {
      bgColorPicker.drawSlGradient();
      bgColorPicker.updateMarkerPositions();
    });

    // Initialize grids
    buildSwatchGrid(swatchGrid, (color, hex) => {
      // Normalised hex, not the raw swatch value — see the note on the other
      // two call sites: the colour rows are hsl(...) strings and the recolour
      // parses shirtColor positionally.
      shirtColor = hex;
      colorHexLabel.innerText = hex;
      customColorPreview.style.backgroundColor = hex;
      presetColors.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
      fabricColorPicker.setColor(hex, false);
      render();
    }, shirtColor);

    buildSwatchGrid(bgSwatchGrid, (color, hex) => {
      customBgColor = hex;
      bgColorHexLabel.innerText = hex;
      bgCustomColorPreview.style.backgroundColor = hex;
      bgColorPicker.setColor(hex, false);
      render();
    }, customBgColor);

    // key out background and extract shadow/highlight maps using BFS border flood fill
    // Build the mask/shadow/highlight layer canvases for a garment image.
    // Pure with respect to editor state so batch export can process garments
    // other than the active one (results cached per garment type).
    function buildShirtLayers(shirtImage, yFlatBaseline) {
      const w = shirtImage.width;
      const h = shirtImage.height;

      // 1. Create canvases
      const mask = document.createElement('canvas');
      mask.width = w;
      mask.height = h;
      const maskCtx = mask.getContext('2d');
      maskCtx.drawImage(shirtImage, 0, 0);

      const shadows = document.createElement('canvas');
      shadows.width = w;
      shadows.height = h;
      const shadowCtx = shadows.getContext('2d');

      const highlights = document.createElement('canvas');
      highlights.width = w;
      highlights.height = h;
      const highlightCtx = highlights.getContext('2d');

      // 2. Read pixels
      const maskData = maskCtx.getImageData(0, 0, w, h);
      const mPixels = maskData.data;

      const shadowData = shadowCtx.createImageData(w, h);
      const sPixels = shadowData.data;

      const highlightData = highlightCtx.createImageData(w, h);
      const hPixels = highlightData.data;

      // No BFS background removal needed on the client side since the garment image is already pre-cropped and transparent!

      const Y_FLAT = yFlatBaseline || 215; // flat fabric baseline for white shirt

      // 3. Process remaining non-background pixels to build full intensity wrinkle & shine maps
      for (let idx = 0; idx < w * h; idx++) {
        const rIdx = idx * 4;
        const alpha = mPixels[rIdx + 3];

        if (alpha === 0) {
          // background
          sPixels[rIdx] = 255;
          sPixels[rIdx + 1] = 255;
          sPixels[rIdx + 2] = 255;
          sPixels[rIdx + 3] = 0;

          hPixels[rIdx] = 0;
          hPixels[rIdx + 1] = 0;
          hPixels[rIdx + 2] = 0;
          hPixels[rIdx + 3] = 0;
          continue;
        }

        const r = mPixels[rIdx];
        const g = mPixels[rIdx + 1];
        const b = mPixels[rIdx + 2];

        const Y = 0.299 * r + 0.587 * g + 0.114 * b;

        // A. Shadow (creases): values below Y_FLAT represent folds with contrast-enhancing gamma curve
        let sVal = 255;
        if (Y < Y_FLAT) {
          sVal = Math.max(0, Math.min(255, Math.round(255 * Math.pow(Y / Y_FLAT, 1.8))));
        }

        // FADE OUT SHADOWS ON SEMI-TRANSPARENT EDGES TO PREVENT JAGGED DARK OUTLINES
        if (alpha < 255) {
          const factor = alpha / 255;
          sVal = Math.round(sVal * factor + 255 * (1 - factor));
        }

        sPixels[rIdx] = sVal;
        sPixels[rIdx + 1] = sVal;
        sPixels[rIdx + 2] = sVal;
        sPixels[rIdx + 3] = alpha;

        // B. Highlights (sheen): values above Y_FLAT represent shines
        let hVal = 0;
        if (Y > Y_FLAT) {
          hVal = Math.max(0, Math.min(255, Math.round(255 * ((Y - Y_FLAT) / (255 - Y_FLAT)))));
        }
        hPixels[rIdx] = 255;
        hPixels[rIdx + 1] = 255;
        hPixels[rIdx + 2] = 255;
        hPixels[rIdx + 3] = Math.round(hVal * (alpha / 255));
      }

      // Write processed canvases
      maskCtx.putImageData(maskData, 0, 0);
      shadowCtx.putImageData(shadowData, 0, 0);
      highlightCtx.putImageData(highlightData, 0, 0);

      return { mask, shadows, highlights };
    }

    function preProcessShirt() {
      const config = garmentConfigs[activeGarmentType];
      const layers = buildShirtLayers(rawShirtImage, config ? (config.yFlat || 215) : 215);
      processedShirtMask = layers.mask;
      processedShirtShadows = layers.shadows;
      processedShirtHighlights = layers.highlights;
    }

    // Load active design graphic and apply background removal if needed
    function loadActiveDesign() {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.src = designSrc;
      img.onload = () => {
        designImage = img;
        preProcessDesign();
        render();
      };
    }

    // Removes black background from a logo using a BFS flood-fill boundary
    // detector. Pure: returns { buffer, isTransparent } without touching
    // editor state, so batch export can process any number of designs.
    function buildDesignBuffer(img) {
      const w = img.width;
      const h = img.height;

      const buffer = document.createElement('canvas');
      buffer.width = w;
      buffer.height = h;
      const dCtx = buffer.getContext('2d');
      dCtx.drawImage(img, 0, 0);

      // Check if image already has transparent pixels.
      // If it does, we skip keying to avoid corrupting professional transparent PNGs.
      const dData = dCtx.getImageData(0, 0, w, h);
      const pixels = dData.data;

      let hasTransparency = false;
      for (let i = 3; i < pixels.length; i += 4) {
        if (pixels[i] < 240) {
          hasTransparency = true;
          break;
        }
      }

      if (hasTransparency) {
        // Just keep the original design as is
        return { buffer, isTransparent: true };
      }

      // Run Flood-Fill keyer starting from borders to extract outer black background
      const visited = new Uint8Array(w * h);
      const queue = [];

      function enqueue(x, y) {
        if (x >= 0 && x < w && y >= 0 && y < h) {
          const idx = y * w + x;
          if (!visited[idx]) {
            visited[idx] = 1;
            queue.push(idx);
          }
        }
      }

      // Enqueue all boundary pixels
      for (let x = 0; x < w; x++) {
        enqueue(x, 0);
        enqueue(x, h - 1);
      }
      for (let y = 0; y < h; y++) {
        enqueue(0, y);
        enqueue(w - 1, y);
      }

      while (queue.length > 0) {
        const idx = queue.shift();
        const px = idx % w;
        const py = Math.floor(idx / w);
        const rIdx = idx * 4;
        
        const r = pixels[rIdx];
        const g = pixels[rIdx + 1];
        const b = pixels[rIdx + 2];

        // Key threshold: pixel is dark (r,g,b < 35)
        if (r < 35 && g < 35 && b < 35) {
          pixels[rIdx + 3] = 0; // Make transparent

          // Add 4-connected neighbors
          enqueue(px + 1, py);
          enqueue(px - 1, py);
          enqueue(px, py + 1);
          enqueue(px, py - 1);
        }
      }

      // Smooth transition edges of keyed image
      for (let idx = 0; idx < w * h; idx++) {
        if (visited[idx]) continue;
        
        const rIdx = idx * 4;
        const px = idx % w;
        const py = Math.floor(idx / w);
        
        // If not background, check if adjacent to transparent background
        const r = pixels[rIdx];
        const g = pixels[rIdx + 1];
        const b = pixels[rIdx + 2];
        const isDark = (r < 60 && g < 60 && b < 60);

        if (isDark) {
          let hasBgNeighbor = false;
          // check 4 directions
          const neighbors = [
            (py > 0) ? (py - 1) * w + px : -1,
            (py < h - 1) ? (py + 1) * w + px : -1,
            (px > 0) ? py * w + (px - 1) : -1,
            (px < w - 1) ? py * w + (px + 1) : -1
          ];
          
          for (let n of neighbors) {
            if (n !== -1 && visited[n]) {
              hasBgNeighbor = true;
              break;
            }
          }

          if (hasBgNeighbor) {
            // Anti-alias edge
            const brightness = 0.299 * r + 0.587 * g + 0.114 * b;
            pixels[rIdx + 3] = Math.round(255 * (brightness / 60));
          }
        }
      }

      dCtx.putImageData(dData, 0, 0);
      return { buffer, isTransparent: false };
    }

    function preProcessDesign() {
      if (!designImage) return;
      const result = buildDesignBuffer(designImage);
      processedDesignBuffer = result.buffer;
      isDesignTransparent = result.isTransparent;
    }

    // ----------------------------------------------------
    // 4. Custom Background Rendering Helpers
    // ----------------------------------------------------
    function drawBackground(ctxTarget, w, h, isExport = false) {
      switch (activeBgType) {
        case 'transparent':
          ctxTarget.clearRect(0, 0, w, h);
          break;
          
        case 'solid-picker':
          ctxTarget.fillStyle = customBgColor;
          ctxTarget.fillRect(0, 0, w, h);
          break;

        case 'wood-white':
          if (woodWhiteImg) {
            ctxTarget.drawImage(woodWhiteImg, 0, 0, w, h);
          } else {
            ctxTarget.fillStyle = '#e8e8e6';
            ctxTarget.fillRect(0, 0, w, h);
          }
          break;

        case 'wood-brown':
          if (woodBrownImg) {
            ctxTarget.drawImage(woodBrownImg, 0, 0, w, h);
          } else {
            ctxTarget.fillStyle = '#563e2a';
            ctxTarget.fillRect(0, 0, w, h);
          }
          break;

        default:
          ctxTarget.fillStyle = customBgColor;
          ctxTarget.fillRect(0, 0, w, h);
          break;
      }
    }

    function drawProps(ctxTarget, scale = 1) {
      Object.keys(activeProps).forEach(type => {
        if (activeProps[type]) {
          const config = propConfigs[type];
          if (config.loaded && config.img) {
            ctxTarget.save();
            
            // Translate to center of prop in scaled space
            const cx = (config.x + config.w / 2) * scale;
            const cy = (config.y + config.h / 2) * scale;
            ctxTarget.translate(cx, cy);
            
            // Rotate
            const rot = config.rotation || 0;
            ctxTarget.rotate(rot);
            
            // Fixed screen shadow offset (down & right) — soft contact shadow, not a hard drop shadow
            const cos = Math.cos(rot);
            const sin = Math.sin(rot);
            const shadowX = 3 * cos + 5 * sin;
            const shadowY = 5 * cos - 3 * sin;

            ctxTarget.shadowColor = 'rgba(0, 0, 0, 0.25)';
            ctxTarget.shadowBlur = 26 * scale;
            ctxTarget.shadowOffsetX = shadowX * scale;
            ctxTarget.shadowOffsetY = shadowY * scale;
            
            // Draw image centered at origin
            ctxTarget.drawImage(
              config.img, 
              -config.w / 2 * scale, 
              -config.h / 2 * scale, 
              config.w * scale, 
              config.h * scale
            );
            ctxTarget.restore();
          }
        }
      });
    }

    // ----------------------------------------------------
    // 5. Canvas Compositing & Drawing Loop
    // ----------------------------------------------------
    // Snapshot of everything drawScene needs, taken from live editor state.
    // Batch export builds its own scene objects to render garment/color/design
    // combinations without disturbing what's on screen.
    function currentScene() {
      return {
        shirtMask: processedShirtMask,
        shirtShadows: processedShirtShadows,
        shirtHighlights: processedShirtHighlights,
        shirtColor,
        designImage,
        designBuffer: processedDesignBuffer,
        isDesignTransparent,
        designPos,
        designScale,
        designRotation,
        designOpacity,
        useRealisticBlending,
        shadowDepth,
        highlightShine,
      };
    }

    function drawScene(targetCtx, w, h, scale = 1, isExport = false, scene = null) {
      const s = scene || currentScene();

      // The garment/design composition always renders into a fixed square
      // "artboard" (1000 units * scale); for non-1:1 canvas aspects the frame
      // (w,h) is larger in one dimension, so the artboard is centered within it
      // (letterboxed) rather than stretching the garment to fill the frame.
      // Some presets (Etsy/Instagram Story) also apply a slight zoom so the
      // garment doesn't look small against all the extra letterboxed space.
      const shirtZoom = getShirtZoom();
      const artboardSize = 1000 * scale;
      const zoomedArtboardSize = artboardSize * shirtZoom;
      const offsetX = (w - zoomedArtboardSize) / 2;
      const offsetY = (h - zoomedArtboardSize) / 2;

      // 1. Draw Backdrop (fills the full frame, including any letterbox margin)
      drawBackground(targetCtx, w, h, isExport);

      // 2. Render T-Shirt + Design offscreen to handle masking correctly
      const tshirtOffscreen = document.createElement('canvas');
      tshirtOffscreen.width = artboardSize;
      tshirtOffscreen.height = artboardSize;
      const offCtx = tshirtOffscreen.getContext('2d');

      // A. Draw the transparent silhouette mask
      offCtx.drawImage(s.shirtMask, 0, 0, artboardSize, artboardSize);

      // B. Mask with T-shirt base color
      offCtx.globalCompositeOperation = 'source-in';
      offCtx.fillStyle = s.shirtColor;
      offCtx.fillRect(0, 0, artboardSize, artboardSize);

      // C. Draw graphic design layer on top
      if (s.designImage) {
        offCtx.globalCompositeOperation = 'source-atop';
        offCtx.save();
        offCtx.translate(s.designPos.x * scale, s.designPos.y * scale);
        offCtx.rotate(s.designRotation);

        // Calculate graphic size
        const baseSize = 500 * scale; // base bounding size
        const dAspect = s.designImage.width / s.designImage.height;
        let dW = baseSize * s.designScale;
        let dH = baseSize * s.designScale;
        if (dAspect > 1) {
          dH = dW / dAspect;
        } else {
          dW = dH * dAspect;
        }

        offCtx.globalAlpha = s.designOpacity;

        const sourceGraphic = s.isDesignTransparent ? s.designImage : s.designBuffer;
        offCtx.drawImage(sourceGraphic, -dW / 2, -dH / 2, dW, dH);
        offCtx.restore();
      }

      // D. Apply fabric shadow and highlight overlays
      if (s.useRealisticBlending) {
        // Multiply creases on top of colored shirt + logo
        offCtx.globalCompositeOperation = 'source-atop';
        offCtx.save();
        offCtx.globalAlpha = s.shadowDepth;
        offCtx.globalCompositeOperation = 'multiply';
        offCtx.drawImage(s.shirtShadows, 0, 0, artboardSize, artboardSize);
        offCtx.restore();

        // Screen/Overlay highlights on top
        offCtx.globalCompositeOperation = 'source-atop';
        offCtx.save();
        offCtx.globalAlpha = s.highlightShine;
        offCtx.globalCompositeOperation = 'screen';
        offCtx.drawImage(s.shirtHighlights, 0, 0, artboardSize, artboardSize);
        offCtx.restore();
      }

      // E. Draw finished offscreen mockup onto main viewport canvas, centered
      targetCtx.save();
      if (activeBgType !== 'transparent') {
        targetCtx.shadowColor = 'rgba(0, 0, 0, 0.20)';
        targetCtx.shadowBlur = 32 * scale;
        targetCtx.shadowOffsetY = 16 * scale;
      }
      targetCtx.drawImage(tshirtOffscreen, offsetX, offsetY, zoomedArtboardSize, zoomedArtboardSize);
      targetCtx.restore();

      // F. Draw active aesthetic props with realistic drop shadows — same
      // offset + zoom as the shirt above, so props stay aligned to it.
      targetCtx.save();
      targetCtx.translate(offsetX, offsetY);
      targetCtx.scale(shirtZoom, shirtZoom);
      drawProps(targetCtx, scale);
      targetCtx.restore();
    }

    // ----------------------------------------------------
    // 5b. On-Model Mockups
    // ----------------------------------------------------
    // Photographs of a model in a plain violet crewneck, analysed offline by
    // scratch/build_on_model_templates.cjs into three flat images:
    //   photo  — the photograph itself (violet residue in deep creases is
    //            pre-neutralised, since their look shouldn't depend on colour)
    //   weight — R: how much of each pixel's light came from the shirt;
    //            G: solid garment coverage, used to clip the printed design;
    //            B: own-value blend — whether the violet subtracted here is
    //               the modelled one (0) or this pixel's own value (1)
    //   shade  — illumination relative to the fabric's diffuse white point
    //
    // Recolouring never cuts the garment out. Per pixel:
    //   out = photo + w * (T(shade) - V(shade))
    // where T relights the target colour and V relights the shirt's own violet
    // through the same model. On pure fabric photo ≈ V, so out ≈ T with the
    // photograph's grain preserved as texture; on a boundary pixel holding half
    // shirt and half background, only the shirt half moves and the true
    // background half stays untouched. There is no matte and no reconstructed
    // background, so the cut-and-composite failure modes (rims, halos, steps,
    // holes) cannot occur.
    let mockupStyle = 'flatlay'; // 'flatlay' | 'onmodel'
    let onModelTemplates = [];
    let activeOnModelId = null;
    const onModelCache = new Map(); // id -> { photo, photoData, wArr, clipArr, shade, lutV, w, h, meta }
    let onModelComposed = null;     // cached recoloured full-frame canvas
    let onModelComposedKey = '';    // invalidation key: templateId + colour
    // Maps template pixels to canvas pixels for the current frame, so a pointer
    // event can be inverted back into the template's own coordinates.
    let onModelView = { k: 1, ox: 0, oy: 0 };
    let onModelSelected = false;    // handles show only while the print is selected
    let onModelThumbColour = '';    // last colour the picker thumbnails were painted in
    let onModelDrag = null;

    // 256-entry relight LUT: shade byte -> RGB for a given base colour. Shared
    // by the target colour and the violet reference so model errors cancel.
    function onModelRelightLut(rgb, meta) {
      const [ar, ag, ab] = meta.ambientTint;
      const relMax = meta.relMax || 1.45;
      const tLum = (rgb[0] + rgb[1] + rgb[2]) / 765;
      const GAMMA = 1 - 0.55 * tLum;
      const TINT = 0.35 * tLum;
      const SPEC = 0.28;
      const lut = new Float32Array(256 * 3);
      for (let sb = 0; sb < 256; sb++) {
        const rel = (sb / 255) * relMax;
        const diff = Math.pow(Math.min(rel, 1), GAMMA);
        const wgt = (1 - diff) * TINT;
        let r = rgb[0] * diff * (1 - wgt + wgt * ar);
        let g = rgb[1] * diff * (1 - wgt + wgt * ag);
        let b = rgb[2] * diff * (1 - wgt + wgt * ab);
        if (rel > 1) {
          const sp = Math.min(1, (rel - 1) / (relMax - 1)) * SPEC;
          r += (255 - r) * sp; g += (255 - g) * sp; b += (255 - b) * sp;
        }
        lut[sb * 3] = r; lut[sb * 3 + 1] = g; lut[sb * 3 + 2] = b;
      }
      return lut;
    }

    async function loadOnModelTemplate(meta) {
      if (onModelCache.has(meta.id)) return onModelCache.get(meta.id);
      const loadImg = src => new Promise((res, rej) => {
        const i = new Image();
        i.onload = () => res(i);
        i.onerror = () => rej(new Error('failed to load ' + src));
        i.src = src;
      });
      const [photoImg, weightImg, shadeImg] = await Promise.all([
        loadImg(meta.photo), loadImg(meta.weight), loadImg(meta.shade),
      ]);
      const w = meta.width, h = meta.height, n = w * h;
      const tmp = document.createElement('canvas');
      tmp.width = w; tmp.height = h;
      const tctx = tmp.getContext('2d', { willReadFrequently: true });
      tctx.drawImage(photoImg, 0, 0, w, h);
      const photoData = new Uint8ClampedArray(tctx.getImageData(0, 0, w, h).data);
      tctx.clearRect(0, 0, w, h);
      tctx.drawImage(weightImg, 0, 0, w, h);
      const weightRGBA = tctx.getImageData(0, 0, w, h).data;
      tctx.clearRect(0, 0, w, h);
      tctx.drawImage(shadeImg, 0, 0, w, h);
      const shadeRGBA = tctx.getImageData(0, 0, w, h).data;
      const wArr = new Uint8ClampedArray(n);
      const clipArr = new Uint8ClampedArray(n);
      const ownArr = new Uint8ClampedArray(n);
      const shade = new Uint8ClampedArray(n);
      for (let i = 0; i < n; i++) {
        wArr[i] = weightRGBA[i * 4];
        clipArr[i] = weightRGBA[i * 4 + 1];
        ownArr[i] = weightRGBA[i * 4 + 2];
        shade[i] = shadeRGBA[i * 4];
      }
      const entry = {
        photo: photoImg, photoData, wArr, clipArr, ownArr, shade, w, h, meta,
        lutV: onModelRelightLut(meta.violetBase, meta),
      };
      onModelCache.set(meta.id, entry);
      return entry;
    }

    // Recolours the whole frame into a standalone canvas. Only redone when the
    // template or shirt colour changes — dragging the design reuses it.
    function buildOnModelComposed(entry, hex) {
      const tr = parseInt(hex.slice(1, 3), 16);
      const tg = parseInt(hex.slice(3, 5), 16);
      const tb = parseInt(hex.slice(5, 7), 16);
      const lutT = onModelRelightLut([tr, tg, tb], entry.meta);
      const lutV = entry.lutV;
      const { photoData, wArr, ownArr, shade, w, h } = entry;
      const cnv = document.createElement('canvas');
      cnv.width = w; cnv.height = h;
      const c = cnv.getContext('2d');
      const out = c.createImageData(w, h);
      const d = out.data;
      d.set(photoData);
      const n = w * h;
      // The violet being subtracted blends between two references. Inside solid
      // coverage the pixel's own value IS the violet — subtracting it exactly
      // cancels every local chroma variation the fixed model can't track (the
      // shadow side of a window-lit shirt runs bluer than the median violet,
      // and using the model there leaves violet patches). At the boundary the
      // pixel is part background, so its own value must NOT be subtracted in
      // full; there the model reference takes over, faded in by the ramp.
      //
      // That blend factor is the weight map's B channel, decided by how much
      // colour information the pixel carries — NOT by the design clip in G,
      // which answers the unrelated question of where the graphic prints.
      // Where a pixel is information-free (a near-black underarm crease) B is
      // 1, so the output is a convex blend of the pixel and T(shade): it can
      // never leave the gamut spanned by those two, which is what stops
      // modelled violet being over-subtracted into green blotches.
      for (let i = 0; i < n; i++) {
        const wv = wArr[i];
        if (wv === 0) continue;
        const ww = wv / 255;
        const cl = ownArr[i] / 255;
        const sb = shade[i] * 3;
        const o = i * 4;
        d[o] = d[o] + ww * (lutT[sb] - cl * d[o] - (1 - cl) * lutV[sb]);
        d[o + 1] = d[o + 1] + ww * (lutT[sb + 1] - cl * d[o + 1] - (1 - cl) * lutV[sb + 1]);
        d[o + 2] = d[o + 2] + ww * (lutT[sb + 2] - cl * d[o + 2] - (1 - cl) * lutV[sb + 2]);
      }
      c.putImageData(out, 0, 0);
      return cnv;
    }

    // Maps the shared 0-1000 artboard design transform onto the template's
    // print quad, so the same drag/scale/rotate controls drive both modes.
    // Where the print sits on this template, in template pixels. Shared by the
    // draw pass and by hit-testing, so what the user grabs is by construction
    // what they see — the two cannot drift apart.
    function onModelDesignBox(entry) {
      const q = entry.meta.quad;
      const qcx = (q.tl[0] + q.tr[0] + q.br[0] + q.bl[0]) / 4;
      const qcy = (q.tl[1] + q.tr[1] + q.br[1] + q.bl[1]) / 4;
      const quadW = Math.hypot(q.tr[0] - q.tl[0], q.tr[1] - q.tl[1]);
      const quadH = Math.hypot(q.bl[0] - q.tl[0], q.bl[1] - q.tl[1]);
      // The quad is measured from the torso itself, so a design at the default
      // scale should simply fill it — that is what a chest print is.
      const dAspect = designImage ? designImage.width / designImage.height : 1;
      let dW = quadW * (designScale / 0.35);
      let dH = dW / dAspect;
      if (dAspect <= 1) { dH = quadH * (designScale / 0.35); dW = dH * dAspect; }
      // designPos is authored in artboard units around (500, 420); carry that
      // offset across proportionally rather than pinning the design dead-centre.
      return {
        cx: qcx + (designPos.x - 500) / 1000 * quadW,
        cy: qcy + (designPos.y - 420) / 1000 * quadH,
        w: dW, h: dH, qcx, qcy, quadW, quadH,
      };
    }
    // In on-model mode the canvas-size presets are a CROP of the template
    // photo, not a zoom: the templates top out at 1600px, so scaling past the
    // source pixels would only soften the print. One mechanism for all four —
    // every preset crops, none pads, nothing is special-cased.
    //
    // The rect is the largest one of the requested aspect that fits inside the
    // photo, centred on the print quad and then pushed back inside the image.
    // Centring on the print is the point rather than a compromise: on a listing
    // the design is the product, so 4:3 keeping only half the height and taking
    // the model's head with it is the intended framing, not a defect.
    // Deliberately unrounded. The rect carries the preset's ratio EXACTLY —
    // 4:3 off a 1066-wide photo is 1066x799.5, not 1066x800 — because the
    // frames it gets drawn into are exact too (800x600 on screen, 2700x2025
    // exported). Round it here and the rect no longer matches the frame, and
    // drawOnModelScene's fit leaves a hairline of cleared pixels down one edge.
    // Fractional source coordinates cost nothing: the rect is applied as a
    // translate, not as an integer pixel copy.
    function onModelCropRect(entry) {
      const ratio = CANVAS_ASPECTS[canvasAspect] || { w: 1, h: 1 };
      const fit = Math.min(entry.w / ratio.w, entry.h / ratio.h);
      const cw = ratio.w * fit;
      const ch = ratio.h * fit;
      const q = entry.meta && entry.meta.quad;
      const qcx = q ? (q.tl[0] + q.tr[0] + q.br[0] + q.bl[0]) / 4 : entry.w / 2;
      const qcy = q ? (q.tl[1] + q.tr[1] + q.br[1] + q.bl[1]) / 4 : entry.h / 2;
      // Clamping MOVES the rect, it never shrinks it. 4:3 keeps only half the
      // height, so on most templates it lands hard against the top or bottom
      // edge; trimming it there would quietly hand back a different aspect
      // than the preset the user picked.
      const clamp = (v, hi) => Math.max(0, Math.min(v, hi));
      return {
        x: clamp(qcx - cw / 2, entry.w - cw),
        y: clamp(qcy - ch / 2, entry.h - ch),
        w: cw,
        h: ch,
      };
    }

    // Integer frame of `shortSide` pixels on the rect's shorter axis, carrying
    // the preset's exact ratio. Both the live canvas and the export size
    // themselves this way, so neither can end up a rounded pixel off the crop.
    function onModelFrameDims(crop, shortSide) {
      const ratio = CANVAS_ASPECTS[canvasAspect] || { w: 1, h: 1 };
      const portrait = ratio.h > ratio.w;
      const short = Math.max(1, Math.round(shortSide));
      const long = Math.round(short * Math.max(ratio.w, ratio.h) / Math.min(ratio.w, ratio.h));
      return portrait ? { w: short, h: long } : { w: long, h: short };
    }

    // What an on-model download will actually be. The download modal prints
    // these numbers and runDownload renders at them, from one function, so the
    // size offered and the size saved cannot drift.
    //
    // A platform preset is held to the size on its button; quality multiplies
    // it exactly as it does in flat lay. A preset with no platform size has
    // nothing to hit, so it stays at the template's own pixels — and since
    // doubling those would be pure upscale with nothing asking for it, that is
    // one size rather than a choice. onModelHasQualityChoice says which.
    function onModelExportDims(entry, isExtraHigh) {
      const crop = onModelCropRect(entry);
      const preset = CANVAS_ASPECTS[canvasAspect];
      const shortSide = preset.exportShort
        ? preset.exportShort * (preset.oneX ? 1 : (isExtraHigh ? 2 : 1))
        : Math.min(crop.w, crop.h);
      return onModelFrameDims(crop, shortSide);
    }
    function onModelHasQualityChoice() {
      const preset = CANVAS_ASPECTS[canvasAspect];
      return !!preset.exportShort && !preset.oneX;
    }

    // Corners of the placed print, rotation applied: [TL, TR, BR, BL].
    const ON_MODEL_CORNER_SIGN = [[-1, -1], [1, -1], [1, 1], [-1, 1]];
    function onModelBoxCorners(b) {
      const co = Math.cos(designRotation), si = Math.sin(designRotation);
      return ON_MODEL_CORNER_SIGN.map(([sx, sy]) => {
        const x = sx * b.w / 2, y = sy * b.h / 2;
        return { x: b.cx + x * co - y * si, y: b.cy + x * si + y * co };
      });
    }

    function drawOnModelDesign(targetCtx, entry, scale) {
      if (!designImage) return;
      const { w, h } = entry;
      const box = onModelDesignBox(entry);
      const cx = box.qcx, cy = box.qcy;
      const dW = box.w, dH = box.h;
      const offX = box.cx - box.qcx, offY = box.cy - box.qcy;

      const layer = document.createElement('canvas');
      layer.width = w; layer.height = h;
      const lc = layer.getContext('2d');

      const srcGraphic = isDesignTransparent ? designImage : processedDesignBuffer;
      if (!srcGraphic) return;
      const placeDesign = () => {
        lc.save();
        lc.translate(cx + offX, cy + offY);
        lc.rotate(designRotation);
        lc.drawImage(srcGraphic, -dW / 2, -dH / 2, dW, dH);
        lc.restore();
      };

      lc.globalAlpha = designOpacity;
      placeDesign();
      lc.globalAlpha = 1;

      // The shading passes below re-clip to the print's own alpha. Snapshot it
      // once rather than re-running placeDesign() twice more.
      const printAlpha = document.createElement('canvas');
      printAlpha.width = w; printAlpha.height = h;
      printAlpha.getContext('2d').drawImage(layer, 0, 0);

      // Fold shading over the print — the same two passes flat-lay uses, so a
      // design sits into the fabric the same way in both modes: multiply the
      // creases down, then screen the lit crests back up. Shadows alone leave
      // the print looking laid on top of the shirt rather than printed into it.
      // Both passes also paint where the layer is still transparent, so each is
      // clipped straight back to the design's own alpha.
      if (useRealisticBlending) {
        lc.globalCompositeOperation = 'multiply';
        lc.globalAlpha = Math.min(1, shadowDepth + 0.25);
        lc.drawImage(onModelShadeCanvas(entry), 0, 0);
        lc.globalAlpha = 1;
        lc.globalCompositeOperation = 'destination-in';
        lc.drawImage(printAlpha, 0, 0);

        lc.globalCompositeOperation = 'screen';
        lc.globalAlpha = highlightShine;
        lc.drawImage(onModelHighlightCanvas(entry), 0, 0);
        lc.globalAlpha = 1;
        lc.globalCompositeOperation = 'destination-in';
        lc.drawImage(printAlpha, 0, 0);
      }
      lc.globalCompositeOperation = 'destination-in';
      lc.drawImage(onModelClipCanvas(entry), 0, 0);

      targetCtx.drawImage(layer, 0, 0, w * scale, h * scale);
    }

    // Lazily materialised greyscale canvases, kept on the cache entry so the
    // multiply/clip passes above don't rebuild them every frame.
    function onModelShadeCanvas(entry) {
      if (entry._shadeCanvas) return entry._shadeCanvas;
      const { shade, w, h } = entry;
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      const cx = c.getContext('2d');
      const img = cx.createImageData(w, h);
      for (let i = 0; i < w * h; i++) {
        // Lift toward white so the multiply darkens folds without dimming the
        // whole print — mid illumination should read as roughly neutral.
        const v = 150 + (shade[i] / 255) * 105;
        img.data[i * 4] = v; img.data[i * 4 + 1] = v; img.data[i * 4 + 2] = v; img.data[i * 4 + 3] = 255;
      }
      cx.putImageData(img, 0, 0);
      entry._shadeCanvas = c;
      return c;
    }
    // Fabric highlights, for the screen pass over the print. The shade map is
    // illumination relative to the fabric's diffuse white point, so rel > 1 is
    // exactly where the fabric is catching light beyond flat diffuse — the
    // crests of folds. Everything at or below the white point contributes
    // nothing, which is what screening against black gives.
    function onModelHighlightCanvas(entry) {
      if (entry._hiCanvas) return entry._hiCanvas;
      const { shade, w, h, meta } = entry;
      const relMax = meta.relMax || 1.45;
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      const cx = c.getContext('2d');
      const img = cx.createImageData(w, h);
      for (let i = 0; i < w * h; i++) {
        const rel = (shade[i] / 255) * relMax;
        const t = Math.max(0, Math.min(1, (rel - 1) / Math.max(1e-6, relMax - 1)));
        const v = Math.round(t * 255);
        img.data[i * 4] = v; img.data[i * 4 + 1] = v; img.data[i * 4 + 2] = v; img.data[i * 4 + 3] = 255;
      }
      cx.putImageData(img, 0, 0);
      entry._hiCanvas = c;
      return c;
    }
    function onModelClipCanvas(entry) {
      if (entry._clipCanvas) return entry._clipCanvas;
      const { clipArr, w, h } = entry;
      const c = document.createElement('canvas');
      c.width = w; c.height = h;
      const cx = c.getContext('2d');
      const img = cx.createImageData(w, h);
      for (let i = 0; i < w * h; i++) {
        img.data[i * 4] = 255; img.data[i * 4 + 1] = 255; img.data[i * 4 + 2] = 255;
        img.data[i * 4 + 3] = clipArr[i];
      }
      cx.putImageData(img, 0, 0);
      entry._clipCanvas = c;
      return c;
    }

    function drawOnModelScene(targetCtx, frameW, frameH) {
      const entry = onModelCache.get(activeOnModelId);
      if (!entry) return false;

      const key = activeOnModelId + '|' + shirtColor;
      if (onModelComposedKey !== key) {
        onModelComposed = buildOnModelComposed(entry, shirtColor);
        onModelComposedKey = key;
      }

      // Fit the crop rect inside the frame, centred. The frame is sized to the
      // same rect everywhere it matters, so there is normally no margin at all;
      // any that does appear — mid-resize, or a rounded pixel — is cleared
      // rather than filled with the flat-lay backdrop. That backdrop is a
      // flat-lay concept the user cannot even reach in this mode, so painting
      // it here put wood panels beside the model that no control could remove.
      // A visible margin now also means the crop rect is wrong.
      const crop = onModelCropRect(entry);
      const k = Math.min(frameW / crop.w, frameH / crop.h);
      const dw = crop.w * k, dh = crop.h * k;
      // The crop is folded into the same translation the view already carried,
      // so handles, hit-testing and the pointer transform follow it for free.
      // Do not add a second offset anywhere: this is the only one.
      const ox = (frameW - dw) / 2 - crop.x * k;
      const oy = (frameH - dh) / 2 - crop.y * k;

      onModelView = { k, ox, oy };

      targetCtx.clearRect(0, 0, frameW, frameH);
      targetCtx.save();
      targetCtx.translate(ox, oy);
      targetCtx.scale(k, k);
      targetCtx.drawImage(onModelComposed, 0, 0);
      drawOnModelDesign(targetCtx, entry, 1);
      targetCtx.restore();
      // Handles are chrome: drawn after restore, in canvas pixels, so they stay
      // a constant size on screen and are never clipped to the garment.
      drawOnModelHandles(targetCtx, entry);
      return true;
    }


    // Sizes come from the shared SEL_* constants so this is literally the same
    // control as flat lay, not a copy that drifts. Canvas pixels per CSS pixel
    // here — the on-model chrome is drawn after the template transform is
    // restored, so there is no zoom to divide out.
    //
    // The grab radius is capped against the box: on a small print four corner
    // catchments would otherwise meet in the middle and the design could no
    // longer be dragged at all, the tolerance having eaten the one gesture it
    // is not for.
    function onModelHitTol(drawnRadius, box) {
      const want = Math.max(selGrabCss() * selCanvasScale(),
                            (drawnRadius * selCanvasScale()) + 4);
      const room = box ? Math.min(box.w, box.h) * onModelView.k * 0.35 : Infinity;
      // Floor of the handle plus 6 CSS px, so the cap can tighten the grab
      // toward the artwork but never below something a finger can land on.
      const floor = (drawnRadius + 6) * selCanvasScale();
      return Math.max(floor, Math.min(want, room));
    }

    function onModelToCanvas(p) {
      return { x: onModelView.ox + p.x * onModelView.k, y: onModelView.oy + p.y * onModelView.k };
    }
    function onModelToTemplate(e) {
      const rect = canvas.getBoundingClientRect();
      const sx = canvas.width / rect.width, sy = canvas.height / rect.height;
      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;
      return {
        x: ((clientX - rect.left) * sx - onModelView.ox) / onModelView.k,
        y: ((clientY - rect.top) * sy - onModelView.oy) / onModelView.k,
      };
    }
    function onModelRotHandle(b) {
      const co = Math.cos(designRotation), si = Math.sin(designRotation);
      // Below the box, as in flat lay.
      const gap = SEL_ROT_GAP * selCanvasScale() / onModelView.k;
      const y = b.h / 2 + gap;
      return { x: b.cx - y * si, y: b.cy + y * co };
    }

    function drawOnModelHandles(targetCtx, entry) {
      if (!designImage || !onModelSelected) return;
      const b = onModelDesignBox(entry);
      const pts = onModelBoxCorners(b).map(onModelToCanvas);
      const rot = onModelToCanvas(onModelRotHandle(b));
      // The same drawSelectionChrome flat lay uses. Canvas pixels per CSS
      // pixel, since this runs after the template transform is restored.
      drawSelectionChrome(targetCtx, pts, rot, selCanvasScale());
    }

    function onModelHitTest(pt, entry) {
      if (!designImage) return null;
      const b = onModelDesignBox(entry);
      const near = (a, c, r) => Math.hypot(a.x - c.x, a.y - c.y) <= r;
      if (onModelSelected) {
        const rotTol = onModelHitTol(SEL_ROT_R, b) / onModelView.k;
        if (near(pt, onModelRotHandle(b), rotTol)) return { mode: 'rotate' };
        const cornTol = onModelHitTol(SEL_HANDLE_R, b) / onModelView.k;
        const pts = onModelBoxCorners(b);
        for (let i = 0; i < 4; i++) if (near(pt, pts[i], cornTol)) return { mode: 'scale', corner: i };
      }
      const co = Math.cos(designRotation), si = Math.sin(designRotation);
      const dx = pt.x - b.cx, dy = pt.y - b.cy;
      const lx = dx * co + dy * si, ly = -dx * si + dy * co;
      if (Math.abs(lx) <= b.w / 2 && Math.abs(ly) <= b.h / 2) return { mode: 'move' };
      return null;
    }

    // Writes a template-space centre back into the shared artboard designPos,
    // so the sidebar's own position readout and the flat-lay state stay in step.
    function onModelSetCentre(b, x, y) {
      designPos.x = 500 + (x - b.qcx) / b.quadW * 1000;
      designPos.y = 420 + (y - b.qcy) / b.quadH * 1000;
    }

    function onModelPointerStart(e) {
      const entry = onModelCache.get(activeOnModelId);
      if (!entry || !designImage) return;
      const pt = onModelToTemplate(e);
      const hit = onModelHitTest(pt, entry);
      if (!hit) {                      // click outside deselects, as in flat-lay
        if (onModelSelected) { onModelSelected = false; render(); }
        return;
      }
      if (e.cancelable) e.preventDefault();
      if (!onModelSelected) onModelSelected = true;
      const b = onModelDesignBox(entry);
      onModelDrag = { ...hit, start: pt, cx0: b.cx, cy0: b.cy, scale0: designScale,
                      w0: b.w, h0: b.h, rot0: designRotation };
      if (hit.mode === 'scale') {
        const pts = onModelBoxCorners(b);
        onModelDrag.anchorIdx = (hit.corner + 2) % 4;
        onModelDrag.anchor = pts[onModelDrag.anchorIdx];
        onModelDrag.grab0 = Math.max(1e-3, Math.hypot(
          pts[hit.corner].x - onModelDrag.anchor.x, pts[hit.corner].y - onModelDrag.anchor.y));
      }
      if (hit.mode === 'rotate') onModelDrag.a0 = Math.atan2(pt.y - b.cy, pt.x - b.cx) - designRotation;
      render();
    }

    function onModelPointerMove(e) {
      const entry = onModelCache.get(activeOnModelId);
      if (!entry) return;
      if (!onModelDrag) {
        if (!designImage) { canvas.style.cursor = 'default'; return; }
        const h = onModelHitTest(onModelToTemplate(e), entry);
        canvas.style.cursor = !h ? 'default' : h.mode === 'move' ? 'move'
          : h.mode === 'rotate' ? 'crosshair' : 'nwse-resize';
        return;
      }
      if (e.cancelable) e.preventDefault();
      const pt = onModelToTemplate(e);
      const b = onModelDesignBox(entry);
      if (onModelDrag.mode === 'move') {
        let nx = onModelDrag.cx0 + (pt.x - onModelDrag.start.x);
        let ny = onModelDrag.cy0 + (pt.y - onModelDrag.start.y);
        const snap = 9 / onModelView.k;
        if (Math.abs(nx - b.qcx) < snap) nx = b.qcx;   // snap to the chest centre
        if (Math.abs(ny - b.qcy) < snap) ny = b.qcy;
        onModelSetCentre(b, nx, ny);
      } else if (onModelDrag.mode === 'scale') {
        const k = Math.max(0.06, Math.hypot(pt.x - onModelDrag.anchor.x, pt.y - onModelDrag.anchor.y) / onModelDrag.grab0);
        designScale = Math.max(0.05, Math.min(2.5, onModelDrag.scale0 * k));
        // Keep the opposite corner pinned: the anchor sits at its own local
        // offset from the centre, so the centre is the anchor MINUS that offset
        // at the new size, through the current rotation.
        const co = Math.cos(designRotation), si = Math.sin(designRotation);
        const [sx, sy] = ON_MODEL_CORNER_SIGN[onModelDrag.anchorIdx];
        const ax = sx * (onModelDrag.w0 * k) / 2, ay = sy * (onModelDrag.h0 * k) / 2;
        onModelSetCentre(b, onModelDrag.anchor.x - (ax * co - ay * si),
                            onModelDrag.anchor.y - (ax * si + ay * co));
        if (typeof scaleSlider !== 'undefined' && scaleSlider) scaleSlider.value = Math.round(designScale * 100);
        if (typeof scaleManual !== 'undefined' && scaleManual) scaleManual.value = Math.round(designScale * 100);
      } else {
        let deg = (Math.atan2(pt.y - onModelDrag.cy0, pt.x - onModelDrag.cx0) - onModelDrag.a0) * 180 / Math.PI;
        if (deg > 180) deg -= 360;
        if (deg < -180) deg += 360;
        designRotation = snapAngleDeg(deg) * (Math.PI / 180);
        // rotateSlider/rotateManual — these read rotationSlider/rotationManual,
        // which do not exist, and the typeof guard swallowed it silently, so
        // rotating on a model turned the print but never moved the sidebar.
        const rdeg = Math.round(designRotation * 180 / Math.PI);
        if (rotateSlider) rotateSlider.value = rdeg;
        if (rotateManual) rotateManual.value = rdeg;
      }
      render();
    }

    function onModelPointerEnd() {
      if (onModelDrag) { onModelDrag = null; render(); }
    }

    async function setMockupStyle(style) {
      mockupStyle = style;
      onModelSelected = false;
      onModelDrag = null;
      document.querySelectorAll('#mockup-style-toggle .style-btn').forEach(b => {
        b.classList.toggle('active', b.dataset.style === style);
      });
      const onModelSection = document.getElementById('on-model-section');
      const garmentSection = document.getElementById('garment-type-section');
      const propsSection = document.getElementById('aesthetic-props-section');
      const bgSection = document.getElementById('mockup-background-section');
      if (onModelSection) onModelSection.style.display = style === 'onmodel' ? '' : 'none';
      // Garment type and props are flat-lay concepts; an on-model template
      // already fixes the garment and the setting. Canvas size is not: it is
      // the listing's frame, and on-model it crops the photo instead of
      // letterboxing an artboard, so all four presets stay available.
      if (garmentSection) garmentSection.style.display = style === 'onmodel' ? 'none' : '';
      if (propsSection) propsSection.style.display = style === 'onmodel' ? 'none' : '';
      // The background belongs to the flat lay, where the garment is cut out
      // and composited onto one. An on-model template is a photograph that
      // brings its own room with it — there is nothing behind the model to
      // replace, so solid colour, transparency and the wood panels have no
      // meaning here and only invite a click that does nothing.
      if (bgSection) bgSection.style.display = style === 'onmodel' ? 'none' : '';
      // Mobile hides every panel-section and re-shows them per tab with
      // !important, which beats the inline display above — so the mode has to
      // be expressed as state the stylesheet can see, not just inline styles.
      const appEl = document.querySelector('.app-container');
      if (appEl) appEl.dataset.mockupStyle = style;
      // Props is flat-lay-only, so on-model leaves its tab with nothing in it.
      // Hide the tab rather than let someone land on a blank panel, and move
      // off it if that is where they already are.
      //
      // The Canvas tab is not empty on-model: canvas size lives there too, and
      // hiding it would make the presets unreachable on a phone — the panel
      // would be shown with no route to it. It keeps its place in both modes,
      // which is why it is named for the canvas rather than the backdrop: the
      // backdrop is only half its contents and only in flat lay.
      const navBar = document.getElementById('mobile-nav-bar');
      if (navBar && appEl) {
        const emptyOnModel = ['props'];
        emptyOnModel.forEach(t => {
          const nb = navBar.querySelector(`[data-target="${t}"]`);
          if (nb) nb.style.display = style === 'onmodel' ? 'none' : '';
        });
        if (style === 'onmodel' && emptyOnModel.includes(appEl.dataset.mobileTab)) {
          const fallback = navBar.querySelector('[data-target="garment"]');
          if (fallback) fallback.click();
        }
      }
      // Batch export is flat-lay only. Its axes are garment type and colour,
      // and an on-model template fixes the garment — so left live here it
      // runs the flat-lay pipeline and hands back crewnecks and hoodies on a
      // wood panel, silently, with none of the model the user is looking at.
      // Hidden when the model x colour version doesn't exist yet; remove this
      // block when it does. Still disabled as well as hidden, because a
      // display rule elsewhere can outrank an inline one — that is exactly
      // how the flat-lay panels came back on mobile — and a button that is
      // merely invisible is still clickable.
      const batchBtn = document.getElementById('batch-export-btn');
      if (batchBtn) {
        const off = style === 'onmodel';
        batchBtn.style.display = off ? 'none' : '';
        batchBtn.disabled = off;
      }

      if (style === 'onmodel') {
        if (!activeOnModelId && onModelTemplates.length) activeOnModelId = onModelTemplates[0].id;
        const meta = onModelTemplates.find(t => t.id === activeOnModelId);
        if (meta) {
          if (canvasLoading) canvasLoading.style.display = 'flex';
          try {
            await loadOnModelTemplate(meta);
            applyCanvasSizing();
            onModelComposedKey = '';
          } finally { if (canvasLoading) canvasLoading.style.display = 'none'; }
        }
      } else {
        applyCanvasAspect();
      }
      render();
    }

    // Thumbnail maps, kept separate from the full-size ones. They are a few KB
    // each, so the picker can show every model recoloured without pulling five
    // full templates onto a page that otherwise loads one on demand.
    const onModelThumbs = new Map();
    async function loadOnModelThumb(meta) {
      if (onModelThumbs.has(meta.id)) return onModelThumbs.get(meta.id);
      const loadImg = src => new Promise((res, rej) => {
        const i = new Image();
        i.onload = () => res(i);
        i.onerror = () => rej(new Error('failed to load ' + src));
        i.src = src;
      });
      const [ph, wt, sh] = await Promise.all([
        loadImg(meta.thumbPhoto), loadImg(meta.thumbWeight), loadImg(meta.thumbShade),
      ]);
      const w = meta.thumbWidth || 112, h = meta.thumbHeight || 168, n = w * h;
      const tmp = document.createElement('canvas');
      tmp.width = w; tmp.height = h;
      const tc = tmp.getContext('2d', { willReadFrequently: true });
      tc.drawImage(ph, 0, 0, w, h);
      const photo = new Uint8ClampedArray(tc.getImageData(0, 0, w, h).data);
      tc.clearRect(0, 0, w, h); tc.drawImage(wt, 0, 0, w, h);
      const wd = tc.getImageData(0, 0, w, h).data;
      tc.clearRect(0, 0, w, h); tc.drawImage(sh, 0, 0, w, h);
      const sd = tc.getImageData(0, 0, w, h).data;
      const wArr = new Uint8ClampedArray(n), ownArr = new Uint8ClampedArray(n), shade = new Uint8ClampedArray(n);
      for (let i = 0; i < n; i++) {
        wArr[i] = wd[i * 4]; ownArr[i] = wd[i * 4 + 2]; shade[i] = sd[i * 4];
      }
      const entry = { w, h, photo, wArr, ownArr, shade, lutV: onModelRelightLut(meta.violetBase, meta) };
      onModelThumbs.set(meta.id, entry);
      return entry;
    }

    // Same recolour as the main frame, so a thumbnail is an honest preview of
    // what selecting it produces rather than a tinted stand-in.
    function paintOnModelThumb(cv, th, meta, hex) {
      const tr = parseInt(hex.slice(1, 3), 16);
      const tg = parseInt(hex.slice(3, 5), 16);
      const tb = parseInt(hex.slice(5, 7), 16);
      const lutT = onModelRelightLut([tr, tg, tb], meta);
      const { w, h, photo, wArr, ownArr, shade, lutV } = th;
      cv.width = w; cv.height = h;
      const cx = cv.getContext('2d');
      const out = cx.createImageData(w, h), d = out.data;
      d.set(photo);
      for (let i = 0, n = w * h; i < n; i++) {
        const wv = wArr[i]; if (wv === 0) continue;
        const ww = wv / 255, cl = ownArr[i] / 255, sb = shade[i] * 3, o = i * 4;
        d[o]     = d[o]     + ww * (lutT[sb]     - cl * d[o]     - (1 - cl) * lutV[sb]);
        d[o + 1] = d[o + 1] + ww * (lutT[sb + 1] - cl * d[o + 1] - (1 - cl) * lutV[sb + 1]);
        d[o + 2] = d[o + 2] + ww * (lutT[sb + 2] - cl * d[o + 2] - (1 - cl) * lutV[sb + 2]);
      }
      cx.putImageData(out, 0, 0);
    }

    async function repaintOnModelThumbs() {
      const host = document.getElementById('on-model-selector');
      if (!host) return;
      for (const btn of host.querySelectorAll('.on-model-card')) {
        const meta = onModelTemplates.find(t => t.id === btn.dataset.template);
        if (!meta || !meta.thumbPhoto) continue;
        try {
          const th = await loadOnModelThumb(meta);
          paintOnModelThumb(btn.querySelector('canvas'), th, meta, shirtColor);
        } catch (e) { /* a missing thumbnail must not break the picker */ }
      }
    }

    function buildOnModelSelector() {
      const host = document.getElementById('on-model-selector');
      if (!host) return;
      host.innerHTML = onModelTemplates.map(t => `
        <button class="on-model-card" data-template="${t.id}"
                title="${t.label} — ${t.scene}" aria-label="${t.label}"
                aria-pressed="${t.id === activeOnModelId}"><canvas width="112" height="168"></canvas></button>`).join('');
      host.querySelectorAll('.on-model-card').forEach(btn => {
        btn.addEventListener('click', async () => {
          activeOnModelId = btn.dataset.template;
          host.querySelectorAll('.on-model-card').forEach(b => b.setAttribute('aria-pressed', b === btn));
          const meta = onModelTemplates.find(t => t.id === activeOnModelId);
          if (!meta) return;
          if (canvasLoading) canvasLoading.style.display = 'flex';
          try {
            await loadOnModelTemplate(meta);
            // Sized after the load, not before: the crop is centred on this
            // template's print quad, so a different model is a different rect.
            applyCanvasSizing();
            onModelComposedKey = '';
          } finally { if (canvasLoading) canvasLoading.style.display = 'none'; }
          render();
        });
      });
      repaintOnModelThumbs();
    }

    async function initOnModel() {
      try {
        const res = await fetch('/assets/on-model/templates.json');
        if (!res.ok) return;
        onModelTemplates = await res.json();
        if (onModelTemplates.length) activeOnModelId = onModelTemplates[0].id;
        buildOnModelSelector();
      } catch (e) {
        console.warn('on-model templates unavailable', e);
      }
      document.querySelectorAll('#mockup-style-toggle .style-btn').forEach(btn => {
        btn.addEventListener('click', () => setMockupStyle(btn.dataset.style));
      });
    }

    function render(showHandles = true) {
      if (!isShirtLoaded) return;

      const w = canvas.width;
      const h = canvas.height;

      if (mockupStyle === 'onmodel') {
        // Repaint the picker only when the colour actually changed — render()
        // also runs on every pointer move during a drag.
        if (onModelThumbColour !== shirtColor) {
          onModelThumbColour = shirtColor;
          repaintOnModelThumbs();
        }
        if (drawOnModelScene(ctx, w, h)) return;
      }

      // Draw scene at 1x scale
      drawScene(ctx, w, h, 1, false);

      // 3. Draw Editor Interactive Handles (if requested) — same offset + zoom
      // the scene above was drawn into, so handles land exactly on the artwork.
      if (showHandles) {
        const shirtZoom = getShirtZoom();
        const offsetX = (w - 1000 * shirtZoom) / 2;
        const offsetY = (h - 1000 * shirtZoom) / 2;
        ctx.save();
        ctx.translate(offsetX, offsetY);
        ctx.scale(shirtZoom, shirtZoom);
        if (designImage && selectedElement === 'design') {
          drawEditorHandles();
        }
        drawPropHandles();
        drawSnapGuides();
        ctx.restore();
      }
    }

    // Canva-style center alignment guides, shown while dragging near canvas center
    function drawSnapGuides() {
      if (!activeSnapGuide.x && !activeSnapGuide.y) return;
      ctx.save();
      ctx.strokeStyle = '#ff4d94';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([6, 5]);
      if (activeSnapGuide.x) {
        ctx.beginPath();
        ctx.moveTo(500, 0);
        ctx.lineTo(500, 1000);
        ctx.stroke();
      }
      if (activeSnapGuide.y) {
        ctx.beginPath();
        ctx.moveTo(0, 500);
        ctx.lineTo(1000, 500);
        ctx.stroke();
      }
      ctx.restore();
    }

    // ----------------------------------------------------
    // Selection chrome — one definition, both modes
    // ----------------------------------------------------
    // Canva-style: round white handles at the corners and a rotate button
    // standing off below the box. Sizes are CSS PIXELS ON SCREEN, converted at
    // draw time, because the two modes draw into different spaces — flat lay
    // inside a shirtZoom transform on a 1000px artboard, on-model in raw
    // canvas pixels on an 800x1200 one — and a constant in either space comes
    // out a different physical size in the other. Passing the conversion in is
    // what makes the control genuinely identical rather than merely similar.
    const SEL_HANDLE_R = 6.5;  // corner circle radius
    const SEL_ROT_R = 10;      // rotate button radius
    const SEL_ROT_GAP = 30;    // gap between box and rotate button
    const SEL_LINE = 1.5;      // outline width
    const SEL_COLOUR = '#3b82f6';

    function selCanvasScale() {
      const shown = canvas.clientWidth;
      return shown ? canvas.width / shown : 1;
    }
    // Artboard units per CSS pixel in flat lay: the chrome is drawn inside the
    // shirtZoom transform, so that zoom has to be divided back out.
    function selUnitsFlat() {
      return selCanvasScale() / getShirtZoom();
    }
    // Grab radius in CSS pixels: a fingertip needs far more than the handle
    // shows, and that slack is invisible so it costs the artwork nothing.
    function selGrabCss() {
      const coarse = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
      return coarse ? 24 : 16;
    }

    // A circular arrow, so the control says what it does rather than being a
    // plain dot the user has to discover.
    function drawRotateIcon(c, cx, cy, r, u) {
      c.save();
      c.strokeStyle = SEL_COLOUR;
      c.fillStyle = SEL_COLOUR;
      c.lineWidth = Math.max(1.4 * u, r * 0.26);
      c.lineCap = 'round';
      const a0 = Math.PI * 0.72, a1 = Math.PI * 2.05;
      c.beginPath();
      c.arc(cx, cy, r, a0, a1);
      c.stroke();
      // Arrowhead on the open end, pointing along the tangent there.
      const hx = cx + r * Math.cos(a1), hy = cy + r * Math.sin(a1);
      const t = a1 + Math.PI / 2;
      const s = r * 0.9;
      c.beginPath();
      c.moveTo(hx + s * Math.cos(t), hy + s * Math.sin(t));
      c.lineTo(hx + s * 0.7 * Math.cos(t + 2.3), hy + s * 0.7 * Math.sin(t + 2.3));
      c.lineTo(hx + s * 0.7 * Math.cos(t - 2.3), hy + s * 0.7 * Math.sin(t - 2.3));
      c.closePath();
      c.fill();
      c.restore();
    }

    // corners: four points in the CURRENT drawing space, clockwise from
    // top-left. rot: the rotate button's centre in the same space.
    // u: how many units of that space make one CSS pixel on screen.
    function drawSelectionChrome(c, corners, rot, u) {
      c.save();
      c.strokeStyle = SEL_COLOUR;
      c.lineWidth = SEL_LINE * u;
      c.beginPath();
      c.moveTo(corners[0].x, corners[0].y);
      for (let i = 1; i < 4; i++) c.lineTo(corners[i].x, corners[i].y);
      c.closePath();
      c.stroke();

      const bottom = { x: (corners[2].x + corners[3].x) / 2, y: (corners[2].y + corners[3].y) / 2 };
      c.beginPath();
      c.moveTo(bottom.x, bottom.y);
      c.lineTo(rot.x, rot.y);
      c.stroke();

      c.fillStyle = '#ffffff';
      for (const p of corners) {
        c.beginPath();
        c.arc(p.x, p.y, SEL_HANDLE_R * u, 0, Math.PI * 2);
        c.fill(); c.stroke();
      }
      c.beginPath();
      c.arc(rot.x, rot.y, SEL_ROT_R * u, 0, Math.PI * 2);
      c.fill(); c.stroke();
      drawRotateIcon(c, rot.x, rot.y, SEL_ROT_R * u * 0.52, u);
      c.restore();
    }

    // Draws bounding box outline, scale corners, and rotation handle
    function drawEditorHandles() {
      const { w: dW, h: dH } = getDesignBoxSize(designScale);
      // The chrome is drawn in the rotated local frame so the box follows the
      // design, but sized through selUnitsFlat() so it comes out the same
      // physical size as the on-model one despite the shirtZoom transform.
      const u = selUnitsFlat();
      const rotY = dH / 2 + SEL_ROT_GAP * u;
      ctx.save();
      ctx.translate(designPos.x, designPos.y);
      ctx.rotate(designRotation);
      drawSelectionChrome(ctx, [
        { x: -dW / 2, y: -dH / 2 },
        { x: dW / 2, y: -dH / 2 },
        { x: dW / 2, y: dH / 2 },
        { x: -dW / 2, y: dH / 2 },
      ], { x: 0, y: rotY }, u);
      ctx.restore();
    }

    // ----------------------------------------------------
    // Shared geometry helpers for Canva-style anchored resize & angle snapping
    // ----------------------------------------------------
    const OPPOSITE_CORNER = { tl: 'br', tr: 'bl', br: 'tl', bl: 'tr' };

    function cornerLocalPoint(w, h, corner) {
      switch (corner) {
        case 'tl': return { x: -w / 2, y: -h / 2 };
        case 'tr': return { x: w / 2, y: -h / 2 };
        case 'br': return { x: w / 2, y: h / 2 };
        case 'bl': return { x: -w / 2, y: h / 2 };
      }
    }

    function rotateVec(x, y, rotation) {
      const cos = Math.cos(rotation);
      const sin = Math.sin(rotation);
      return { x: x * cos - y * sin, y: x * sin + y * cos };
    }

    // Snaps to the nearest 15° increment when close, so rotating settles
    // cleanly at 0/15/30/45/... like Canva/PowerPoint, instead of any angle.
    function snapAngleDeg(deg) {
      const nearest = Math.round(deg / ROTATION_SNAP_STEP) * ROTATION_SNAP_STEP;
      return Math.abs(deg - nearest) <= ROTATION_SNAP_THRESHOLD ? nearest : deg;
    }

    function getDesignBoxSize(scale) {
      const baseSize = 500;
      const dAspect = designImage.width / designImage.height;
      let dW = baseSize * scale;
      let dH = baseSize * scale;
      if (dAspect > 1) {
        dH = dW / dAspect;
      } else {
        dW = dH * dAspect;
      }
      return { w: dW, h: dH };
    }

    function getPropTransformMetrics(type) {
      const config = propConfigs[type];
      if (!config) return null;

      const w = config.w;
      const h = config.h;
      const rotation = config.rotation || 0;
      const centerX = config.x + w / 2;
      const centerY = config.y + h / 2;

      const cos = Math.cos(rotation);
      const sin = Math.sin(rotation);

      function localToGlobal(lx, ly) {
        return {
          x: lx * cos - ly * sin + centerX,
          y: lx * sin + ly * cos + centerY
        };
      }

      return {
        width: w,
        height: h,
        center: { x: centerX, y: centerY },
        corners: {
          tl: localToGlobal(-w / 2, -h / 2),
          tr: localToGlobal(w / 2, -h / 2),
          br: localToGlobal(w / 2, h / 2),
          bl: localToGlobal(-w / 2, h / 2)
        },
        // Below the box, through the same constant the design uses, so the two
        // controls put the rotate button in the same place relative to what is
        // being rotated. Hit-testing reads this too, so the grab follows the
        // drawing by construction.
        rot: localToGlobal(0, h / 2 + SEL_ROT_GAP * selUnitsFlat())
      };
    }

    function isPointInsidePropBox(type, cx, cy) {
      const config = propConfigs[type];
      if (!config) return false;
      const metrics = getPropTransformMetrics(type);
      if (!metrics) return false;

      const centerX = config.x + config.w / 2;
      const centerY = config.y + config.h / 2;
      const rotation = config.rotation || 0;

      const tx = cx - centerX;
      const ty = cy - centerY;

      const ux = tx * Math.cos(-rotation) - ty * Math.sin(-rotation);
      const uy = tx * Math.sin(-rotation) + ty * Math.cos(-rotation);

      return (
        ux >= -metrics.width / 2 &&
        ux <= metrics.width / 2 &&
        uy >= -metrics.height / 2 &&
        uy <= metrics.height / 2
      );
    }

    function checkHitProps(cx, cy) {
      const propTypes = Object.keys(activeProps);
      for (let i = propTypes.length - 1; i >= 0; i--) {
        const type = propTypes[i];
        if (activeProps[type]) {
          const config = propConfigs[type];
          if (config.loaded && config.img) {
            if (isPointInsidePropBox(type, cx, cy)) {
              return type;
            }
          }
        }
      }
      return null;
    }

    function checkHitPropHandles(type, cx, cy) {
      const metrics = getPropTransformMetrics(type);
      if (!metrics) return null;
      
      const clickRadius = 30; // hit area in canvas pixels (generous, Canva-style)
      
      // Check rotation handle
      if (Math.hypot(metrics.rot.x - cx, metrics.rot.y - cy) < clickRadius) {
        return { type: 'rotate' };
      }
      
      // Check scale corner handles
      for (const [corner, pt] of Object.entries(metrics.corners)) {
        if (Math.hypot(pt.x - cx, pt.y - cy) < clickRadius) {
          return { type: 'scale', corner: corner };
        }
      }
      return null;
    }

    function drawPropHandles() {
      // 1. Draw selection box & handles for selected prop
      if (selectedElement && selectedElement !== 'design' && activeProps[selectedElement]) {
        const config = propConfigs[selectedElement];
        if (config.loaded && config.img) {
          const metrics = getPropTransformMetrics(selectedElement);
          if (metrics) {
            // The same drawSelectionChrome the design uses, through the same
            // units, rather than a second control that merely resembles it.
            // A prop used to be a dashed box with square corners, a centre dot
            // and the rotate button above, while the print in the middle of the
            // same canvas had a solid box, round corners and rotate below — two
            // gestures to learn for one canvas, and the handles drawn at a fixed
            // pixel size so they grew and shrank with the preset.
            const u = selUnitsFlat();
            ctx.save();
            ctx.translate(metrics.center.x, metrics.center.y);
            ctx.rotate(config.rotation || 0);
            drawSelectionChrome(ctx, [
              { x: -metrics.width / 2, y: -metrics.height / 2 },
              { x: metrics.width / 2, y: -metrics.height / 2 },
              { x: metrics.width / 2, y: metrics.height / 2 },
              { x: -metrics.width / 2, y: metrics.height / 2 },
            ], { x: 0, y: metrics.height / 2 + SEL_ROT_GAP * u }, u);
            ctx.restore();
          }
        }
      }

      // 2. Draw hover outline for hovered prop (only if it's not the selected one)
      if (hoveredPropType && hoveredPropType !== selectedElement && activeProps[hoveredPropType]) {
        const config = propConfigs[hoveredPropType];
        if (config.loaded && config.img) {
          const metrics = getPropTransformMetrics(hoveredPropType);
          if (metrics) {
            ctx.save();
            ctx.translate(metrics.center.x, metrics.center.y);
            ctx.rotate(config.rotation || 0);
            // Hover stays a faint dashed outline — it is a hint, not a control,
            // and must not read as a selection. Same hue as the chrome it
            // precedes, so the two belong to one palette.
            ctx.strokeStyle = SEL_COLOUR;
            ctx.globalAlpha = 0.5;
            ctx.lineWidth = SEL_LINE * selUnitsFlat();
            ctx.setLineDash([4, 3]);
            ctx.strokeRect(-metrics.width / 2, -metrics.height / 2, metrics.width, metrics.height);
            ctx.restore();
          }
        }
      }

      // 3. Draw dragged prop indicator
      if (draggedPropType) {
        const config = propConfigs[draggedPropType];
        const metrics = getPropTransformMetrics(draggedPropType);
        if (metrics) {
          ctx.save();
          ctx.translate(metrics.center.x, metrics.center.y);
          ctx.rotate(config.rotation || 0);
          ctx.strokeStyle = '#008ab3';
          ctx.lineWidth = 2;
          ctx.setLineDash([6, 4]);
          ctx.strokeRect(-metrics.width / 2, -metrics.height / 2, metrics.width, metrics.height);
          ctx.restore();
        }
      }
    }

    // ----------------------------------------------------
    // 6. Interactive Click/Drag Bounding Box Math
    // ----------------------------------------------------
    
    // Calculates coordinates of handles in global canvas space
    function getTransformMetrics() {
      const { w: dW, h: dH } = getDesignBoxSize(designScale);

      const cos = Math.cos(designRotation);
      const sin = Math.sin(designRotation);

      function localToGlobal(lx, ly) {
        return {
          x: lx * cos - ly * sin + designPos.x,
          y: lx * sin + ly * cos + designPos.y
        };
      }

      return {
        width: dW,
        height: dH,
        center: designPos,
        corners: {
          tl: localToGlobal(-dW / 2, -dH / 2),
          tr: localToGlobal(dW / 2, -dH / 2),
          br: localToGlobal(dW / 2, dH / 2),
          bl: localToGlobal(-dW / 2, dH / 2)
        },
        // Below the box, matching the on-model control and the Canva pattern.
        rot: localToGlobal(0, dH / 2 + SEL_ROT_GAP * selUnitsFlat())
      };
    }

    // Checks if canvas click falls inside rotated bounding box
    function isPointInsideBox(cx, cy) {
      if (!designImage) return false;
      const metrics = getTransformMetrics();
      
      // Translate to origin
      const tx = cx - designPos.x;
      const ty = cy - designPos.y;

      // Rotate point inversely to match bounding box alignment
      const ux = tx * Math.cos(-designRotation) - ty * Math.sin(-designRotation);
      const uy = tx * Math.sin(-designRotation) + ty * Math.cos(-designRotation);

      return (
        ux >= -metrics.width / 2 && 
        ux <= metrics.width / 2 && 
        uy >= -metrics.height / 2 && 
        uy <= metrics.height / 2
      );
    }

    // Checks distance to interactive handles
    function checkHitHandles(cx, cy) {
      if (!designImage) return null;
      const metrics = getTransformMetrics();
      const clickRadius = 30; // hit area in canvas pixels (generous, Canva-style)

      function getDist(p1, p2) {
        return Math.sqrt(Math.pow(p1.x - p2, 2) + Math.pow(p1.y - cy, 2));
      }

      // Check rotation handle
      if (Math.hypot(metrics.rot.x - cx, metrics.rot.y - cy) < clickRadius) {
        return { type: 'rotate' };
      }

      // Check scale corner handles
      for (const [corner, pt] of Object.entries(metrics.corners)) {
        if (Math.hypot(pt.x - cx, pt.y - cy) < clickRadius) {
          return { type: 'scale', corner: corner };
        }
      }

      // Check center body drag
      if (isPointInsideBox(cx, cy)) {
        return { type: 'drag' };
      }

      return null;
    }

    // ----------------------------------------------------
    // 7. Mouse/Touch Event Handlers
    // ----------------------------------------------------
    
    // Convert screen coordinates to canvas pixels
    function getCanvasCoords(e) {
      const rect = canvas.getBoundingClientRect();
      const scaleX = canvas.width / rect.width;
      const scaleY = canvas.height / rect.height;

      const clientX = e.touches ? e.touches[0].clientX : e.clientX;
      const clientY = e.touches ? e.touches[0].clientY : e.clientY;

      // Convert screen -> full canvas frame -> centered 0-1000 artboard space,
      // so all drag/resize/rotate math (written for a plain 1000x1000 square)
      // keeps working unchanged regardless of the selected canvas aspect ratio
      // or its shirt zoom.
      const shirtZoom = getShirtZoom();
      const offsetX = (canvas.width - 1000 * shirtZoom) / 2;
      const offsetY = (canvas.height - 1000 * shirtZoom) / 2;

      return {
        x: ((clientX - rect.left) * scaleX - offsetX) / shirtZoom,
        y: ((clientY - rect.top) * scaleY - offsetY) / shirtZoom
      };
    }

    function handleStart(coords) {
      // 1. Check if they clicked on the active selected prop's corner handles or rotation handle
      if (selectedElement && selectedElement !== 'design') {
        const hitPropHandle = checkHitPropHandles(selectedElement, coords.x, coords.y);
        if (hitPropHandle) {
          if (hitPropHandle.type === 'scale') {
            isScalingProp = true;
            activeScaleCorner = hitPropHandle.corner;
            const config = propConfigs[selectedElement];
            startPropWidth = config.w;
            startPropHeight = config.h;
            startPropAspect = config.w / config.h;

            // Pin the opposite corner in world space so resizing anchors there
            // instead of scaling around the center (matches Canva/Figma).
            const centerX = config.x + config.w / 2;
            const centerY = config.y + config.h / 2;
            const rotation = config.rotation || 0;
            const oppCorner = OPPOSITE_CORNER[activeScaleCorner];
            const anchorLocal = cornerLocalPoint(config.w, config.h, oppCorner);
            const anchorRot = rotateVec(anchorLocal.x, anchorLocal.y, rotation);
            anchorWorld = { x: centerX + anchorRot.x, y: centerY + anchorRot.y };
            startDistFromAnchor = Math.hypot(config.w, config.h);
            canvas.style.cursor = 'nwse-resize';
          } else if (hitPropHandle.type === 'rotate') {
            isRotatingProp = true;
            const config = propConfigs[selectedElement];
            startRotation = config.rotation || 0;
            const centerX = config.x + config.w / 2;
            const centerY = config.y + config.h / 2;
            startAngleOffset = Math.atan2(coords.y - centerY, coords.x - centerX);
            canvas.style.cursor = 'grabbing';
          }
          return;
        }
      }

      // 2. Check if they clicked on any active prop to select & drag it
      const hitProp = checkHitProps(coords.x, coords.y);
      if (hitProp) {
        selectedElement = hitProp;
        draggedPropType = hitProp;
        const config = propConfigs[hitProp];
        dragStartOffset.x = coords.x - config.x;
        dragStartOffset.y = coords.y - config.y;
        canvas.style.cursor = 'grabbing';
        render();
        return;
      }

      // 3. Otherwise, check if they clicked on the design handles (or the design itself)
      const hit = checkHitHandles(coords.x, coords.y);
      if (hit) {
        selectedElement = 'design';
        if (hit.type === 'drag') {
          isDragging = true;
          dragStartOffset.x = coords.x - designPos.x;
          dragStartOffset.y = coords.y - designPos.y;
          canvas.style.cursor = 'grabbing';
        } else if (hit.type === 'scale') {
          isScaling = true;
          activeScaleCorner = hit.corner;
          startScale = designScale;

          // Pin the opposite corner in world space (Canva-style anchored resize)
          const { w: dW, h: dH } = getDesignBoxSize(designScale);
          const oppCorner = OPPOSITE_CORNER[activeScaleCorner];
          const anchorLocal = cornerLocalPoint(dW, dH, oppCorner);
          const anchorRot = rotateVec(anchorLocal.x, anchorLocal.y, designRotation);
          anchorWorld = { x: designPos.x + anchorRot.x, y: designPos.y + anchorRot.y };
          startDistFromAnchor = Math.hypot(dW, dH);
          canvas.style.cursor = 'nwse-resize';
        } else if (hit.type === 'rotate') {
          isRotating = true;
          startRotation = designRotation;
          startAngleOffset = Math.atan2(coords.y - designPos.y, coords.x - designPos.x);
          canvas.style.cursor = 'grabbing';
        }
        render();
        return;
      }

      // 4. Clicked on empty canvas space -> deselect all!
      selectedElement = null;
      isDragging = false;
      isScaling = false;
      isRotating = false;
      isScalingProp = false;
      isRotatingProp = false;
      draggedPropType = null;
      render();
      canvas.style.cursor = 'default';
    }

    function handleMove(coords) {
      // 1. If scaling a selected prop — resize anchored on the opposite corner
      if (isScalingProp && selectedElement) {
        const config = propConfigs[selectedElement];
        const currentDist = Math.hypot(coords.x - anchorWorld.x, coords.y - anchorWorld.y);
        const ratio = currentDist / startDistFromAnchor;

        // Maintain aspect ratio, enforce limits (50px to 600px width)
        let newW = Math.max(50, Math.min(600, startPropWidth * ratio));
        let newH = newW / startPropAspect;

        const rotation = config.rotation || 0;
        const oppCorner = OPPOSITE_CORNER[activeScaleCorner];
        const newAnchorLocal = cornerLocalPoint(newW, newH, oppCorner);
        const newAnchorRot = rotateVec(newAnchorLocal.x, newAnchorLocal.y, rotation);
        const newCenterX = anchorWorld.x - newAnchorRot.x;
        const newCenterY = anchorWorld.y - newAnchorRot.y;

        config.x = newCenterX - newW / 2;
        config.y = newCenterY - newH / 2;
        config.w = newW;
        config.h = newH;
        render();
        return;
      }

      // 1b. If rotating a selected prop — snaps to 15° increments like Canva
      if (isRotatingProp && selectedElement) {
        const config = propConfigs[selectedElement];
        const centerX = config.x + config.w / 2;
        const centerY = config.y + config.h / 2;
        const currentAngle = Math.atan2(coords.y - centerY, coords.x - centerX);
        let angleDelta = currentAngle - startAngleOffset;
        let newRotation = startRotation + angleDelta;
        let deg = Math.round(newRotation * (180 / Math.PI));
        if (deg > 180) deg -= 360;
        if (deg < -180) deg += 360;
        config.rotation = snapAngleDeg(deg) * (Math.PI / 180);
        render();
        return;
      }

      // 2. If dragging a prop — snaps to the canvas center like Canva's alignment guides
      if (draggedPropType) {
        const config = propConfigs[draggedPropType];
        // Keep the prop's CENTRE inside the visible frame — the same rule as
        // before, but measured against the canvas instead of the artboard, so
        // a preset that adds canvas also adds somewhere to drag to.
        const view = artboardViewBounds();
        let newX = Math.max(view.minX - config.w / 2, Math.min(view.maxX - config.w / 2, coords.x - dragStartOffset.x));
        let newY = Math.max(view.minY - config.h / 2, Math.min(view.maxY - config.h / 2, coords.y - dragStartOffset.y));

        activeSnapGuide.x = Math.abs(newX + config.w / 2 - 500) < CENTER_SNAP_THRESHOLD;
        if (activeSnapGuide.x) newX = 500 - config.w / 2;
        activeSnapGuide.y = Math.abs(newY + config.h / 2 - 500) < CENTER_SNAP_THRESHOLD;
        if (activeSnapGuide.y) newY = 500 - config.h / 2;

        config.x = newX;
        config.y = newY;
        render();
        return;
      }

      // 3. Update cursor style & handle hover states if no drag/scale is active
      if (!isDragging && !isScaling && !isRotating && !draggedPropType && !isScalingProp && !isRotatingProp) {
        // First check if hovering over selected prop's corner handles or rotation handle
        if (selectedElement && selectedElement !== 'design') {
          const hitPropHandle = checkHitPropHandles(selectedElement, coords.x, coords.y);
          if (hitPropHandle) {
            if (hitPropHandle.type === 'scale') {
              canvas.style.cursor = 'nwse-resize';
            } else if (hitPropHandle.type === 'rotate') {
              canvas.style.cursor = 'alias';
            }
            return;
          }
        }

        // Then check if hovering over any prop body
        const hitProp = checkHitProps(coords.x, coords.y);
        if (hitProp) {
          hoveredPropType = hitProp;
          canvas.style.cursor = 'grab';
          render();
          return;
        } else if (hoveredPropType) {
          hoveredPropType = null;
          canvas.style.cursor = 'default';
          render();
        }

        // Then check if hovering over design handles
        const hit = checkHitHandles(coords.x, coords.y);
        if (hit) {
          if (hit.type === 'drag') canvas.style.cursor = 'grab';
          else if (hit.type === 'scale') canvas.style.cursor = 'nwse-resize';
          else if (hit.type === 'rotate') canvas.style.cursor = 'alias';
        } else {
          canvas.style.cursor = 'default';
        }
        return;
      }

      if (!designImage) return;

      // 4. Drag logo — snaps to the canvas center like Canva's alignment guides
      if (isDragging) {
        let newX = Math.max(100, Math.min(900, coords.x - dragStartOffset.x));
        let newY = Math.max(100, Math.min(900, coords.y - dragStartOffset.y));

        activeSnapGuide.x = Math.abs(newX - 500) < CENTER_SNAP_THRESHOLD;
        if (activeSnapGuide.x) newX = 500;
        activeSnapGuide.y = Math.abs(newY - 500) < CENTER_SNAP_THRESHOLD;
        if (activeSnapGuide.y) newY = 500;

        designPos.x = newX;
        designPos.y = newY;
      }

      // 5. Scale logo — resize anchored on the opposite corner
      if (isScaling) {
        const currentDist = Math.hypot(coords.x - anchorWorld.x, coords.y - anchorWorld.y);
        let ratio = currentDist / startDistFromAnchor;
        let newScale = Math.max(0.1, Math.min(0.9, startScale * ratio));
        designScale = newScale;

        const { w: newDW, h: newDH } = getDesignBoxSize(newScale);
        const oppCorner = OPPOSITE_CORNER[activeScaleCorner];
        const newAnchorLocal = cornerLocalPoint(newDW, newDH, oppCorner);
        const newAnchorRot = rotateVec(newAnchorLocal.x, newAnchorLocal.y, designRotation);
        designPos.x = anchorWorld.x - newAnchorRot.x;
        designPos.y = anchorWorld.y - newAnchorRot.y;

        scaleSlider.value = Math.round(newScale * 100);
        scaleManual.value = Math.round(newScale * 100);
        userHasManuallyScaled = true;
      }

      // 6. Rotate logo — snaps to 15° increments like Canva
      if (isRotating) {
        const currentAngle = Math.atan2(coords.y - designPos.y, coords.x - designPos.x);
        let angleDelta = currentAngle - startAngleOffset;
        let newRotation = startRotation + angleDelta;
        let deg = Math.round(newRotation * (180 / Math.PI));
        if (deg > 180) deg -= 360;
        if (deg < -180) deg += 360;
        deg = snapAngleDeg(deg);
        designRotation = deg * (Math.PI / 180);
        rotateSlider.value = deg;
        rotateManual.value = deg;
      }

      render();
    }

    function handleEnd() {
      isDragging = false;
      isScaling = false;
      isRotating = false;
      isScalingProp = false;
      isRotatingProp = false;
      draggedPropType = null;
      activeSnapGuide.x = false;
      activeSnapGuide.y = false;
      canvas.style.cursor = 'default';
      render();
    }

    // Attach Mouse Events
    // On-model works in the template's own pixel space, not the flat-lay
    // 0-1000 artboard, so it takes the raw event and inverts its own transform.
    canvas.addEventListener('mousedown', (e) => {
      e.preventDefault();
      if (mockupStyle === 'onmodel') { onModelPointerStart(e); return; }
      handleStart(getCanvasCoords(e));
    });
    window.addEventListener('mousemove', (e) => {
      if (mockupStyle === 'onmodel') {
        if (onModelDrag || e.target === canvas) onModelPointerMove(e);
        return;
      }
      handleMove(getCanvasCoords(e));
    });
    window.addEventListener('mouseup', () => {
      if (mockupStyle === 'onmodel') { onModelPointerEnd(); return; }
      handleEnd();
    });

    // Attach Touch Mobile Events
    canvas.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        e.preventDefault();
        if (mockupStyle === 'onmodel') { onModelPointerStart(e); return; }
        handleStart(getCanvasCoords(e));
      }
    });
    window.addEventListener('touchmove', (e) => {
      if (mockupStyle === 'onmodel') { if (onModelDrag) onModelPointerMove(e); return; }
      if (isDragging || isScaling || isRotating || draggedPropType || isScalingProp || isRotatingProp) {
        handleMove(getCanvasCoords(e));
      }
    }, { passive: false });
    window.addEventListener('touchend', () => {
      if (mockupStyle === 'onmodel') { onModelPointerEnd(); return; }
      handleEnd();
    });

    // Global click/touch listener to clear selection when clicking outside
    const handleOutsideClick = (e) => {
      if (mockupStyle === 'onmodel' && onModelSelected &&
          canvas && !canvas.contains(e.target) && !e.target.closest('.sidebar')) {
        onModelSelected = false;
        render();
      }
      if (canvas && !canvas.contains(e.target) &&
          !e.target.closest('.sidebar') &&
          !e.target.closest('.viewport-export-panel') &&
          !e.target.closest('.swatch-panel')) {
        selectedElement = null;
        render();
      }
    };
    window.addEventListener('mousedown', handleOutsideClick);
    window.addEventListener('touchstart', handleOutsideClick);

