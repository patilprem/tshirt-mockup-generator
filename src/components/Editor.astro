  import {
    onModelCache, onModelRelightLut, loadOnModelTemplate,
    buildOnModelComposed, onModelHighlightCanvas, onModelClipCanvas, onModelShadeCanvas, buildDesignBuffer,
  } from '../scripts/onmodel-engine.js';
  import {
    garmentConfigs, garmentView, hasBackView, defaultPropConfigs, loadProp as loadPropImage,
    buildShirtLayers, drawFlatlayBackground, drawProps, drawFlatlayScene,
    designBoxSize, placementToRelative, placementFromRelative, centerChestPlacement,
