---
// Launch-directory badges for the footer brand column.
//
// Plain anchors + <img>, no third-party JS — same rule as KofiSupport.astro, so
// this costs nothing against Core Web Vitals and nothing against the "files
// never leave your browser" claim. The images are hotlinked from the
// directories on purpose: that is how they verify the badge is live. They are
// lazy + async with explicit intrinsic dimensions, so they never block render
// and never shift layout.
//
const BADGES = [
  {
    name: 'LaunchBuff',
    href: 'https://launchbuff.com/products/teemockup-bwx9r2',
    src: 'https://launchbuff.com/badge-featured-dark.svg',
    alt: 'Featured on LaunchBuff',
    width: 256,
    height: 80,
  },
];
---

<div class="launch-badges" aria-label="Featured on">
  {BADGES.map((badge) => (
    <a
      href={badge.href}
      target="_blank"
      rel="noopener noreferrer"
      title={`${badge.alt} (opens in a new tab)`}
      class="launch-badge"
    >
      <img
        src={badge.src}
        alt={badge.alt}
        width={badge.width}
        height={badge.height}
        loading="lazy"
        decoding="async"
      />
    </a>
  ))}
</div>

<style>
  .launch-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 18px;
  }

  .launch-badge {
    display: inline-flex;
    line-height: 0;
    border-radius: var(--radius-md);
    transition: var(--transition-smooth);
  }

  .launch-badge:hover {
    transform: translateY(-1px);
  }

  .launch-badge img {
    width: 100%;
    max-width: 190px;
    height: auto;
  }
</style>
