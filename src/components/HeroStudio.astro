---
// The hero visual: a working mockup studio, not a picture of one.
//
// A visitor lands on a scene that is already set up — cat preset on the shirt,
// controls on the design — and can drag it, resize it, recolour the shirt and
// swap the model without clicking through to anything. On model is the default
// because it is the half of the product competitors cannot show.
//
// The first paint is a static JPEG, the same crop the gallery uses, so the
// largest element on the page is an image the browser can fetch immediately.
// The canvas only replaces it once the engine and its template are ready,
// which keeps the interactivity off the LCP path entirely.
---

<div class="hs" id="hero-studio">
  <div class="hs-frame">
    <!-- LCP element: decoded straight from the network, no JS in the way. -->
    <img
      class="hs-poster"
      id="hs-poster"
      src="/assets/gallery/onmodel_gallery-f.jpg"
      alt="Cat design on a t-shirt worn by a model"
      width="1024"
      height="1024"
      fetchpriority="high"
    />
    <canvas class="hs-canvas" id="hs-canvas" width="800" height="800" aria-label="Interactive t-shirt mockup"></canvas>

    <div class="hs-slab hs-tiles" id="hs-tiles" role="listbox" aria-label="Choose a scene"></div>

    <div class="hs-slab hs-swatches" id="hs-swatches" role="listbox" aria-label="Shirt colour"></div>
  </div>
</div>

<style>
  .hs { position: relative; justify-self: center; width: min(452px, 100%); }
  .hs-frame { position: relative; aspect-ratio: 1; }

  .hs-poster,
  .hs-canvas {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    border-radius: 20px;
    border: 1px solid hsla(210, 25%, 30%, 0.5);
    box-shadow: 0 26px 68px rgba(0, 0, 0, 0.55);
    display: block;
  }
  .hs-poster { object-fit: cover; z-index: 1; }
  /* The canvas sits under the poster until it has something to show, so there
     is never a flash of empty box between the two. */
  .hs-canvas { z-index: 0; opacity: 0; transition: opacity 0.25s ease; touch-action: none; }
  .hs[data-ready] .hs-canvas { z-index: 2; opacity: 1; }
  .hs[data-ready] .hs-poster { opacity: 0; }

  /* One glass slab, three placements. Each straddles an edge — half on the
     mockup, half on the page — with the shadow falling across both, which is
     what makes them read as attached to the artwork. */
  .hs-slab {
    position: absolute; z-index: 3;
    display: flex; align-items: center;
    background: hsla(215, 28%, 9%, 0.86);
    backdrop-filter: blur(14px);
    border: 1px solid hsla(210, 25%, 34%, 0.5);
    box-shadow: 0 8px 26px rgba(0, 0, 0, 0.45);
  }

  .hs-tiles {
    flex-direction: column; width: 68px; padding: 13px 0; gap: 10px;
    justify-content: center; border-radius: 18px;
    right: -34px; top: 50%; transform: translateY(-50%);
  }
  .hs-tiles :global(img) {
    width: 46px; height: 46px; border-radius: 10px; object-fit: cover; cursor: pointer;
    border: 2px solid hsla(210, 25%, 36%, 0.6); opacity: 0.62;
    background: hsla(215, 25%, 16%, 0.6); transition: opacity 0.2s, border-color 0.2s;
  }
  .hs-tiles :global(img[aria-selected='true']) { opacity: 1; border-color: hsl(186, 100%, 55%); }

  .hs-swatches {
    height: 56px; padding: 0 18px; gap: 12px; border-radius: 99px;
    left: 50%; transform: translateX(-50%); bottom: -28px;
  }
  .hs-swatches :global(button) {
    width: 30px; height: 30px; border-radius: 50%; padding: 0; cursor: pointer;
    border: 2px solid transparent; flex: 0 0 auto;
  }
  .hs-swatches :global(button[aria-selected='true']) {
    border-color: hsl(186, 100%, 55%);
    box-shadow: 0 0 0 3px hsla(186, 100%, 42%, 0.25);
  }

  /* A 300px stage leaves 45px to the viewport edge, so a 56px column hanging
     28px out still clears it — the vertical picker survives the phone. */
  @media (max-width: 980px) {
    .hs { width: 300px; margin: 42px auto 26px; }
    .hs-tiles { width: 56px; padding: 11px 0; gap: 8px; border-radius: 15px; right: -28px; }
    .hs-tiles :global(img) { width: 38px; height: 38px; border-radius: 9px; }
    .hs-swatches { height: 48px; padding: 0 14px; gap: 9px; bottom: -24px; }
    .hs-swatches :global(button) { width: 26px; height: 26px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hs-canvas, .hs-poster { transition: none; }
  }
</style>

<script>
  import { initHeroStudio } from '../scripts/hero-studio.js';
  initHeroStudio();
</script>
