---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Page Not Found (404)"
  description="Lost in the fabric folds... The page you are looking for does not exist. Return home or open the mockup generator."
  noindex={true}
>
  <div class="page-hero" style="min-height: calc(100vh - 400px); display: flex; align-items: center; justify-content: center; padding: 80px 24px;">
    <div class="page-hero-inner">
      <nav class="page-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="page-breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">404 Error</span>
      </nav>
      <span class="page-hero-icon" aria-hidden="true" style="font-size: 4.5rem; margin-bottom: 24px; display: inline-block;"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.8 19.6A2 2 0 1 0 14 16H2"/><path d="M17.5 8a2.5 2.5 0 1 1 2 4H2"/><path d="M9.8 4.4A2 2 0 1 1 11 8H2"/></svg></span>
      <h1 style="font-size: clamp(2rem, 6vw, 3.2rem); margin-bottom: 16px;">Lost in the<br /><span class="gradient-text">fabric folds</span></h1>
      <p class="page-hero-sub" style="max-width: 520px; margin: 0 auto 36px; font-size: 1.05rem;">The page you are looking for has vanished, moved, or was never folded into existence. Let's get you back to creating mockups.</p>
      
      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
        <a href="/editor" class="btn-hero-primary" style="display: inline-flex; align-items: center; gap: 8px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          Open Mockup Generator
        </a>
        <a href="/" class="btn-hero-secondary" style="display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--border-glass); border-radius: var(--radius-md); padding: 12px 24px;">
          Go back home
        </a>
      </div>
    </div>
  </div>
</PageLayout>
