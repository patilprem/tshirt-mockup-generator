---
import PageLayout from '../../layouts/PageLayout.astro';

const posts = [
  {
    slug: 'best-free-t-shirt-mockup-generators',
    title: 'Best Free T-Shirt Mockup Generators in 2026 (Honest Comparison)',
    description:
      'Six free mockup generators compared on what actually matters: watermarks, signup walls, export quality, and commercial use — including where each one wins.',
    date: '2026-07-12',
    dateLabel: 'July 12, 2026',
    image: '/assets/banner/blog_comparison.jpg',
    imageAlt: 'Three t-shirt mockups compared: watermarked, free winner with a rosette, and price-tagged',
  },
  {
    slug: 't-shirt-design-placement-size-guide',
    title: 'T-Shirt Design Placement & Size Guide (With Measurements)',
    description:
      'Exactly where to place a design and how big to make it: center chest, left chest, back, and sleeve measurements, plus the file specs print-on-demand providers expect.',
    date: '2026-07-12',
    dateLabel: 'July 12, 2026',
    image: '/assets/banner/blog_placement_guide.jpg',
    imageAlt: 'T-shirt flatlay with a dashed print-area overlay showing placement measurements',
  },
  {
    slug: 'how-to-make-a-t-shirt-mockup-for-free',
    title: 'How to Make a T-Shirt Mockup for Free (No Photoshop Needed)',
    description:
      'Turn a design file into a professional t-shirt mockup in under a minute — free, in your browser, no watermark. A step-by-step guide with placement tips.',
    date: '2026-07-12',
    dateLabel: 'July 12, 2026',
    image: '/assets/banner/blog_howto_mockup.jpg',
    imageAlt: 'A transparent PNG design file being turned into a finished t-shirt mockup on a navy tee',
  },
];

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://freeteemockup.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://freeteemockup.com/blog" }
  ]
};
const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "TeeMockup Blog — Mockup Guides & Tutorials",
  "url": "https://freeteemockup.com/blog",
  "description": "Practical guides on creating t-shirt mockups and selling print-on-demand apparel: design placement, listing images, mockup tools, and more."
};
---

<PageLayout
  title="Mockup Guides & Tutorials"
  description="Practical guides on creating t-shirt mockups and selling print-on-demand apparel: design placement, listing images, mockup tools, and more."
  canonical="https://freeteemockup.com/blog"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(collectionLd)}></script>
  </Fragment>

  <div class="hero-wrap">
    <nav class="page-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="page-breadcrumb-sep" aria-hidden="true">/</span>
      <span aria-current="page">Blog</span>
    </nav>
  </div>

  <div class="page-content-wide">
    <div class="prose" style="max-width: 720px;">
      <h1>Mockup guides &amp; tutorials</h1>
      <p>
        Practical, no-fluff guides on making t-shirt mockups and selling print-on-demand apparel.
        Everything here pairs with the <a href="/editor">free mockup editor</a> — no watermark, no
        signup, runs in your browser.
      </p>

    </div>

    <div class="blog-grid">
      {posts.map((post, i) => (
        <a class="blog-card" href={`/blog/${post.slug}`}>
          <img
            class="blog-card-img"
            src={post.image}
            alt={post.imageAlt}
            width="1200"
            height="630"
            loading={i < 3 ? 'eager' : 'lazy'}
          />
          <div class="blog-card-body">
            <time class="blog-card-date" datetime={post.date}>{post.dateLabel}</time>
            <h2 class="blog-card-title">{post.title}</h2>
            <p class="blog-card-desc">{post.description}</p>
            <span class="blog-card-read">Read guide</span>
          </div>
        </a>
      ))}
    </div>

    <div class="about-cta-block">
      <h2>Skip the reading — try it instead</h2>
      <p>Upload a design and download a finished mockup in under 60 seconds. Free, no signup.</p>
      <a href="/editor" class="btn-hero-primary">Open the Free Mockup Editor</a>
    </div>
  </div>
</PageLayout>
