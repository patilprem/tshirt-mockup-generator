---
import '../styles/global.css';
import '../styles/landing.css';
import FeedbackWidget from '../components/FeedbackWidget.astro';
import HeroStudio from '../components/HeroStudio.astro';
import KofiSupport from '../components/KofiSupport.astro';
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline data-cfasync="false" async src="https://www.googletagmanager.com/gtag/js?id=G-X8VXX3PN94"></script>
    <script is:inline data-cfasync="false">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-X8VXX3PN94');
    </script>
    <script is:inline>
      if (window.location.hostname.endsWith('.pages.dev')) {
        var meta = document.createElement('meta');
        meta.name = 'robots';
        meta.content = 'noindex, nofollow';
        document.head.appendChild(meta);
      }
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>Free T-Shirt Mockup Generator</title>
    <meta name="description" content="Free t-shirt mockup generator — on-model and flat lay. Upload a design, recolour the garment, download a print-ready PNG. No signup, no watermark, commercial use." />
    <link rel="canonical" href="https://freeteemockup.com" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://freeteemockup.com" />
    <meta property="og:title" content="Free T-Shirt Mockup Generator" />
    <meta property="og:description" content="Free t-shirt mockup generator — on-model and flat lay. Upload a design, recolour the garment, download a print-ready PNG. No signup, no watermark, commercial use." />
    <meta property="og:image" content="https://freeteemockup.com/og-image.png" />
    <meta property="og:site_name" content="TeeMockup" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Free T-Shirt Mockup Generator" />
    <meta name="twitter:description" content="Free t-shirt mockup generator — on-model and flat lay. Upload a design, recolour the garment, download a print-ready PNG. No signup, no watermark, commercial use." />
    <meta name="twitter:image" content="https://freeteemockup.com/og-image.png" />

    <!-- SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="free tshirt mockup generator, tshirt mockup generator, ai tshirt mockup generator, tshirt mockup generator online, free tshirt mockup generator online, best free tshirt mockup generator, tshirt mockup generator free" />
    <meta name="author" content="TeeMockup" />

    <!-- JSON-LD: SoftwareApplication -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "TeeMockup",
      "operatingSystem": "Web",
      "applicationCategory": "DesignApplication",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Free t-shirt mockup generator with two styles: on-model photography and styled flat lay. Upload your design, recolour the garment, and download a print-ready PNG — no signup, no watermark.",
      "url": "https://freeteemockup.com",
      "featureList": [
        "Free tshirt mockup generator — no signup required",
        "AI tshirt mockup generator with 3D fabric fold shading",
        "Tshirt mockup generator online — runs in your browser",
        "On-model mockups: photographed models, recoloured to any shade with the photo\u2019s own folds kept",
        "Flat lay mockups on wood, solid or transparent backgrounds",
        "Garment types: crewneck, hoodie, polo, long sleeve, sweatshirt, V-neck, ladies tee, tank top",
        "Color presets plus a full HSV color picker",
        "Drag, scale, rotate design placement",
        "Flatlay aesthetic props",
        "Export at the sizes Etsy, Shopify and Instagram expect",
        "PNG export, no watermark, commercial use"
      ]
    }
    </script>

    <!-- JSON-LD: FAQPage -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who is TeeMockup for?",
          "acceptedAnswer": { "@type": "Answer", "text": "TeeMockup is perfect for print-on-demand sellers, Etsy sellers, Shopify store owners, T-shirt designers, and clothing brands." }
        },
        {
          "@type": "Question",
          "name": "Why use TeeMockup?",
          "acceptedAnswer": { "@type": "Answer", "text": "TeeMockup is free to use, requires no signup, adds no watermark, allows commercial use, and gives you high quality PNG downloads with fast, private, browser-based creation." }
        },
        {
          "@type": "Question",
          "name": "What mockup types are supported?",
          "acceptedAnswer": { "@type": "Answer", "text": "Two mockup styles. On-model puts your design on a real photographed person, across scenes from urban street and park path to gallery and cozy home. Flat lay lays the garment out with props, across crewneck t-shirts, hoodies, polo shirts, long sleeves, sweatshirts, v-necks, ladies tees, and tank tops." }
        },
        {
          "@type": "Question",
          "name": "Can I export multiple mockups at once?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Batch Export creates every combination of your selected garments and fabric colors as a ZIP of PNGs in one click, or renders many uploaded designs on a single template. It is completely free with no watermark." }
        },
        {
          "@type": "Question",
          "name": "Is TeeMockup free?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, TeeMockup is completely free to use with no hidden costs." }
        },
        {
          "@type": "Question",
          "name": "Does TeeMockup add watermarks?",
          "acceptedAnswer": { "@type": "Answer", "text": "No, we never add watermarks to your downloaded mockups." }
        },
        {
          "@type": "Question",
          "name": "Can I use mockups commercially?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, you can use all generated mockups for commercial purposes." }
        },
        {
          "@type": "Question",
          "name": "Do I need to sign up?",
          "acceptedAnswer": { "@type": "Answer", "text": "No signup or account creation is required." }
        },
        {
          "@type": "Question",
          "name": "Are uploaded designs stored?",
          "acceptedAnswer": { "@type": "Answer", "text": "No, your designs are never stored on our servers. Everything runs locally in your browser." }
        },
        {
          "@type": "Question",
          "name": "What file format can I download?",
          "acceptedAnswer": { "@type": "Answer", "text": "Your mockups are downloaded as high-quality PNG files." }
        }
      ]
    }
    </script>
  </head>

  <body class="landing-body">

    <!-- NAV -->
    <nav class="landing-nav" aria-label="Main navigation">
      <div class="nav-inner">
        <a href="/" class="nav-logo" aria-label="TeeMockup home">
          <img src="/favicon-96x96.png" class="logo-icon" alt="" aria-hidden="true" />
          <span class="logo-text">TeeMockup</span>
          <span class="logo-badge">Free</span>
        </a>
        <ul class="nav-links" role="list">
          <li><a href="#how-it-works">How it Works</a></li>
          <li><a href="#faq">FAQ</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
        <a href="/editor" class="nav-cta" id="nav-launch-btn">Launch Editor →</a>
        <button class="nav-hamburger" id="nav-hamburger" aria-label="Toggle menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="nav-mobile-menu" id="nav-mobile-menu" aria-hidden="true">
        <a href="#how-it-works">How it Works</a>
        <a href="#faq">FAQ</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/editor" class="nav-cta-mobile">Launch Editor →</a>
      </div>
    </nav>

    <main id="main-content">

      <!-- ─── HERO ─── -->
      <section class="hero" aria-labelledby="hero-headline">
        <div class="hero-blob hero-blob-1" aria-hidden="true"></div>
        <div class="hero-blob hero-blob-2" aria-hidden="true"></div>
        <div class="hero-blob hero-blob-3" aria-hidden="true"></div>

        <div class="hero-content">

          <h1 id="hero-headline" class="hero-headline">
            Create Professional<br />
            <span class="gradient-text">T-Shirt Mockups in Seconds</span>
          </h1>

          <p class="hero-sub">
            Skip expensive photoshoots. Upload your design, customize your shirt, and generate high-quality mockups ready for ecommerce, print-on-demand, and social media.
          </p>

          <div class="hero-actions">
            <a href="/editor" class="btn-hero-primary" id="hero-cta-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              Use my own design
            </a>
            <a href="#how-it-works" class="btn-hero-secondary" id="hero-how-btn">
              See how it works
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
          </div>

          <div class="hero-cta-checklist">
            <span class="checklist-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              No Watermarks
            </span>
            <span class="checklist-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Unlimited Mockups
            </span>
            <span class="checklist-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Commercial Use
            </span>
          </div>
        </div>

        <!-- Hero visual: the real mockup studio, running the on-model engine -->
        <HeroStudio />

      </section>

      <!-- ─── GALLERY SHOWCASE (INSPIRATION) ─── -->
      <section class="gallery-section" aria-labelledby="gallery-heading">
        <div class="gallery-inner">
          <div class="gallery-header">
            <div class="section-tag">Showcase</div>
            <h2 id="gallery-heading" class="gallery-title">Your designs + our mockups = <br /><span class="gradient-text">endless possibilities</span></h2>
            <div class="counter-container">
              <div class="live-indicator">
                <span class="live-dot"></span>
                <span>Live</span>
              </div>
              <span class="counter-label">Mockups created:</span>
              <span class="counter-value" id="mockup-counter">980+</span>
            </div>
          </div>
          
          <!-- Marquee rows scrolling in alternate directions -->
          <div class="marquee-container" aria-label="Mockups showcase marquee">
            <!-- Row 1: Left scrolling -->
            <div class="marquee-row">
              <div class="marquee-track">
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/mockup_youtube.webp" type="image/webp" /><img src="/assets/gallery/mockup_youtube.jpg" alt="Don't Worry I Got This T-Shirt Mockup" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/mockup_mountain.webp" type="image/webp" /><img src="/assets/gallery/mockup_mountain.jpg" alt="Minimal Mountain Tank Top Mockup" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/mockup_cat.webp" type="image/webp" /><img src="/assets/gallery/mockup_cat.jpg" alt="Retro Cat Hoodie Mockup" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/mockup_creative.webp" type="image/webp" /><img src="/assets/gallery/mockup_creative.jpg" alt="Creative Studio Sweatshirt Mockup" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/mockup_dragon.webp" type="image/webp" /><img src="/assets/gallery/mockup_dragon.jpg" alt="Dragon & Book T-Shirt Mockup" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/mockup_texas.webp" type="image/webp" /><img src="/assets/gallery/mockup_texas.jpg" alt="Texas Long Sleeve Mockup" loading="lazy" /></picture>
                </div>
                <!-- Duplicate for seamless looping -->
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/mockup_youtube.webp" type="image/webp" /><img src="/assets/gallery/mockup_youtube.jpg" alt="Don't Worry I Got This T-Shirt Mockup" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/mockup_mountain.webp" type="image/webp" /><img src="/assets/gallery/mockup_mountain.jpg" alt="Minimal Mountain Tank Top Mockup" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/mockup_cat.webp" type="image/webp" /><img src="/assets/gallery/mockup_cat.jpg" alt="Retro Cat Hoodie Mockup" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/mockup_creative.webp" type="image/webp" /><img src="/assets/gallery/mockup_creative.jpg" alt="Creative Studio Sweatshirt Mockup" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/mockup_dragon.webp" type="image/webp" /><img src="/assets/gallery/mockup_dragon.jpg" alt="Dragon & Book T-Shirt Mockup" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/mockup_texas.webp" type="image/webp" /><img src="/assets/gallery/mockup_texas.jpg" alt="Texas Long Sleeve Mockup" loading="lazy" /></picture>
                </div>
              </div>
            </div>

            <!-- Row 2: Right scrolling — on-model mockups, cropped to the
                 editor's 1:1 preset so they sit square alongside row 1 -->
            <div class="marquee-row marquee-row-reverse">
              <div class="marquee-track">
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_gallery-f.webp" type="image/webp" /><img src="/assets/gallery/onmodel_gallery-f.jpg" alt="Big Dreams Big Actions T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_livingroom-m.webp" type="image/webp" /><img src="/assets/gallery/onmodel_livingroom-m.jpg" alt="Cat on the Moon T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_bright-airy-f.webp" type="image/webp" /><img src="/assets/gallery/onmodel_bright-airy-f.jpg" alt="Keep Calm and Drink Coffee T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_street-m.webp" type="image/webp" /><img src="/assets/gallery/onmodel_street-m.jpg" alt="Dope Retro T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_miami-f.webp" type="image/webp" /><img src="/assets/gallery/onmodel_miami-f.jpg" alt="Meow Cat Poster T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_park-m.webp" type="image/webp" /><img src="/assets/gallery/onmodel_park-m.jpg" alt="Take a Hike Retro T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_home-f.webp" type="image/webp" /><img src="/assets/gallery/onmodel_home-f.jpg" alt="Minimal Mountain Sunrise T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
                <!-- Duplicate for seamless looping -->
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_gallery-f.webp" type="image/webp" /><img src="/assets/gallery/onmodel_gallery-f.jpg" alt="Big Dreams Big Actions T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_livingroom-m.webp" type="image/webp" /><img src="/assets/gallery/onmodel_livingroom-m.jpg" alt="Cat on the Moon T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_bright-airy-f.webp" type="image/webp" /><img src="/assets/gallery/onmodel_bright-airy-f.jpg" alt="Keep Calm and Drink Coffee T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_street-m.webp" type="image/webp" /><img src="/assets/gallery/onmodel_street-m.jpg" alt="Dope Retro T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_miami-f.webp" type="image/webp" /><img src="/assets/gallery/onmodel_miami-f.jpg" alt="Meow Cat Poster T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_park-m.webp" type="image/webp" /><img src="/assets/gallery/onmodel_park-m.jpg" alt="Take a Hike Retro T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
                <div class="marquee-item">
                  <picture><source srcset="/assets/gallery/webp/onmodel_home-f.webp" type="image/webp" /><img src="/assets/gallery/onmodel_home-f.jpg" alt="Minimal Mountain Sunrise T-Shirt Mockup on Model" loading="lazy" /></picture>
                </div>
              </div>
            </div>
          </div>
          <div class="gallery-cta-wrapper" style="text-align: center; margin-top: 40px; margin-bottom: 20px;">
            <a href="/editor" class="btn-hero-primary">Create Your Free Mockup Now</a>
          </div>
        </div>
      </section>

      <!-- ─── HOW IT WORKS ─── -->
      <section class="section how-section" id="how-it-works" aria-labelledby="how-heading">
        <div class="section-inner how-inner">
          <div class="how-header">
            <div class="section-tag">How it Works</div>
            <h2 id="how-heading" class="section-title">Your design on a real model<br /><span class="gradient-text">or a styled flat lay</span></h2>
            <p class="section-subtitle">
              No photoshoot to book, no models to hire, no Photoshop licence. Upload your artwork and
              see it worn by a real person or laid out flat with props — in about a minute, in your
              browser. Then download a print-ready PNG and list it the same day.
            </p>
          </div>
          <ol class="steps-list" aria-label="Steps to create a mockup">
            <li class="step-item">
              <div class="step-content">
                <div class="step-number" aria-hidden="true">01</div>
                <div class="step-icon" aria-hidden="true"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z"/><circle cx="12" cy="13" r="3"/></svg></div>
                <h3>Pick On-Model or Flat Lay</h3>
                <p>Put your design on a photographed model, or lay the garment out flat with props. One tap switches between them.</p>
              </div>
              <div class="step-arrow" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            </li>
            <li class="step-item">
              <div class="step-content">
                <div class="step-number" aria-hidden="true">02</div>
                <div class="step-icon" aria-hidden="true"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z"/><circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/></svg></div>
                <h3>Drop In Your Design</h3>
                <p>Drag and drop a PNG or JPG — the background is keyed out for you. Move, resize, rotate, recolour. On a model, the photo's real folds and shadows stay.</p>
              </div>
              <div class="step-arrow" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            </li>
            <li class="step-item">
              <div class="step-content">
                <div class="step-number" aria-hidden="true">03</div>
                <div class="step-icon" aria-hidden="true"><svg class="lc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/></svg></div>
                <h3>Download and List It</h3>
                <p>Export at the size Etsy, Shopify or Instagram expects. No email, no login, no watermark — cleared for commercial use.</p>
              </div>
            </li>
          </ol>
          <div class="how-cta">
            <a href="/editor" class="btn-hero-primary" id="how-cta-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              Try It Now — It's Free
            </a>
          </div>
        </div>
      </section>

      <!-- ─── Batch Export (new feature) ─── -->
      <section class="section batch-section" id="batch-export" aria-labelledby="batch-heading">
        <div class="section-inner">
