---
import '../styles/global.css';
import '../styles/landing.css';
import FeedbackWidget from '../components/FeedbackWidget.astro';
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline data-cfasync="false" async src="https://www.googletagmanager.com/gtag/js?id=G-X8VXX3PN94"></script>
    <script is:inline data-cfasync="false">
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-X8VXX3PN94');
    </script>
    <script is:inline>
      if (window.location.hostname.endsWith('.pages.dev')) {
        var meta = document.createElement('meta');
        meta.name = 'robots';
        meta.content = 'noindex, nofollow';
        document.head.appendChild(meta);
      }
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary SEO -->
    <title>Free T-Shirt Mockup Generator</title>
    <meta name="description" content="Create stunning T-shirt mockups for free! Upload your image, customize your design, and download your unique T-shirt as a PNG in no time!" />
    <link rel="canonical" href="https://freeteemockup.com" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://freeteemockup.com" />
    <meta property="og:title" content="Free T-Shirt Mockup Generator" />
    <meta property="og:description" content="Create stunning T-shirt mockups for free! Upload your image, customize your design, and download your unique T-shirt as a PNG in no time!" />
    <meta property="og:image" content="https://freeteemockup.com/og-image.png" />
    <meta property="og:site_name" content="TeeMockup" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Free T-Shirt Mockup Generator" />
    <meta name="twitter:description" content="Create stunning T-shirt mockups for free! Upload your image, customize your design, and download your unique T-shirt as a PNG in no time!" />
    <meta name="twitter:image" content="https://freeteemockup.com/og-image.png" />

    <!-- SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="free tshirt mockup generator, tshirt mockup generator, ai tshirt mockup generator, tshirt mockup generator online, free tshirt mockup generator online, best free tshirt mockup generator, tshirt mockup generator free" />
    <meta name="author" content="TeeMockup" />

    <!-- JSON-LD: SoftwareApplication -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "TeeMockup",
      "operatingSystem": "Web",
      "applicationCategory": "DesignApplication",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "The best free tshirt mockup generator online. Upload your design, pick a color, and download a 1000px PNG — no signup, no watermark. AI 3D fabric fold engine, 8 garment types.",
      "url": "https://freeteemockup.com",
      "featureList": [
        "Free tshirt mockup generator — no signup required",
        "AI tshirt mockup generator with 3D fabric fold shading",
        "Tshirt mockup generator online — runs in your browser",
        "8 garment types: crewneck, hoodie, polo, long sleeve, sweatshirt, V-neck, ladies tee, tank top",
        "120 color presets + full HSV color picker",
        "Drag, scale, rotate design placement",
        "Flatlay aesthetic props",
        "1000×1000px PNG export, no watermark"
      ]
    }
    </script>

    <!-- JSON-LD: FAQPage -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Who is TeeMockup for?",
          "acceptedAnswer": { "@type": "Answer", "text": "TeeMockup is perfect for print-on-demand sellers, Etsy sellers, Shopify store owners, T-shirt designers, and clothing brands." }
        },
        {
          "@type": "Question",
          "name": "Why use TeeMockup?",
          "acceptedAnswer": { "@type": "Answer", "text": "TeeMockup is free to use, requires no signup, adds no watermark, allows commercial use, and gives you high quality PNG downloads with fast, private, browser-based creation." }
        },
        {
          "@type": "Question",
          "name": "What mockup types are supported?",
          "acceptedAnswer": { "@type": "Answer", "text": "We support crewneck t-shirts, hoodies, polo shirts, long sleeves, sweatshirts, v-necks, ladies tees, and tank tops." }
        },
        {
          "@type": "Question",
          "name": "Can I export multiple mockups at once?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Batch Export creates every combination of your selected garments and fabric colors as a ZIP of PNGs in one click, or renders many uploaded designs on a single template. It is completely free with no watermark." }
        },
        {
          "@type": "Question",
          "name": "Is TeeMockup free?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, TeeMockup is completely free to use with no hidden costs." }
        },
        {
          "@type": "Question",
          "name": "Does TeeMockup add watermarks?",
          "acceptedAnswer": { "@type": "Answer", "text": "No, we never add watermarks to your downloaded mockups." }
        },
        {
          "@type": "Question",
          "name": "Can I use mockups commercially?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, you can use all generated mockups for commercial purposes." }
        },
        {
          "@type": "Question",
          "name": "Do I need to sign up?",
          "acceptedAnswer": { "@type": "Answer", "text": "No signup or account creation is required." }
        },
        {
          "@type": "Question",
          "name": "Are uploaded designs stored?",
          "acceptedAnswer": { "@type": "Answer", "text": "No, your designs are never stored on our servers. Everything runs locally in your browser." }
        },
        {
          "@type": "Question",
          "name": "What file format can I download?",
          "acceptedAnswer": { "@type": "Answer", "text": "Your mockups are downloaded as high-quality PNG files." }
        }
      ]
    }
    </script>
  </head>

  <body class="landing-body">

    <!-- NAV -->
    <nav class="landing-nav" aria-label="Main navigation">
      <div class="nav-inner">
        <a href="/" class="nav-logo" aria-label="TeeMockup home">
          <img src="/favicon-96x96.png" class="logo-icon" alt="" aria-hidden="true" />
          <span class="logo-text">TeeMockup</span>
          <span class="logo-badge">Free</span>
        </a>
        <ul class="nav-links" role="list">
          <li><a href="#how-it-works">How it Works</a></li>
          <li><a href="#faq">FAQ</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
        <a href="/editor" class="nav-cta" id="nav-launch-btn">Launch Editor →</a>
        <button class="nav-hamburger" id="nav-hamburger" aria-label="Toggle menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="nav-mobile-menu" id="nav-mobile-menu" aria-hidden="true">
        <a href="#how-it-works">How it Works</a>
        <a href="#faq">FAQ</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/editor" class="nav-cta-mobile">Launch Editor →</a>
      </div>
    </nav>

    <main id="main-content">

      <!-- ─── HERO ─── -->
      <section class="hero" aria-labelledby="hero-headline">
        <div class="hero-blob hero-blob-1" aria-hidden="true"></div>
        <div class="hero-blob hero-blob-2" aria-hidden="true"></div>
        <div class="hero-blob hero-blob-3" aria-hidden="true"></div>

        <div class="hero-content">

          <h1 id="hero-headline" class="hero-headline">
            Create Professional<br />
            <span class="gradient-text">T-Shirt Mockups in Seconds</span>
          </h1>

          <p class="hero-sub">
            Skip expensive photoshoots. Upload your design, customize your shirt, and generate high-quality mockups ready for ecommerce, print-on-demand, and social media.
          </p>

          <div class="hero-actions">
            <a href="/editor" class="btn-hero-primary" id="hero-cta-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              Generate Free Mockup
            </a>
            <a href="#how-it-works" class="btn-hero-secondary" id="hero-how-btn">
              See how it works
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
          </div>

          <div class="hero-cta-checklist">
            <span class="checklist-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              No Watermarks
            </span>
            <span class="checklist-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Unlimited Mockups
            </span>
            <span class="checklist-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Commercial Use
            </span>
          </div>
        </div>

        <!-- Hero visual: Interactive Flatlay Mockup Scene -->
        <div class="hero-visual" aria-hidden="true">
          <div class="hero-flatlay-container" id="hero-flatlay-scene">
            <div class="flatlay-mockup-wrap">
              <canvas id="hero-shirt-canvas" width="600" height="600"></canvas>
            </div>
            <div class="flatlay-prop prop-plant" id="hero-prop-plant">
              <img src="/assets/props/prop_plant.png" class="prop-img-float-1" alt="" />
            </div>
            <div class="flatlay-prop prop-sunglasses" id="hero-prop-sunglasses">
              <div style="transform: rotate(-10deg);">
                <img src="/assets/props/prop_sunglasses.png" class="prop-img-float-2" alt="" />
              </div>
            </div>
            <div class="flatlay-prop prop-shoes" id="hero-prop-shoes">
              <img src="/assets/props/prop_shoes.png" class="prop-img-float-3" alt="" />
            </div>
            <div class="flatlay-prop prop-jeans" id="hero-prop-jeans">
              <img src="/assets/props/prop_jeans.png" class="prop-img-float-4" alt="" />
            </div>
          </div>
        </div>
      </section>

      <!-- ─── GALLERY SHOWCASE (INSPIRATION) ─── -->
      <section class="gallery-section" aria-labelledby="gallery-heading">
        <div class="gallery-inner">
          <div class="gallery-header">
            <div class="section-tag">Showcase</div>
            <h2 id="gallery-heading" class="gallery-title">Your designs + our mockups = <br /><span class="gradient-text">endless possibilities</span></h2>
            <div class="counter-container">
              <div class="live-indicator">
                <span class="live-dot"></span>
                <span>Live</span>
              </div>
              <span class="counter-label">Mockups created:</span>
              <span class="counter-value" id="mockup-counter">980+</span>
            </div>
          </div>
          
          <!-- Marquee rows scrolling in alternate directions -->
          <div class="marquee-container" aria-label="Mockups showcase marquee">
            <!-- Row 1: Left scrolling -->
            <div class="marquee-row">
              <div class="marquee-track">
                <div class="marquee-item">
                  <img src="/assets/gallery/mockup_youtube.jpg" alt="Don't Worry I Got This T-Shirt Mockup" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/mockup_mountain.jpg" alt="Minimal Mountain Tank Top Mockup" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/mockup_cat.jpg" alt="Retro Cat Hoodie Mockup" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/mockup_creative.jpg" alt="Creative Studio Sweatshirt Mockup" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/mockup_dragon.jpg" alt="Dragon & Book T-Shirt Mockup" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/mockup_texas.jpg" alt="Texas Long Sleeve Mockup" loading="lazy" />
                </div>
                <!-- Duplicate for seamless looping -->
                <div class="marquee-item">
                  <img src="/assets/gallery/mockup_youtube.jpg" alt="Don't Worry I Got This T-Shirt Mockup" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/mockup_mountain.jpg" alt="Minimal Mountain Tank Top Mockup" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/mockup_cat.jpg" alt="Retro Cat Hoodie Mockup" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/mockup_creative.jpg" alt="Creative Studio Sweatshirt Mockup" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/mockup_dragon.jpg" alt="Dragon & Book T-Shirt Mockup" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/mockup_texas.jpg" alt="Texas Long Sleeve Mockup" loading="lazy" />
                </div>
              </div>
            </div>

            <!-- Row 2: Right scrolling — on-model mockups, cropped to the
                 editor's 1:1 preset so they sit square alongside row 1 -->
            <div class="marquee-row marquee-row-reverse">
              <div class="marquee-track">
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_gallery-f.jpg" alt="Big Dreams Big Actions T-Shirt Mockup on Model" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_livingroom-m.jpg" alt="Cat on the Moon T-Shirt Mockup on Model" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_bright-airy-f.jpg" alt="Keep Calm and Drink Coffee T-Shirt Mockup on Model" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_street-m.jpg" alt="Dope Retro T-Shirt Mockup on Model" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_miami-f.jpg" alt="Meow Cat Poster T-Shirt Mockup on Model" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_park-m.jpg" alt="Take a Hike Retro T-Shirt Mockup on Model" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_home-f.jpg" alt="Minimal Mountain Sunrise T-Shirt Mockup on Model" loading="lazy" />
                </div>
                <!-- Duplicate for seamless looping -->
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_gallery-f.jpg" alt="Big Dreams Big Actions T-Shirt Mockup on Model" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_livingroom-m.jpg" alt="Cat on the Moon T-Shirt Mockup on Model" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_bright-airy-f.jpg" alt="Keep Calm and Drink Coffee T-Shirt Mockup on Model" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_street-m.jpg" alt="Dope Retro T-Shirt Mockup on Model" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_miami-f.jpg" alt="Meow Cat Poster T-Shirt Mockup on Model" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_park-m.jpg" alt="Take a Hike Retro T-Shirt Mockup on Model" loading="lazy" />
                </div>
                <div class="marquee-item">
                  <img src="/assets/gallery/onmodel_home-f.jpg" alt="Minimal Mountain Sunrise T-Shirt Mockup on Model" loading="lazy" />
                </div>
              </div>
            </div>
          </div>
          <div class="gallery-cta-wrapper" style="text-align: center; margin-top: 40px; margin-bottom: 20px;">
            <a href="/editor" class="btn-hero-primary">Create Your Free Mockup Now</a>
          </div>
        </div>
      </section>

      <!-- ─── HOW IT WORKS ─── -->
      <section class="section how-section" id="how-it-works" aria-labelledby="how-heading">
        <div class="section-inner how-inner">
          <div class="how-header">
            <div class="section-tag">How it Works</div>
            <h2 id="how-heading" class="section-title">From blank to mockup<br /><span class="gradient-text">in under 60 seconds</span></h2>
          </div>
          <ol class="steps-list" aria-label="Steps to create a mockup">
            <li class="step-item">
              <div class="step-content">
                <div class="step-number" aria-hidden="true">01</div>
                <div class="step-icon" aria-hidden="true">👕</div>
                <h3>Choose Your Garment</h3>
                <p>Pick from 8 professionally photographed garments — crewneck, hoodie, polo, long sleeve, sweatshirt, V-neck, ladies tee, or tank top.</p>
              </div>
              <div class="step-arrow" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            </li>
            <li class="step-item">
              <div class="step-content">
                <div class="step-number" aria-hidden="true">02</div>
                <div class="step-icon" aria-hidden="true">🎨</div>
                <h3>Upload &amp; Position Design</h3>
                <p>Drag-and-drop your PNG or JPG. Reposition with drag, resize with corner handles, rotate freely — background auto-removed.</p>
              </div>
              <div class="step-arrow" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </div>
            </li>
            <li class="step-item">
              <div class="step-content">
                <div class="step-number" aria-hidden="true">03</div>
                <div class="step-icon" aria-hidden="true">📥</div>
                <h3>Download Mockup</h3>
                <p>Hit Download — get a 1000×1000px PNG instantly. No email, no login, no waiting. Ready for Etsy, Shopify, or social media.</p>
              </div>
            </li>
          </ol>
          <div class="how-cta">
            <a href="/editor" class="btn-hero-primary" id="how-cta-btn">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              Try It Now — It's Free
            </a>
          </div>
        </div>
      </section>

      <!-- ─── Batch Export (new feature) ─── -->
      <section class="section batch-section" id="batch-export" aria-labelledby="batch-heading">
        <div class="section-inner">
          <div class="section-tag batch-tag"><span class="batch-new-badge">New</span> Batch Export</div>
          <h2 id="batch-heading" class="section-title">One design on every garment.<br /><span class="gradient-text">Or every design on one.</span></h2>
          <p class="section-subtitle" style="max-width:560px;margin:0 auto 2.5rem;">
            Tick your garments and colors — or drop in up to 100 designs. Every mockup downloads as one ZIP. Free.
          </p>

          <div class="batch-strip" role="img" aria-label="The same surf design batch-exported onto a navy crewneck tee, a sand hoodie, and a white tank top">
            <figure class="batch-strip-card">
              <img src="/assets/batch/batch_crewneck_navy.jpg" width="640" height="640" loading="lazy" alt="Surf club design on a navy crewneck t-shirt mockup" />
            </figure>
            <figure class="batch-strip-card batch-strip-card-mid">
              <img src="/assets/batch/batch_hoodie_sand.jpg" width="640" height="640" loading="lazy" alt="Surf club design on a sand beige hoodie mockup" />
            </figure>
            <figure class="batch-strip-card">
              <img src="/assets/batch/batch_tank_white.jpg" width="640" height="640" loading="lazy" alt="Surf club design on a white tank top mockup" />
            </figure>
            <span class="batch-strip-chip" aria-hidden="true">&times;9 in one click</span>
          </div>

          <div class="hero-cta-checklist batch-checklist">
            <span class="checklist-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              All Variants in One ZIP
            </span>
            <span class="checklist-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Up to 100 Designs at Once
            </span>
            <span class="checklist-item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              Free, No Watermark
            </span>
          </div>

          <a href="/editor" class="btn-hero-primary batch-cta" id="batch-cta-btn">
            Try Batch Export →
          </a>
        </div>
      </section>

      <!-- ─── Mockup Types (internal links) ─── -->
      <section class="section garment-links-section" id="mockup-types" aria-labelledby="garment-links-heading">
        <div class="section-inner">
          <div class="section-tag">Mockup Types</div>
          <h2 id="garment-links-heading" class="section-title">A free generator for<br /><span class="gradient-text">every garment</span></h2>
          <p class="section-subtitle" style="max-width:640px;margin:0 auto 2.5rem;">Pick your garment and jump straight into the editor — no watermark, no signup. Each one exports an instant 1000×1000 PNG for commercial use.</p>
          <div class="garment-links-grid">
            <a href="/crewneck-mockup-generator" class="garment-link-card"><span class="garment-link-icon" aria-hidden="true">👕</span><span class="garment-link-name">Crewneck Tee</span></a>
            <a href="/hoodie-mockup-generator" class="garment-link-card"><span class="garment-link-icon" aria-hidden="true">🧥</span><span class="garment-link-name">Hoodie</span></a>
