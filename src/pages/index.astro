    <script>
      // Smooth scroll
      document.querySelectorAll('a[href^="#"]').forEach(link => {
        link.addEventListener('click', e => {
          const target = document.querySelector(link.getAttribute('href'));
          if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
        });
      });

      // Mobile nav
      const hamburger = document.getElementById('nav-hamburger');
      const mobileMenu = document.getElementById('nav-mobile-menu');
      hamburger?.addEventListener('click', () => {
        const isOpen = mobileMenu.classList.toggle('open');
        hamburger.setAttribute('aria-expanded', isOpen.toString());
        mobileMenu.setAttribute('aria-hidden', (!isOpen).toString());
      });
      mobileMenu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu.classList.remove('open');
          hamburger?.setAttribute('aria-expanded', 'false');
          mobileMenu.setAttribute('aria-hidden', 'true');
        });
      });

      // Sticky nav
      const nav = document.querySelector('.landing-nav');
      window.addEventListener('scroll', () => {
        nav?.classList.toggle('scrolled', window.scrollY > 40);
      }, { passive: true });

      // Scroll reveal
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -30px 0px' });
      document.querySelectorAll('.step-item, .faq-item').forEach(el => observer.observe(el));

      // ─── HERO FLATLAY INTERACTIVE LOGIC ───
      // 1. Render Black T-Shirt with Rose Design on load
      function renderHeroMockup() {
        const canvas = document.getElementById('hero-shirt-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');

        const shirtImg = new Image();
        const logoImg = new Image();

        let loadedCount = 0;
        const onImgLoad = () => {
          loadedCount++;
          if (loadedCount === 2) {
            drawMockup();
          }
        };

        shirtImg.onload = onImgLoad;
        logoImg.onload = onImgLoad;

        shirtImg.src = '/assets/processed/tshirt_flatlay.png';
        logoImg.src = '/assets/designs/minimal_rose.png';

        function drawMockup() {
          const w = canvas.width;
          const h = canvas.height;

          // Create offscreen canvases for masking, shadows, highlights
          const maskCanvas = document.createElement('canvas');
          maskCanvas.width = w;
          maskCanvas.height = h;
          const maskCtx = maskCanvas.getContext('2d');
          maskCtx.drawImage(shirtImg, 0, 0, w, h);

          const shadowCanvas = document.createElement('canvas');
          shadowCanvas.width = w;
          shadowCanvas.height = h;
          const shadowCtx = shadowCanvas.getContext('2d');

          const highlightCanvas = document.createElement('canvas');
          highlightCanvas.width = w;
          highlightCanvas.height = h;
          const highlightCtx = highlightCanvas.getContext('2d');

          const maskData = maskCtx.getImageData(0, 0, w, h);
          const mPixels = maskData.data;

          const shadowData = shadowCtx.createImageData(w, h);
          const sPixels = shadowData.data;

          const highlightData = highlightCtx.createImageData(w, h);
          const hPixels = highlightData.data;

          const Y_FLAT = 230; // Crewneck Y_FLAT baseline

          for (let idx = 0; idx < w * h; idx++) {
            const rIdx = idx * 4;
            const alpha = mPixels[rIdx + 3];

            if (alpha === 0) {
              sPixels[rIdx] = 255; sPixels[rIdx + 1] = 255; sPixels[rIdx + 2] = 255; sPixels[rIdx + 3] = 0;
              hPixels[rIdx] = 0; hPixels[rIdx + 1] = 0; hPixels[rIdx + 2] = 0; hPixels[rIdx + 3] = 0;
              continue;
            }

            const r = mPixels[rIdx];
            const g = mPixels[rIdx + 1];
            const b = mPixels[rIdx + 2];
            const Y = 0.299 * r + 0.587 * g + 0.114 * b;

            // Shadow creases
            let sVal = 255;
            if (Y < Y_FLAT) {
              sVal = Math.max(0, Math.min(255, Math.round(255 * Math.pow(Y / Y_FLAT, 1.8))));
            }
            if (alpha < 255) {
              const factor = alpha / 255;
              sVal = Math.round(sVal * factor + 255 * (1 - factor));
            }
            sPixels[rIdx] = sVal; sPixels[rIdx + 1] = sVal; sPixels[rIdx + 2] = sVal; sPixels[rIdx + 3] = alpha;

            // Highlights sheen
            let hVal = 0;
            if (Y > Y_FLAT) {
              hVal = Math.max(0, Math.min(255, Math.round(255 * ((Y - Y_FLAT) / (255 - Y_FLAT)))));
            }
            hPixels[rIdx] = 255; hPixels[rIdx + 1] = 255; hPixels[rIdx + 2] = 255; hPixels[rIdx + 3] = Math.round(hVal * (alpha / 255));
          }

          shadowCtx.putImageData(shadowData, 0, 0);
          highlightCtx.putImageData(highlightData, 0, 0);

          // Now assemble mockup scene in offscreen canvas
          const offscreen = document.createElement('canvas');
          offscreen.width = w;
          offscreen.height = h;
          const offCtx = offscreen.getContext('2d');

          // A. Draw shirt silhouette
          offCtx.drawImage(maskCanvas, 0, 0);

          // B. Multiply T-shirt base color (Vintage Black)
          offCtx.globalCompositeOperation = 'source-in';
          offCtx.fillStyle = '#212121';
          offCtx.fillRect(0, 0, w, h);

          // C. Draw logo chest print
          offCtx.globalCompositeOperation = 'source-atop';
          offCtx.save();
          offCtx.translate(300, 275);
          
          // Draw minimal rose logo size:
          const logoW = 150;
          const logoH = 150;
          offCtx.drawImage(logoImg, -logoW / 2, -logoH / 2, logoW, logoH);
          offCtx.restore();

          // D. Blend wrinkles shadow (multiply)
          offCtx.globalCompositeOperation = 'source-atop';
          offCtx.save();
          offCtx.globalAlpha = 0.6; // 60% shadow depth
          offCtx.globalCompositeOperation = 'multiply';
          offCtx.drawImage(shadowCanvas, 0, 0);
          offCtx.restore();

          // E. Blend highlights shine (screen)
          offCtx.globalCompositeOperation = 'source-atop';
          offCtx.save();
          offCtx.globalAlpha = 0.15; // 15% fabric shine
          offCtx.globalCompositeOperation = 'screen';
          offCtx.drawImage(highlightCanvas, 0, 0);
          offCtx.restore();

          // Draw active bounding box & transform handles
          offCtx.globalCompositeOperation = 'source-over'; // Draw on top
          offCtx.strokeStyle = '#00b4e6';
          offCtx.lineWidth = 1.5;
          offCtx.setLineDash([4, 3]);
          offCtx.strokeRect(180, 205, 240, 140);
          offCtx.setLineDash([]); // Reset

          // Corner handles
          const handleSize = 6;
          const drawHandle = (hx, hy) => {
            offCtx.fillStyle = '#ffffff';
            offCtx.fillRect(hx - handleSize / 2, hy - handleSize / 2, handleSize, handleSize);
            offCtx.strokeStyle = '#00b4e6';
            offCtx.lineWidth = 1.5;
            offCtx.strokeRect(hx - handleSize / 2, hy - handleSize / 2, handleSize, handleSize);
          };
          drawHandle(180, 205);
          drawHandle(420, 205);
          drawHandle(180, 345);
          drawHandle(420, 345);

          // Rotation handle line
          offCtx.beginPath();
          offCtx.moveTo(300, 205);
          offCtx.lineTo(300, 180);
          offCtx.strokeStyle = '#00b4e6';
          offCtx.lineWidth = 1.5;
          offCtx.stroke();

          // Rotation handle circle
          offCtx.beginPath();
          offCtx.arc(300, 180, 3.5, 0, 2 * Math.PI);
          offCtx.fillStyle = '#ffffff';
          offCtx.fill();
          offCtx.strokeStyle = '#00b4e6';
          offCtx.lineWidth = 1.5;
          offCtx.stroke();

          // F. Draw final result onto main canvas
          ctx.clearRect(0, 0, w, h);
          ctx.drawImage(offscreen, 0, 0);
        }
      }

      // Initialize mockup render
      renderHeroMockup();

      // ─── LIVE MOCKUP COUNTER ANIMATION ───
      function initCounter() {
        const counterEl = document.getElementById('mockup-counter');
        if (!counterEl) return;

        const targetCount = 1034;
        const startCount = 980;
        const duration = 1500; // 1.5 seconds
        const startTime = performance.now();

        function update(currentTime) {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          
          // Easing function (easeOutQuad)
          const easeProgress = progress * (2 - progress);
          const currentVal = Math.floor(startCount + (targetCount - startCount) * easeProgress);
          
          counterEl.innerText = currentVal.toLocaleString() + '+';

          if (progress < 1) {
            requestAnimationFrame(update);
          } else {
            // Start live ticking upwards
            startLiveTicking(targetCount);
          }
        }

        requestAnimationFrame(update);
      }

      function startLiveTicking(initialCount) {
        const counterEl = document.getElementById('mockup-counter');
        if (!counterEl) return;
        
        let count = initialCount;

        function tick() {
          const delay = Math.random() * (7000 - 3000) + 3000; // 3 to 7 seconds
          setTimeout(() => {
            count += 1;
            counterEl.innerText = count.toLocaleString() + '+';
            tick();
          }, delay);
        }

        tick();
      }

      // Initialize counter
      initCounter();

      // Parallax mouse displacement removed to let props float via CSS animations only
    </script>

